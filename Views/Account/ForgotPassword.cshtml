@model CRM_V2.ViewModels.ForgotPasswordViewModel
@{
    Layout = null;
    ViewData["Title"] = "Quên Mật Khẩu - SalonCare CRM";
}
<!DOCTYPE html>
<html lang="vi" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts Plus Jakarta Sans -->
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['"Plus Jakarta Sans"', 'sans-serif'],
                    },
                    colors: {
                        brand: {
                            dark: '#070A12',
                            card: 'rgba(18, 24, 41, 0.7)',
                            border: 'rgba(255, 255, 255, 0.08)',
                            purple: '#7C3AED',
                            pink: '#EC4899',
                            blue: '#3B82F6',
                            cyan: '#06B6D4',
                            emerald: '#10B981'
                        }
                    }
                }
            }
        }
    </script>
    <style>
        body {
            background-color: #070A12;
            color: #F3F4F6;
            background-image: 
                radial-gradient(circle at 15% 15%, rgba(124, 58, 237, 0.2) 0%, transparent 40%),
                radial-gradient(circle at 85% 65%, rgba(6, 182, 212, 0.15) 0%, transparent 40%),
                radial-gradient(circle at 50% 90%, rgba(236, 72, 153, 0.12) 0%, transparent 50%);
            background-attachment: fixed;
        }
        .glass-card {
            background: rgba(18, 24, 41, 0.75);
            backdrop-filter: blur(16px);
            border: 1px solid rgba(255, 255, 255, 0.1);
        }
        .glass-input {
            background: rgba(11, 15, 25, 0.8);
            border: 1px solid rgba(255, 255, 255, 0.12);
            transition: all 0.2s ease;
        }
        .glass-input:focus {
            border-color: #8B5CF6;
            box-shadow: 0 0 15px rgba(139, 92, 246, 0.3);
            outline: none;
        }
    </style>
</head>
<body class="font-sans antialiased min-h-screen flex items-center justify-center p-4">

    <div class="w-full max-w-md">
        <!-- Brand Logo Header -->
        <div class="text-center mb-6">
            <div class="inline-flex items-center justify-center w-14 h-14 rounded-2xl bg-gradient-to-tr from-purple-600 to-pink-500 shadow-xl shadow-purple-600/30 mb-3">
                <i class="fa-solid fa-key text-xl text-white"></i>
            </div>
            <h1 class="text-2xl font-extrabold text-white tracking-tight">Khôi Phục Mật Khẩu</h1>
            <p class="text-xs text-slate-400 mt-0.5">Nhập email để nhận đường link đặt lại mật khẩu an toàn</p>
        </div>

        <div class="glass-card rounded-3xl p-6 sm:p-8 shadow-2xl relative">
            @if (ViewBag.MessageSent == true)
            {
                <div class="text-center space-y-4">
                    <div class="w-16 h-16 rounded-full bg-emerald-500/20 text-emerald-400 flex items-center justify-center mx-auto text-2xl">
                        <i class="fa-solid fa-paper-plane"></i>
                    </div>
                    <h3 class="text-lg font-bold text-white">Yêu Cầu Đã Được Tiếp Nhận</h3>
                    <p class="text-xs text-slate-300 leading-relaxed">
                        @ViewBag.InfoMessage
                    </p>

                    @if (ViewBag.ResetLink != null)
                    {
                        <div class="p-3.5 rounded-xl bg-purple-950/40 border border-purple-500/30 text-left text-xs space-y-2">
                            <span class="text-[11px] font-bold text-purple-300 uppercase tracking-wider block">Liên kết Test nhanh:</span>
                            <a href="@ViewBag.ResetLink" class="text-xs text-cyan-400 hover:underline break-all block">@ViewBag.ResetLink</a>
                        </div>
                    }

                    <div class="pt-4">
                        <a asp-action="Login" class="inline-flex items-center space-x-2 px-5 py-2.5 rounded-xl bg-purple-600 hover:bg-purple-500 text-white font-semibold text-xs transition">
                            <i class="fa-solid fa-arrow-left"></i>
                            <span>Quay lại Đăng nhập</span>
                        </a>
                    </div>
                </div>
            }
            else
            {
                <form asp-action="ForgotPassword" method="post" class="space-y-4 text-xs">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="p-3 rounded-xl bg-rose-500/20 border border-rose-500/30 text-rose-300 text-xs"></div>

                    <div>
                        <label class="block text-slate-300 font-semibold mb-1" asp-for="Email">Địa chỉ Email đã đăng ký</label>
                        <div class="relative">
                            <i class="fa-solid fa-envelope absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-500"></i>
                            <input asp-for="Email" type="email" placeholder="VD: ngocanh@saloncare.vn" 
                                class="w-full glass-input rounded-xl pl-9 pr-3.5 py-2.5 text-white placeholder-slate-500" required />
                        </div>
                        <span asp-validation-for="Email" class="text-[11px] text-rose-400 mt-0.5 block"></span>
                    </div>

                    <button type="submit" 
                        class="w-full py-3 mt-2 rounded-xl bg-gradient-to-r from-purple-600 to-indigo-600 hover:opacity-90 text-white font-bold text-sm shadow-lg shadow-purple-600/30 transition duration-200 flex items-center justify-center space-x-2">
                        <i class="fa-solid fa-paper-plane"></i>
                        <span>Gửi Liên Kết Xác Thực</span>
                    </button>
                </form>

                <div class="mt-5 pt-4 border-t border-white/10 text-center">
                    <a asp-action="Login" class="text-xs text-slate-400 hover:text-white transition inline-flex items-center gap-1.5">
                        <i class="fa-solid fa-arrow-left text-[10px]"></i>
                        <span>Quay lại trang Đăng nhập</span>
                    </a>
                </div>
            }
        </div>
    </div>

</body>
</html>
