@model CRM_V2.ViewModels.LoginViewModel
@{
    Layout = null;
    ViewData["Title"] = "Đăng Nhập - SalonCare CRM";
}
<!DOCTYPE html>
<html lang="vi" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts Plus Jakarta Sans -->
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['"Plus Jakarta Sans"', 'sans-serif'],
                    },
                    colors: {
                        brand: {
                            dark: '#070A12',
                            card: 'rgba(18, 24, 41, 0.7)',
                            border: 'rgba(255, 255, 255, 0.08)',
                            purple: '#7C3AED',
                            pink: '#EC4899',
                            blue: '#3B82F6',
                            cyan: '#06B6D4',
                            emerald: '#10B981'
                        }
                    }
                }
            }
        }
    </script>
    <style>
        body {
            background-color: #070A12;
            color: #F3F4F6;
            background-image: 
                radial-gradient(circle at 15% 15%, rgba(124, 58, 237, 0.2) 0%, transparent 40%),
                radial-gradient(circle at 85% 65%, rgba(6, 182, 212, 0.15) 0%, transparent 40%),
                radial-gradient(circle at 50% 90%, rgba(236, 72, 153, 0.12) 0%, transparent 50%);
            background-attachment: fixed;
        }
        .glass-card {
            background: rgba(18, 24, 41, 0.75);
            backdrop-filter: blur(16px);
            border: 1px solid rgba(255, 255, 255, 0.1);
        }
        .glass-input {
            background: rgba(11, 15, 25, 0.8);
            border: 1px solid rgba(255, 255, 255, 0.12);
            transition: all 0.2s ease;
        }
        .glass-input:focus {
            border-color: #8B5CF6;
            box-shadow: 0 0 15px rgba(139, 92, 246, 0.3);
            outline: none;
        }
        .glow-effect {
            filter: drop-shadow(0 0 25px rgba(168, 85, 247, 0.6));
        }
    </style>
</head>
<body class="font-sans antialiased min-h-screen flex items-center justify-center p-4">

    <div class="w-full max-w-md">
        <!-- Brand Logo Header -->
        <div class="text-center mb-8">
            <div class="inline-flex items-center justify-center w-16 h-16 rounded-2xl bg-gradient-to-tr from-purple-600 via-indigo-600 to-pink-500 shadow-xl shadow-purple-600/30 mb-4 glow-effect">
                <i class="fa-solid fa-spa text-2xl text-white"></i>
            </div>
            <h1 class="text-2xl font-extrabold text-white tracking-tight">SalonCare CRM</h1>
            <p class="text-xs text-slate-400 mt-1">Hệ thống quản lý Spa & Thẩm mỹ viện thông minh</p>
        </div>

        <!-- Notification Alerts -->
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="mb-4 p-3.5 rounded-2xl bg-emerald-500/20 border border-emerald-500/30 text-emerald-300 text-xs flex items-center space-x-2">
                <i class="fa-solid fa-circle-check text-emerald-400 text-sm"></i>
                <span>@TempData["SuccessMessage"]</span>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="mb-4 p-3.5 rounded-2xl bg-rose-500/20 border border-rose-500/30 text-rose-300 text-xs flex items-center space-x-2">
                <i class="fa-solid fa-triangle-exclamation text-rose-400 text-sm"></i>
                <span>@TempData["ErrorMessage"]</span>
            </div>
        }

        <!-- Login Card -->
        <div class="glass-card rounded-3xl p-8 shadow-2xl relative">
            <div class="mb-6">
                <h2 class="text-xl font-bold text-white">Đăng Nhập</h2>
                <p class="text-xs text-slate-400 mt-1">Truy cập vào hệ thống bằng tài khoản được cấp.</p>
            </div>

            <form asp-action="Login" asp-controller="Account" method="post" class="space-y-4 text-xs">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="ReturnUrl" />

                <!-- Validation Summary -->
                <div asp-validation-summary="ModelOnly" class="p-3 rounded-xl bg-rose-500/20 border border-rose-500/30 text-rose-300 text-xs space-y-1"></div>

                <!-- Username or Email -->
                <div>
                    <label class="block text-slate-300 font-semibold mb-1.5" asp-for="UsernameOrEmail">Tài khoản hoặc Email</label>
                    <div class="relative">
                        <i class="fa-solid fa-user absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-500"></i>
                        <input asp-for="UsernameOrEmail" type="text" placeholder="ngocanh hoặc ngocanh@saloncare.vn" 
                            class="w-full glass-input rounded-xl pl-9 pr-3.5 py-2.5 text-white placeholder-slate-500" required />
                    </div>
                    <span asp-validation-for="UsernameOrEmail" class="text-[11px] text-rose-400 mt-1 block"></span>
                </div>

                <!-- Password -->
                <div>
                    <div class="flex items-center justify-between mb-1.5">
                        <label class="block text-slate-300 font-semibold" asp-for="Password">Mật khẩu</label>
                        <a asp-action="ForgotPassword" class="text-[11px] text-purple-400 hover:text-purple-300 font-medium transition">Quên mật khẩu?</a>
                    </div>
                    <div class="relative">
                        <i class="fa-solid fa-lock absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-500"></i>
                        <input asp-for="Password" type="password" id="loginPasswordInput" placeholder="••••••••" 
                            class="w-full glass-input rounded-xl pl-9 pr-10 py-2.5 text-white placeholder-slate-500" required />
                        <button type="button" onclick="togglePasswordVisibility('loginPasswordInput', this)" 
                            class="absolute right-3.5 top-1/2 -translate-y-1/2 text-slate-500 hover:text-slate-300">
                            <i class="fa-regular fa-eye"></i>
                        </button>
                    </div>
                    <span asp-validation-for="Password" class="text-[11px] text-rose-400 mt-1 block"></span>
                </div>

                <!-- Remember Me -->
                <div class="flex items-center justify-between pt-1">
                    <label class="flex items-center space-x-2 text-slate-300 cursor-pointer">
                        <input asp-for="RememberMe" type="checkbox" class="rounded bg-slate-900 border-white/20 text-purple-600 focus:ring-0 focus:ring-offset-0">
                        <span class="text-xs">Ghi nhớ đăng nhập (7 ngày)</span>
                    </label>
                </div>

                <!-- Submit Button -->
                <button type="submit" 
                    class="w-full py-3 mt-2 rounded-xl bg-gradient-to-r from-purple-600 to-indigo-600 hover:from-purple-500 hover:to-indigo-500 text-white font-bold text-sm shadow-lg shadow-purple-600/30 transition duration-200 flex items-center justify-center space-x-2">
                    <i class="fa-solid fa-arrow-right-to-bracket"></i>
                    <span>Đăng Nhập</span>
                </button>
            </form>

            <!-- Quick Account Guide Hint -->
            <div class="mt-6 pt-4 border-t border-white/10 text-center">
                <p class="text-xs text-slate-400">
                    Chưa có tài khoản? 
                    <a asp-action="Register" class="text-purple-400 hover:text-pink-400 font-bold ml-1 transition">Đăng ký ngay</a>
                </p>
                <div class="mt-4 p-3 rounded-xl bg-white/5 text-[11px] text-slate-400 text-left">
                    <p class="font-semibold text-slate-300 mb-1"><i class="fa-solid fa-key text-purple-400 mr-1"></i> Tài khoản mẫu hệ thống:</p>
                    <p>• Admin: <strong class="text-slate-200">admin</strong> / Mật khẩu: <code class="text-purple-300">Admin@123</code></p>
                    <p>• Chủ Spa: <strong class="text-slate-200">ngocanh</strong> / Mật khẩu: <code class="text-purple-300">Owner@123</code></p>
                    <p>• Nhân viên: <strong class="text-slate-200">lanktv</strong> / Mật khẩu: <code class="text-purple-300">Staff@123</code></p>
                </div>
            </div>
        </div>
    </div>

    <script>
        function togglePasswordVisibility(inputId, btn) {
            const input = document.getElementById(inputId);
            const icon = btn.querySelector('i');
            if (input.type === 'password') {
                input.type = 'text';
                icon.classList.replace('fa-eye', 'fa-eye-slash');
            } else {
                input.type = 'password';
                icon.classList.replace('fa-eye-slash', 'fa-eye');
            }
        }
    </script>
</body>
</html>
