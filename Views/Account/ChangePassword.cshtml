@model CRM_V2.ViewModels.ChangePasswordViewModel
@{
    ViewData["Title"] = "Đổi Mật Khẩu - SalonCare CRM";
}

<div class="max-w-xl mx-auto space-y-6">
    <!-- Breadcrumb & Header -->
    <div class="flex items-center justify-between">
        <div>
            <h2 class="text-xl font-bold text-white flex items-center gap-2">
                <i class="fa-solid fa-key text-purple-400"></i>
                <span>Đổi Mật Khẩu Cá Nhân</span>
            </h2>
            <p class="text-xs text-slate-400 mt-1">Cập nhật mật khẩu định kỳ để nâng cao tính an toàn cho tài khoản SalonCare của bạn.</p>
        </div>
        <a asp-controller="Home" asp-action="Index" class="px-4 py-2 rounded-xl bg-white/10 hover:bg-white/20 text-slate-300 text-xs font-semibold transition">
            <i class="fa-solid fa-arrow-left mr-1"></i> Quay lại
        </a>
    </div>

    <!-- Form Card -->
    <div class="glass-card rounded-3xl p-6 sm:p-8 shadow-2xl relative">
        <form asp-action="ChangePassword" method="post" class="space-y-4 text-xs">
            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly" class="p-3.5 rounded-xl bg-rose-500/20 border border-rose-500/30 text-rose-300 text-xs"></div>

            <!-- Current Password -->
            <div>
                <label class="block text-slate-300 font-semibold mb-1" asp-for="CurrentPassword">Mật khẩu hiện tại <span class="text-pink-400">*</span></label>
                <div class="relative">
                    <i class="fa-solid fa-lock absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-500"></i>
                    <input asp-for="CurrentPassword" type="password" placeholder="Nhập mật khẩu hiện tại" 
                        class="w-full glass-input rounded-xl pl-9 pr-3.5 py-2.5 text-white placeholder-slate-500" required />
                </div>
                <span asp-validation-for="CurrentPassword" class="text-[11px] text-rose-400 mt-0.5 block"></span>
            </div>

            <!-- New Password -->
            <div>
                <label class="block text-slate-300 font-semibold mb-1" asp-for="NewPassword">Mật khẩu mới <span class="text-pink-400">*</span></label>
                <div class="relative">
                    <i class="fa-solid fa-shield-halved absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-500"></i>
                    <input asp-for="NewPassword" type="password" placeholder="Tối thiểu 6 ký tự" 
                        class="w-full glass-input rounded-xl pl-9 pr-3.5 py-2.5 text-white placeholder-slate-500" required />
                </div>
                <span asp-validation-for="NewPassword" class="text-[11px] text-rose-400 mt-0.5 block"></span>
            </div>

            <!-- Confirm New Password -->
            <div>
                <label class="block text-slate-300 font-semibold mb-1" asp-for="ConfirmPassword">Xác nhận mật khẩu mới <span class="text-pink-400">*</span></label>
                <div class="relative">
                    <i class="fa-solid fa-circle-check absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-500"></i>
                    <input asp-for="ConfirmPassword" type="password" placeholder="Nhập lại mật khẩu mới" 
                        class="w-full glass-input rounded-xl pl-9 pr-3.5 py-2.5 text-white placeholder-slate-500" required />
                </div>
                <span asp-validation-for="ConfirmPassword" class="text-[11px] text-rose-400 mt-0.5 block"></span>
            </div>

            <div class="pt-2 flex items-center justify-end space-x-3">
                <a asp-controller="Home" asp-action="Index" class="px-5 py-2.5 rounded-xl bg-white/10 hover:bg-white/20 text-slate-300 font-semibold transition">
                    Hủy bỏ
                </a>
                <button type="submit" 
                    class="px-6 py-2.5 rounded-xl bg-gradient-to-r from-purple-600 to-indigo-600 hover:from-purple-500 hover:to-indigo-500 text-white font-bold shadow-lg shadow-purple-600/30 transition flex items-center space-x-2">
                    <i class="fa-solid fa-floppy-disk"></i>
                    <span>Lưu Thay Đổi</span>
                </button>
            </div>
        </form>
    </div>
</div>
