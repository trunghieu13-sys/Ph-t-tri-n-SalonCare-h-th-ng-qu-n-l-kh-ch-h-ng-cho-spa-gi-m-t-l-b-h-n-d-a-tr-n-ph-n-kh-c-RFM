    <!-- TOAST & MODAL ENGINE GLOBAL JS -->
    <script>
        function openModal(id) {
            const modal = document.getElementById(id);
            if (!modal) return;
            modal.classList.remove('hidden');
            setTimeout(() => {
                modal.classList.remove('opacity-0');
                modal.querySelector('.transform')?.classList.replace('scale-95', 'scale-100');
            }, 10);
        }

        function closeModal(id) {
            const modal = document.getElementById(id);
            if (!modal) return;
            modal.classList.add('opacity-0');
            modal.querySelector('.transform')?.classList.replace('scale-100', 'scale-95');
            setTimeout(() => modal.classList.add('hidden'), 300);
        }

        function showToast(msg, title = 'Thành công') {
            const toast = document.getElementById('toastNotification');
            if (!toast) return;
            document.getElementById('toastTitle').innerText = title;
            document.getElementById('toastMessage').innerText = msg;
            toast.classList.remove('hidden', 'translate-x-full');
            setTimeout(() => {
                toast.classList.add('translate-x-full');
                setTimeout(() => toast.classList.add('hidden'), 300);
            }, 3000);
        }

        // ==========================================
        // USER HEADER DROPDOWN HANDLER
        // ==========================================
        function toggleUserDropdown() {
            const menu = document.getElementById('userDropdownMenu');
            if (!menu) return;
            menu.classList.toggle('hidden');
            hideNotificationDropdown();
            hideGlobalSearchDropdown();
        }

        function hideUserDropdown() {
            const menu = document.getElementById('userDropdownMenu');
            if (menu) menu.classList.add('hidden');
        }

        // ==========================================
        // 1. GLOBAL SEARCH (COMMAND PALETTE & AUTOCOMPLETE)
        // ==========================================
        let searchDebounceTimer = null;

        function hideGlobalSearchDropdown() {
            const dropdown = document.getElementById('globalSearchDropdown');
            if (dropdown) dropdown.classList.add('hidden');
        }

        async function executeGlobalSearch(query) {
            const dropdown = document.getElementById('globalSearchDropdown');
            const resultsBox = document.getElementById('globalSearchResults');
            if (!dropdown || !resultsBox) return;

            dropdown.classList.remove('hidden');
            resultsBox.innerHTML = `
                <div class="p-6 text-center text-slate-400 text-xs">
                    <i class="fa-solid fa-circle-notch fa-spin text-purple-400 mr-2 text-sm"></i>
                    <span>Đang tìm kiếm thông tin...</span>
                </div>
            `;

            try {
                const res = await fetch(`/Header/GlobalSearch?query=${encodeURIComponent(query)}`);
                const data = await res.json();

                if (!data.success || data.total === 0) {
                    resultsBox.innerHTML = `
                        <div class="p-6 text-center text-slate-400 text-xs">
                            <i class="fa-solid fa-magnifying-glass text-slate-500 text-lg mb-2 block"></i>
                            <span>Không tìm thấy kết quả nào phù hợp với "<strong>${escapeHtml(query)}</strong>"</span>
                        </div>
                    `;
                    return;
                }

                let html = '';

                // 1. Nhóm Khách Hàng
                if (data.customers && data.customers.length > 0) {
                    html += `
                        <div class="mb-2.5">
                            <div class="px-2 py-1 text-[11px] font-bold text-slate-400 uppercase tracking-wider flex items-center gap-1.5">
                                <i class="fa-solid fa-users text-pink-400"></i>
                                <span>Khách Hàng (${data.customers.length})</span>
                            </div>
                            <div class="space-y-1">
                                ${data.customers.map(c => `
                                    <div onclick="handleSearchResultClick('customer', ${c.id})" 
                                        class="p-2 rounded-xl hover:bg-white/10 cursor-pointer flex items-center justify-between transition-all group">
                                        <div class="flex items-center gap-2.5 truncate">
                                            <div class="w-8 h-8 rounded-full bg-pink-500/20 text-pink-300 font-bold flex items-center justify-center shrink-0 text-xs ring-1 ring-pink-500/30">
                                                ${c.title ? c.title.charAt(0) : 'K'}
                                            </div>
                                            <div class="truncate">
                                                <div class="text-xs font-bold text-white group-hover:text-pink-300 transition truncate">${c.title}</div>
                                                <div class="text-[11px] text-slate-400 truncate">${c.subtitle}</div>
                                            </div>
                                        </div>
                                        <span class="text-[10px] px-2 py-0.5 rounded-full bg-pink-500/20 text-pink-300 border border-pink-500/30 font-medium shrink-0 ml-2">
                                            ${c.badge}
                                        </span>
                                    </div>
                                `).join('')}
                            </div>
                        </div>
                    `;
                }

                // 2. Nhóm Lịch Hẹn
                if (data.appointments && data.appointments.length > 0) {
                    html += `
                        <div class="mb-2.5">
                            <div class="px-2 py-1 text-[11px] font-bold text-slate-400 uppercase tracking-wider flex items-center gap-1.5">
                                <i class="fa-solid fa-calendar-check text-cyan-400"></i>
                                <span>Lịch Hẹn Salon (${data.appointments.length})</span>
                            </div>
                            <div class="space-y-1">
                                ${data.appointments.map(a => `
                                    <div onclick="handleSearchResultClick('appointment', ${a.id})" 
                                        class="p-2 rounded-xl hover:bg-white/10 cursor-pointer flex items-center justify-between transition-all group">
                                        <div class="flex items-center gap-2.5 truncate">
                                            <div class="w-8 h-8 rounded-xl bg-cyan-500/20 text-cyan-300 flex items-center justify-center shrink-0 text-xs ring-1 ring-cyan-500/30">
                                                <i class="fa-regular fa-calendar-days"></i>
                                            </div>
                                            <div class="truncate">
                                                <div class="text-xs font-bold text-white group-hover:text-cyan-300 transition truncate">${a.title}</div>
                                                <div class="text-[11px] text-slate-400 truncate">${a.subtitle}</div>
                                            </div>
                                        </div>
                                        <span class="text-[10px] px-2 py-0.5 rounded-full bg-cyan-500/20 text-cyan-300 border border-cyan-500/30 font-medium shrink-0 ml-2">
                                            ${a.badge}
                                        </span>
                                    </div>
                                `).join('')}
                            </div>
                        </div>
                    `;
                }

                // 3. Nhóm Dịch Vụ
                if (data.services && data.services.length > 0) {
                    html += `
                        <div class="mb-2.5">
                            <div class="px-2 py-1 text-[11px] font-bold text-slate-400 uppercase tracking-wider flex items-center gap-1.5">
                                <i class="fa-solid fa-spa text-purple-400"></i>
                                <span>Dịch Vụ Spa (${data.services.length})</span>
                            </div>
                            <div class="space-y-1">
                                ${data.services.map(s => `
                                    <div onclick="handleSearchResultClick('service', ${s.id})" 
                                        class="p-2 rounded-xl hover:bg-white/10 cursor-pointer flex items-center justify-between transition-all group">
                                        <div class="flex items-center gap-2.5 truncate">
                                            <div class="w-8 h-8 rounded-xl bg-purple-500/20 text-purple-300 flex items-center justify-center shrink-0 text-xs ring-1 ring-purple-500/30">
                                                <i class="fa-solid ${s.icon || 'fa-spa'}"></i>
                                            </div>
                                            <div class="truncate">
                                                <div class="text-xs font-bold text-white group-hover:text-purple-300 transition truncate">${s.title}</div>
                                                <div class="text-[11px] text-slate-400 truncate">${s.subtitle}</div>
                                            </div>
                                        </div>
                                        <span class="text-[10px] px-2 py-0.5 rounded-full bg-purple-500/20 text-purple-300 border border-purple-500/30 font-medium shrink-0 ml-2">
                                            ${s.badge}
                                        </span>
                                    </div>
                                `).join('')}
                            </div>
                        </div>
                    `;
                }

                // 4. Nhóm Nhân Viên
                if (data.staff && data.staff.length > 0) {
                    html += `
                        <div class="mb-1">
                            <div class="px-2 py-1 text-[11px] font-bold text-slate-400 uppercase tracking-wider flex items-center gap-1.5">
                                <i class="fa-solid fa-user-tie text-blue-400"></i>
                                <span>Đội Ngũ Nhân Sự (${data.staff.length})</span>
                            </div>
                            <div class="space-y-1">
                                ${data.staff.map(st => `
                                    <div onclick="handleSearchResultClick('staff', ${st.id})" 
                                        class="p-2 rounded-xl hover:bg-white/10 cursor-pointer flex items-center justify-between transition-all group">
                                        <div class="flex items-center gap-2.5 truncate">
                                            <div class="w-8 h-8 rounded-full bg-blue-500/20 text-blue-300 font-bold flex items-center justify-center shrink-0 text-xs ring-1 ring-blue-500/30">
                                                ${st.title ? st.title.charAt(0) : 'N'}
                                            </div>
                                            <div class="truncate">
                                                <div class="text-xs font-bold text-white group-hover:text-blue-300 transition truncate">${st.title}</div>
                                                <div class="text-[11px] text-slate-400 truncate">${st.subtitle}</div>
                                            </div>
                                        </div>
                                        <span class="text-[10px] px-2 py-0.5 rounded-full bg-blue-500/20 text-blue-300 border border-blue-500/30 font-medium shrink-0 ml-2">
                                            ${st.badge}
                                        </span>
                                    </div>
                                `).join('')}
                            </div>
                        </div>
                    `;
                }

                resultsBox.innerHTML = html;
            } catch (err) {
                console.error("Lỗi tìm kiếm toàn cục:", err);
                resultsBox.innerHTML = `
                    <div class="p-4 text-center text-rose-400 text-xs">
                        <span>Lỗi máy chủ khi tìm kiếm.</span>
                    </div>
                `;
            }
        }

        function handleSearchResultClick(type, id) {
            hideGlobalSearchDropdown();
            const input = document.getElementById('globalSearchInput');
            if (input) input.value = '';

            if (type === 'customer') {
                if (typeof switchView === 'function') switchView('customersView');
                if (typeof viewCustomerDetail === 'function') {
                    setTimeout(() => viewCustomerDetail(id), 100);
                }
            } else if (type === 'appointment') {
                if (typeof switchView === 'function') switchView('appointmentsView');
                if (typeof viewAppointmentDetail === 'function') {
                    setTimeout(() => viewAppointmentDetail(id), 100);
                }
            } else if (type === 'service') {
                if (typeof switchView === 'function') switchView('servicesView');
            } else if (type === 'staff') {
                if (typeof switchView === 'function') switchView('staffView');
            }
        }

        function escapeHtml(text) {
            if (!text) return '';
            const div = document.createElement('div');
            div.innerText = text;
            return div.innerHTML;
        }

        // ==========================================
        // 2. NOTIFICATION CENTER (BELL & DROPDOWN)
        // ==========================================
        function toggleNotificationDropdown() {
            const dropdown = document.getElementById('notificationDropdown');
            if (!dropdown) return;
            const isOpening = dropdown.classList.contains('hidden');
            dropdown.classList.toggle('hidden');

            if (isOpening) {
                hideUserDropdown();
                hideGlobalSearchDropdown();
                loadHeaderNotifications();
            }
        }

        function hideNotificationDropdown() {
            const dropdown = document.getElementById('notificationDropdown');
            if (dropdown) dropdown.classList.add('hidden');
        }

        async function loadHeaderNotifications() {
            const badge = document.getElementById('notificationBadge');
            const unreadChip = document.getElementById('notificationUnreadChip');
            const listEl = document.getElementById('notificationList');

            try {
                const res = await fetch('/Header/GetNotifications');
                const result = await res.json();

                if (!result.success) return;

                const unreadCount = result.unreadCount || 0;

                // Update Bell Badge
                if (badge) {
                    if (unreadCount > 0) {
                        badge.innerText = unreadCount > 99 ? '99+' : unreadCount;
                        badge.classList.remove('hidden');
                    } else {
                        badge.classList.add('hidden');
                    }
                }

                if (unreadChip) {
                    unreadChip.innerText = `${unreadCount} mới`;
                }

                // Render Notification Items
                if (listEl) {
                    const items = result.data || [];
                    if (items.length === 0) {
                        listEl.innerHTML = `
                            <div class="p-8 text-center text-slate-400">
                                <i class="fa-regular fa-bell-slash text-2xl text-slate-500 mb-2 block"></i>
                                <span>Không có thông báo mới nào.</span>
                            </div>
                        `;
                        return;
                    }

                    listEl.innerHTML = items.map(n => {
                        const isUnread = !n.isRead;
                        const unreadDot = isUnread 
                            ? `<span class="w-2 h-2 rounded-full bg-rose-500 shrink-0 animate-ping"></span>` 
                            : '';

                        return `
                            <div onclick="handleNotificationItemClick(${n.notificationId}, '${n.referenceType || ''}', ${n.referenceId || 0})"
                                class="p-3.5 hover:bg-white/10 cursor-pointer transition-all flex items-start gap-3 group ${isUnread ? 'bg-white/[0.03]' : 'opacity-70'}">
                                <!-- Type Icon -->
                                <div class="w-8 h-8 rounded-xl ${n.bgColorClass || 'bg-purple-500/20'} ${n.iconColorClass || 'text-purple-400'} flex items-center justify-center shrink-0 text-xs ring-1 ring-white/10 mt-0.5">
                                    <i class="fa-solid ${n.iconClass || 'fa-bell'}"></i>
                                </div>

                                <!-- Text Content -->
                                <div class="flex-1 min-w-0">
                                    <div class="flex items-center justify-between gap-1 mb-0.5">
                                        <div class="font-bold text-white text-xs truncate group-hover:text-purple-300 transition">${escapeHtml(n.title)}</div>
                                        <div class="flex items-center gap-1.5 shrink-0">
                                            ${unreadDot}
                                            <span class="text-[10px] text-slate-400 font-mono">${n.timeAgo}</span>
                                        </div>
                                    </div>
                                    <p class="text-[11px] text-slate-300 line-clamp-2 leading-relaxed">${escapeHtml(n.message)}</p>
                                </div>
                            </div>
                        `;
                    }).join('');
                }
            } catch (err) {
                console.error("Lỗi khi tải thông báo Header:", err);
            }
        }

        async function handleNotificationItemClick(notifId, refType, refId) {
            try {
                // Đánh dấu đã đọc
                await fetch(`/Header/MarkAsRead/${notifId}`, { method: 'POST' });
            } catch (e) {
                console.warn(e);
            }

            hideNotificationDropdown();

            // Điều hướng thẳng đến phân hệ và mở modal chi tiết tương ứng
            if (refType === 'APPOINTMENT' && refId > 0) {
                if (typeof switchView === 'function') switchView('appointmentsView');
                if (typeof viewAppointmentDetail === 'function') {
                    setTimeout(() => viewAppointmentDetail(refId), 150);
                }
            } else if (refType === 'CUSTOMER' && refId > 0) {
                if (typeof switchView === 'function') switchView('customersView');
                if (typeof viewCustomerDetail === 'function') {
                    setTimeout(() => viewCustomerDetail(refId), 150);
                }
            } else if (refType === 'SERVICE') {
                if (typeof switchView === 'function') switchView('servicesView');
            }

            // Tải lại thông báo để cập nhật badge
            loadHeaderNotifications();
        }

        async function markAllNotificationsAsRead() {
            try {
                const res = await fetch('/Header/MarkAllAsRead', { method: 'POST' });
                const result = await res.json();
                if (result.success) {
                    showToast('Đã đánh dấu tất cả thông báo là đã đọc!', 'Thông báo');
                    loadHeaderNotifications();
                }
            } catch (err) {
                console.error("Lỗi khi đánh dấu tất cả đã đọc:", err);
            }
        }

        // ==========================================
        // GLOBAL EVENT LISTENERS (CLICK OUTSIDE & KEYBOARD SHORTCUTS)
        // ==========================================
        document.addEventListener('DOMContentLoaded', function () {
            // Khởi tạo thông báo Header
            loadHeaderNotifications();

            // Polling thông báo ngầm mỗi 60 giây
            setInterval(loadHeaderNotifications, 60000);

            // Phím tắt Ctrl+K / Cmd+K cho Tìm kiếm toàn cục
            document.addEventListener('keydown', function (e) {
                if ((e.ctrlKey || e.metaKey) && (e.key === 'k' || e.key === 'K')) {
                    e.preventDefault();
                    const input = document.getElementById('globalSearchInput');
                    if (input) {
                        input.focus();
                        input.select();
                    }
                } else if (e.key === 'Escape') {
                    hideGlobalSearchDropdown();
                    hideNotificationDropdown();
                    hideUserDropdown();
                }
            });

            // Lắng nghe gõ phím tìm kiếm
            const searchInput = document.getElementById('globalSearchInput');
            if (searchInput) {
                searchInput.addEventListener('input', function () {
                    clearTimeout(searchDebounceTimer);
                    const q = this.value.trim();
                    if (!q) {
                        hideGlobalSearchDropdown();
                        return;
                    }
                    searchDebounceTimer = setTimeout(() => executeGlobalSearch(q), 250);
                });

                searchInput.addEventListener('focus', function () {
                    const q = this.value.trim();
                    if (q) executeGlobalSearch(q);
                });
            }

            // Xử lý click ra ngoài để đóng Dropdowns
            document.addEventListener('click', function (e) {
                // Đóng User Dropdown
                const userContainer = document.getElementById('userMenuContainer');
                const userMenu = document.getElementById('userDropdownMenu');
                if (userContainer && userMenu && !userContainer.contains(e.target)) {
                    userMenu.classList.add('hidden');
                }

                // Đóng Notification Dropdown
                const notifContainer = document.getElementById('notificationBellContainer');
                const notifDropdown = document.getElementById('notificationDropdown');
                if (notifContainer && notifDropdown && !notifContainer.contains(e.target)) {
                    notifDropdown.classList.add('hidden');
                }

                // Đóng Global Search Dropdown
                const searchContainer = document.getElementById('globalSearchContainer');
                const searchDropdown = document.getElementById('globalSearchDropdown');
                if (searchContainer && searchDropdown && !searchContainer.contains(e.target)) {
                    searchDropdown.classList.add('hidden');
                }
            });
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
