@using System.Security.Claims
@{
    var isAuth = User.Identity?.IsAuthenticated == true;
    var userFullName = User.FindFirst("FullName")?.Value ?? (isAuth ? User.Identity?.Name : "Quý khách");
    var userRole = User.FindFirst(ClaimTypes.Role)?.Value ?? "";
    var roleBadge = userRole.ToLower() switch
    {
        "admin" => "Quản trị viên",
        "owner" => "Chủ Spa",
        "staff" => "Nhân viên Spa",
        _ => "Nhân viên"
    };
    var userAvatar = User.FindFirst("AvatarUrl")?.Value ?? "https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=150";
    var userEmail = User.FindFirst(ClaimTypes.Email)?.Value ?? "";
    var userPhone = User.FindFirst("Phone")?.Value ?? "";
}
<!DOCTYPE html>
<html lang="vi" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] - SalonCare CRM</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Chart.js CDN -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <!-- Google Fonts Inter / Plus Jakarta Sans -->
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['"Plus Jakarta Sans"', 'sans-serif'],
                    },
                    colors: {
                        brand: {
                            dark: '#070A12',
                            card: 'rgba(18, 24, 41, 0.65)',
                            border: 'rgba(255, 255, 255, 0.08)',
                            purple: '#7C3AED',
                            pink: '#EC4899',
                            blue: '#3B82F6',
                            cyan: '#06B6D4',
                            emerald: '#10B981',
                            amber: '#F59E0B'
                        }
                    }
                }
            }
        }
    </script>

    <style>
        body {
            background-color: #070A12;
            color: #F3F4F6;
            background-image: 
                radial-gradient(circle at 15% 15%, rgba(124, 58, 237, 0.15) 0%, transparent 40%),
                radial-gradient(circle at 85% 65%, rgba(6, 182, 212, 0.12) 0%, transparent 40%),
                radial-gradient(circle at 50% 90%, rgba(236, 72, 153, 0.1) 0%, transparent 50%);
            background-attachment: fixed;
        }

        /* Glassmorphism Styles */
        .glass-card {
            background: rgba(18, 24, 41, 0.65);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border: 1px solid rgba(255, 255, 255, 0.08);
            box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.37);
        }

        .glass-card-hover {
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }

        .glass-card-hover:hover {
            border-color: rgba(168, 85, 247, 0.3);
            transform: translateY(-2px);
            box-shadow: 0 12px 30px -10px rgba(124, 58, 237, 0.3);
        }

        .glass-input {
            background: rgba(11, 15, 25, 0.6);
            border: 1px solid rgba(255, 255, 255, 0.1);
            backdrop-filter: blur(8px);
        }

        .glass-input:focus {
            border-color: #8B5CF6;
            box-shadow: 0 0 15px rgba(139, 92, 246, 0.3);
            outline: none;
        }

        /* Custom Scrollbar */
        ::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }
        ::-webkit-scrollbar-track {
            background: rgba(11, 15, 25, 0.5);
        }
        ::-webkit-scrollbar-thumb {
            background: rgba(255, 255, 255, 0.15);
            border-radius: 9999px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: rgba(139, 92, 246, 0.5);
        }

        /* Lotus Glowing Animation Effect */
        .glow-effect {
            filter: drop-shadow(0 0 25px rgba(168, 85, 247, 0.6));
            animation: pulseGlow 4s infinite alternate;
        }

        @@keyframes pulseGlow {
            0% { filter: drop-shadow(0 0 15px rgba(124, 58, 237, 0.4)); }
            100% { filter: drop-shadow(0 0 35px rgba(236, 72, 153, 0.8)); }
        }

        /* Sidebar Transition Effect */
        #sidebar {
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }

        .sidebar-collapsed {
            width: 5rem !important; /* 80px */
        }

        .sidebar-collapsed .sidebar-text,
        .sidebar-collapsed .sidebar-promo,
        .sidebar-collapsed .sidebar-lotus {
            display: none !important;
        }

        .sidebar-collapsed .sidebar-logo-container {
            justify-content: center !important;
            padding-left: 0 !important;
            padding-right: 0 !important;
        }

        .sidebar-collapsed nav button {
            justify-content: center !important;
            padding-left: 0 !important;
            padding-right: 0 !important;
        }

        /* View Section Transition */
        .view-section {
            display: none;
            opacity: 0;
            transition: opacity 0.3s ease-in-out;
        }

        .view-section.active-view {
            display: block;
            opacity: 1;
        }
    </style>
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="font-sans antialiased min-h-screen text-slate-200 selection:bg-purple-500 selection:text-white">

    <!-- Toast Notification Banner -->
    <div id="toastNotification" class="fixed top-5 right-5 z-50 transform translate-x-full transition-transform duration-300 ease-out glass-card rounded-2xl p-4 border border-emerald-500/30 flex items-center space-x-3 shadow-2xl bg-slate-900/90 hidden">
        <div class="w-8 h-8 rounded-xl bg-emerald-500/20 text-emerald-400 flex items-center justify-center shrink-0">
            <i class="fa-solid fa-check"></i>
        </div>
        <div>
            <h4 id="toastTitle" class="text-xs font-bold text-white">Thành công</h4>
            <p id="toastMessage" class="text-[11px] text-slate-300">Thao tác đã hoàn tất.</p>
        </div>
    </div>

    <!-- Overlay Backdrop Mobile -->
    <div id="mobileBackdrop" class="fixed inset-0 bg-black/60 backdrop-blur-sm z-30 hidden transition-opacity duration-300"></div>

    <div class="flex h-screen overflow-hidden">

        <!-- 1. SIDEBAR NAVIGATION -->
        <aside id="sidebar" class="w-64 glass-card border-r border-white/10 flex flex-col justify-between shrink-0 z-40 fixed lg:relative h-full -translate-x-full lg:translate-x-0">
            <div class="flex flex-col h-full overflow-y-auto custom-scrollbar">
                <!-- Brand Logo -->
                <div class="p-6 flex items-center space-x-3 border-b border-white/10 sidebar-logo-container transition-all">
                    <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-purple-600 via-indigo-500 to-pink-500 flex items-center justify-center shadow-lg shadow-purple-500/30 shrink-0">
                        <i class="fa-solid fa-spa text-white text-xl"></i>
                    </div>
                    <div class="sidebar-text">
                        <h1 class="font-bold text-lg leading-tight tracking-wide bg-gradient-to-r from-white via-slate-100 to-slate-400 bg-clip-text text-transparent">SalonCare</h1>
                        <p class="text-[11px] text-purple-300/70 tracking-wider">Better Care, Happier You</p>
                    </div>
                </div>

                <!-- Navigation Items -->
                <nav class="p-4 space-y-1.5 flex-1" id="navContainer">
                    <button data-view="dashboardView" title="Tổng quan" class="nav-item w-full flex items-center space-x-3 px-4 py-3 rounded-xl bg-gradient-to-r from-purple-600/30 to-indigo-600/20 text-purple-300 font-medium border border-purple-500/30 shadow-lg shadow-purple-900/20 transition-all">
                        <i class="fa-solid fa-house text-purple-400 w-5 text-center shrink-0"></i>
                        <span class="sidebar-text">Tổng quan</span>
                    </button>
                    <button data-view="customersView" title="Khách hàng" class="nav-item w-full flex items-center space-x-3 px-4 py-3 rounded-xl text-slate-400 hover:text-white hover:bg-white/5 transition-all">
                        <i class="fa-solid fa-users w-5 text-center shrink-0"></i>
                        <span class="sidebar-text">Khách hàng</span>
                    </button>
                    <button data-view="appointmentsView" title="Lịch hẹn" class="nav-item w-full flex items-center space-x-3 px-4 py-3 rounded-xl text-slate-400 hover:text-white hover:bg-white/5 transition-all">
                        <i class="fa-regular fa-calendar-check w-5 text-center shrink-0"></i>
                        <span class="sidebar-text">Lịch hẹn</span>
                    </button>
                    <button data-view="servicesView" title="Dịch vụ" class="nav-item w-full flex items-center space-x-3 px-4 py-3 rounded-xl text-slate-400 hover:text-white hover:bg-white/5 transition-all">
                        <i class="fa-solid fa-ticket w-5 text-center shrink-0"></i>
                        <span class="sidebar-text">Dịch vụ</span>
                    </button>
                    <button data-view="customerCareView" title="Chăm sóc khách hàng" class="nav-item w-full flex items-center space-x-3 px-4 py-3 rounded-xl text-slate-400 hover:text-white hover:bg-white/5 transition-all">
                        <i class="fa-solid fa-headset w-5 text-center shrink-0"></i>
                        <span class="sidebar-text">Chăm sóc KH</span>
                    </button>
                    <button data-view="reportsView" title="Báo cáo" class="nav-item w-full flex items-center space-x-3 px-4 py-3 rounded-xl text-slate-400 hover:text-white hover:bg-white/5 transition-all">
                        <i class="fa-solid fa-chart-line w-5 text-center shrink-0"></i>
                        <span class="sidebar-text">Báo cáo</span>
                    </button>
                    <button data-view="staffView" title="Nhân viên" class="nav-item w-full flex items-center space-x-3 px-4 py-3 rounded-xl text-slate-400 hover:text-white hover:bg-white/5 transition-all">
                        <i class="fa-solid fa-user-group w-5 text-center shrink-0"></i>
                        <span class="sidebar-text">Nhân viên</span>
                    </button>
                    <button data-view="settingsView" title="Cài đặt" class="nav-item w-full flex items-center space-x-3 px-4 py-3 rounded-xl text-slate-400 hover:text-white hover:bg-white/5 transition-all">
                        <i class="fa-solid fa-gear w-5 text-center shrink-0"></i>
                        <span class="sidebar-text">Cài đặt</span>
                    </button>
                </nav>

                <!-- Bottom Lotus Visual Accent -->
                <div class="p-4 sidebar-lotus">
                    <div class="rounded-2xl p-4 bg-gradient-to-b from-indigo-950/40 via-purple-900/30 to-slate-900/80 border border-purple-500/20 relative overflow-hidden group text-center flex flex-col items-center">
                        <div class="w-20 h-20 relative flex items-center justify-center my-1">
                            <svg class="w-full h-full glow-effect text-purple-400" viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <path d="M50 15C55 30 70 35 70 50C70 65 55 85 50 85C45 85 30 65 30 50C30 35 45 15 50 15Z" fill="url(#sidebarLotus1)" fill-opacity="0.85"/>
                                <path d="M50 25C62 38 78 45 75 58C72 71 58 78 50 78C42 78 28 71 25 58C22 45 38 38 50 25Z" fill="url(#sidebarLotus2)" fill-opacity="0.75"/>
                                <path d="M50 35C58 45 85 55 80 65C75 75 58 72 50 72C42 72 25 75 20 65C15 55 42 45 50 35Z" fill="url(#sidebarLotus3)" fill-opacity="0.65"/>
                                <defs>
                                    <linearGradient id="sidebarLotus1" x1="50" y1="15" x2="50" y2="85" gradientUnits="userSpaceOnUse">
                                        <stop stop-color="#C084FC"/>
                                        <stop offset="1" stop-color="#EC4899"/>
                                    </linearGradient>
                                    <linearGradient id="sidebarLotus2" x1="25" y1="25" x2="75" y2="78" gradientUnits="userSpaceOnUse">
                                        <stop stop-color="#60A5FA"/>
                                        <stop offset="1" stop-color="#A855F7"/>
                                    </linearGradient>
                                    <linearGradient id="sidebarLotus3" x1="20" y1="35" x2="80" y2="72" gradientUnits="userSpaceOnUse">
                                        <stop stop-color="#22D3EE"/>
                                        <stop offset="1" stop-color="#3B82F6"/>
                                    </linearGradient>
                                </defs>
                            </svg>
                        </div>
                        <p class="text-[11px] font-semibold text-purple-300">Nâng tầm phong cách</p>
                    </div>
                </div>
            </div>
        </aside>

        <!-- MAIN CONTAINER -->
        <div class="flex-1 flex flex-col min-w-0 overflow-hidden">

            <!-- 2. HEADER -->
            <header class="glass-card border-b border-white/10 px-6 py-4 flex items-center justify-between shrink-0 z-10">
                <div class="flex items-center space-x-4">
                    <!-- Toggle Sidebar Hamburger Button -->
                    <button id="toggleSidebarBtn" class="w-10 h-10 rounded-xl glass-card flex items-center justify-center text-slate-300 hover:text-white hover:border-purple-500/50 transition">
                        <i class="fa-solid fa-bars text-lg"></i>
                    </button>
                    <div>
                        <h2 id="currentViewTitle" class="text-lg font-bold text-white flex items-center gap-2">
                            Tổng quan <span class="text-purple-400">✨</span>
                        </h2>
                        <p class="text-xs text-slate-400 hidden sm:block">Chào mừng trở lại, @userFullName!</p>
                    </div>
                </div>

                <!-- Global Search -->
                <div class="relative w-72 md:w-96 hidden md:block" id="globalSearchContainer">
                    <i class="fa-solid fa-magnifying-glass absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400 text-sm"></i>
                    <input type="text" id="globalSearchInput" placeholder="Tìm khách hàng, lịch hẹn, dịch vụ, nhân viên... (⌘K)" 
                        autocomplete="off"
                        class="w-full pl-10 pr-14 py-2 text-xs rounded-xl glass-input text-slate-200 placeholder-slate-500 focus:outline-none focus:border-purple-500/50 transition">
                    <span class="absolute right-3 top-1/2 -translate-y-1/2 text-[10px] bg-white/10 text-slate-400 px-1.5 py-0.5 rounded border border-white/10 pointer-events-none">Ctrl+K</span>

                    <!-- Dropdown Search Results Popup -->
                    <div id="globalSearchDropdown" class="hidden absolute left-0 top-full mt-2 w-full min-w-[380px] sm:min-w-[460px] rounded-2xl glass-card border border-white/15 p-2.5 shadow-2xl z-50 max-h-[480px] overflow-y-auto transform origin-top transition-all">
                        <div id="globalSearchResults">
                            <!-- Dynamic Grouped Search Results -->
                        </div>
                        <div class="pt-2 mt-2 border-t border-white/10 flex items-center justify-between text-[11px] text-slate-400 px-1">
                            <span><kbd class="px-1 py-0.5 bg-white/10 rounded text-[10px]">Esc</kbd> để đóng</span>
                            <span><kbd class="px-1 py-0.5 bg-white/10 rounded text-[10px]">Ctrl+K</kbd> để tìm kiếm</span>
                        </div>
                    </div>
                </div>

                <!-- Header Actions -->
                <div class="flex items-center space-x-3">
                    <button id="quickBookingBtn" class="bg-gradient-to-r from-purple-600 to-indigo-600 hover:from-purple-500 hover:to-indigo-500 text-white px-3.5 py-2 rounded-xl text-xs font-semibold flex items-center space-x-2 shadow-lg shadow-purple-600/30 transition">
                        <i class="fa-solid fa-plus text-xs"></i>
                        <span class="hidden sm:inline">Đặt lịch mới</span>
                    </button>

                    <!-- Trung Tâm Thông Báo (Notification Center) -->
                    <div class="relative" id="notificationBellContainer">
                        <button type="button" id="notificationBellBtn" onclick="toggleNotificationDropdown()" 
                            class="w-9 h-9 rounded-xl glass-card flex items-center justify-center text-slate-300 hover:text-white hover:bg-white/10 relative transition focus:outline-none" title="Trung tâm Thông báo">
                            <i class="fa-regular fa-bell text-base"></i>
                            <span id="notificationBadge" class="hidden absolute -top-1 -right-1 min-w-[18px] h-[18px] px-1 rounded-full bg-rose-500 text-white font-bold text-[10px] flex items-center justify-center ring-2 ring-slate-900 animate-pulse">0</span>
                        </button>

                        <!-- Notification Dropdown Drawer -->
                        <div id="notificationDropdown" class="hidden absolute right-0 mt-2.5 w-80 sm:w-96 rounded-2xl glass-card border border-white/15 shadow-2xl z-50 transform origin-top-right transition-all overflow-hidden">
                            <!-- Header -->
                            <div class="px-4 py-3 border-b border-white/10 flex items-center justify-between bg-white/[0.02]">
                                <div class="flex items-center gap-2">
                                    <h4 class="text-xs font-bold text-white flex items-center gap-1.5">
                                        <i class="fa-solid fa-bell text-purple-400"></i>
                                        <span>Thông báo hệ thống</span>
                                    </h4>
                                    <span id="notificationUnreadChip" class="text-[10px] px-1.5 py-0.5 rounded-full bg-purple-500/20 text-purple-300 font-mono">0 mới</span>
                                </div>
                                <button type="button" onclick="markAllNotificationsAsRead()" class="text-[11px] text-purple-400 hover:text-purple-300 font-medium flex items-center gap-1 transition">
                                    <i class="fa-solid fa-check-double text-[10px]"></i>
                                    <span>Đọc tất cả</span>
                                </button>
                            </div>

                            <!-- List of Notifications -->
                            <div id="notificationList" class="max-h-[380px] overflow-y-auto divide-y divide-white/5 text-xs">
                                <div class="p-6 text-center text-slate-400">
                                    <i class="fa-solid fa-circle-notch fa-spin text-purple-400 text-sm mb-1.5 block"></i>
                                    <span>Đang tải thông báo...</span>
                                </div>
                            </div>

                            <!-- Footer -->
                            <div class="px-4 py-2 border-t border-white/10 bg-white/[0.02] flex items-center justify-between text-[11px] text-slate-400">
                                <span class="flex items-center gap-1">
                                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
                                    <span>Tự động cập nhật</span>
                                </span>
                                <button type="button" onclick="loadHeaderNotifications()" class="hover:text-white transition flex items-center gap-1">
                                    <i class="fa-solid fa-arrows-rotate text-[10px]"></i>
                                    <span>Làm mới</span>
                                </button>
                            </div>
                        </div>
                    </div>

                    @if (isAuth)
                    {
                        <!-- Dynamic User Header with Dropdown Menu -->
                        <div class="relative border-l border-white/10 pl-3 sm:pl-4" id="userMenuContainer">
                            <button type="button" id="userMenuBtn" onclick="toggleUserDropdown()" 
                                class="flex items-center space-x-2.5 sm:space-x-3 text-left focus:outline-none group p-1 rounded-2xl hover:bg-white/5 transition">
                                <img src="@userAvatar" alt="@userFullName" class="w-9 h-9 rounded-xl object-cover ring-2 ring-purple-500/50 group-hover:ring-purple-400 transition">
                                <div class="hidden sm:block text-left">
                                    <p class="text-xs font-semibold text-white leading-tight flex items-center gap-1.5">
                                        <span>@userFullName</span>
                                        <i class="fa-solid fa-chevron-down text-[9px] text-slate-400 group-hover:text-purple-300 transition"></i>
                                    </p>
                                    <p class="text-[10px] text-purple-400 font-medium">@roleBadge</p>
                                </div>
                            </button>

                            <!-- Dropdown Popup -->
                            <div id="userDropdownMenu" class="hidden absolute right-0 mt-2.5 w-64 rounded-2xl glass-card border border-white/15 p-2 shadow-2xl z-50 transform origin-top-right transition-all">
                                <!-- User Info Banner inside dropdown -->
                                <div class="px-3 py-2.5 border-b border-white/10 mb-1">
                                    <p class="text-xs font-bold text-white truncate">@userFullName</p>
                                    <p class="text-[11px] text-slate-400 truncate">@(string.IsNullOrEmpty(userEmail) ? User.Identity?.Name : userEmail)</p>
                                    <span class="inline-block mt-1.5 px-2.5 py-0.5 rounded-full text-[9px] font-bold uppercase tracking-wider bg-purple-500/20 text-purple-300 border border-purple-500/30">
                                        @roleBadge
                                    </span>
                                </div>

                                <!-- Action Items -->
                                <div class="space-y-0.5 text-xs">
                                    <button type="button" onclick="openModal('userProfileModal'); hideUserDropdown();" 
                                        class="w-full flex items-center space-x-2.5 px-3 py-2 rounded-xl text-slate-300 hover:text-white hover:bg-purple-600/20 transition text-left">
                                        <i class="fa-regular fa-user text-purple-400 w-4 text-center"></i>
                                        <span>Hồ sơ cá nhân</span>
                                    </button>
                                    <a asp-controller="Account" asp-action="ChangePassword" 
                                        class="flex items-center space-x-2.5 px-3 py-2 rounded-xl text-slate-300 hover:text-white hover:bg-purple-600/20 transition">
                                        <i class="fa-solid fa-key text-pink-400 w-4 text-center"></i>
                                        <span>Đổi mật khẩu</span>
                                    </a>
                                </div>

                                <div class="border-t border-white/10 my-1"></div>

                                <!-- Logout Action -->
                                <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" 
                                        class="w-full flex items-center space-x-2.5 px-3 py-2 rounded-xl text-rose-400 hover:text-rose-300 hover:bg-rose-500/15 transition text-left text-xs font-semibold">
                                        <i class="fa-solid fa-arrow-right-from-bracket w-4 text-center"></i>
                                        <span>Đăng xuất</span>
                                    </button>
                                </form>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="flex items-center space-x-2 border-l border-white/10 pl-4">
                            <a asp-controller="Account" asp-action="Login" 
                                class="px-4 py-2 rounded-xl bg-purple-600 hover:bg-purple-500 text-white text-xs font-semibold shadow-lg shadow-purple-600/30 transition flex items-center space-x-1.5">
                                <i class="fa-solid fa-arrow-right-to-bracket text-[11px]"></i>
                                <span>Đăng nhập</span>
                            </a>
                        </div>
                    }
                </div>
            </header>

            <!-- MAIN CONTENT AREA WITH SCROLL -->
            <div class="flex-1 overflow-y-auto p-6 space-y-6">
                @RenderBody()
            </div>

        </div>

    </div>

    <!-- GLOBAL MODALS -->

    <!-- Modal: Booking / Tạo Lịch Hẹn Mới (2 Cột Chuẩn Dark Glassmorphism) -->
    <div id="bookingModal" class="fixed inset-0 bg-black/75 backdrop-blur-md z-50 flex items-center justify-center hidden opacity-0 transition-opacity duration-300 p-4">
        <div class="glass-card rounded-3xl border border-white/20 w-full max-w-3xl p-6 sm:p-8 shadow-2xl relative transform scale-95 transition-transform duration-300 max-h-[90vh] overflow-y-auto custom-scrollbar">
            <button type="button" onclick="closeModal('bookingModal')" class="absolute top-5 right-5 text-slate-400 hover:text-white transition">
                <i class="fa-solid fa-xmark text-xl"></i>
            </button>

            <div class="mb-5 border-b border-white/10 pb-4">
                <h3 class="text-xl font-bold text-white flex items-center gap-2.5">
                    <div class="w-9 h-9 rounded-xl bg-gradient-to-tr from-purple-600 to-indigo-600 flex items-center justify-center text-white text-sm shadow-lg shadow-purple-600/30">
                        <i class="fa-solid fa-calendar-plus"></i>
                    </div>
                    <span>Tạo Lịch Hẹn Mới</span>
                </h3>
