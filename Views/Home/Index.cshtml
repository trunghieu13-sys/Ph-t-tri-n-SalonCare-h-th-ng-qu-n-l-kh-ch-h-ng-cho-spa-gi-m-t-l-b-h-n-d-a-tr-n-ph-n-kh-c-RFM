                <input type="text" id="staffSpecialty" placeholder="Ví dụ: Chăm sóc da chuyên sâu, Massage body, Triệt lông IPL..." class="w-full glass-input rounded-xl px-3 py-2.5 text-white border border-white/10 focus:border-purple-500 outline-none" />
            </div>

            <div>
                <label class="block text-slate-300 font-medium mb-1.5">Link ảnh đại diện (Tùy chọn)</label>
