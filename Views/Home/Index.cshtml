                { name: 'Nguyễn Lan', role: 'Kỹ thuật viên Trưởng', rating: '4.9 ★', activeAppts: 5, avatar: 'https://images.unsplash.com/photo-1573496359142-b8d87734a5a2?w=100&auto=format&fit=crop&q=80' },
                { name: 'Mai Hương', role: 'Kỹ thuật viên Spa', rating: '4.8 ★', activeAppts: 3, avatar: 'https://images.unsplash.com/photo-1580489944761-15a19d654956?w=100&auto=format&fit=crop&q=80' },
                { name: 'Thu Thủy', role: 'Kỹ thuật viên Chăm sóc da', rating: '4.9 ★', activeAppts: 4, avatar: 'https://images.unsplash.com/photo-1567532939604-b6b5b0db2604?w=100&auto=format&fit=crop&q=80' },
                { name: 'Hoàng Anh', role: 'Chuyên viên Tư vấn', rating: '5.0 ★', activeAppts: 2, avatar: 'https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?w=100&auto=format&fit=crop&q=80' }
            ]
        };

        // VIEW ROUTING ENGINE
        function switchView(viewId) {
            document.querySelectorAll('.view-section').forEach(el => el.classList.remove('active-view'));
            const targetView = document.getElementById(viewId);
            if (targetView) targetView.classList.add('active-view');

            // Update Nav CSS Active State
            document.querySelectorAll('#navContainer button').forEach(btn => {
                if (btn.getAttribute('data-view') === viewId) {
                    btn.className = "nav-item w-full flex items-center space-x-3 px-4 py-3 rounded-xl bg-gradient-to-r from-purple-600/30 to-indigo-600/20 text-purple-300 font-medium border border-purple-500/30 shadow-lg shadow-purple-900/20 transition-all";
                } else {
                    btn.className = "nav-item w-full flex items-center space-x-3 px-4 py-3 rounded-xl text-slate-400 hover:text-white hover:bg-white/5 transition-all";
                }
            });

            // Update Header Title
            const titles = {
                dashboardView: 'Tổng quan ✨',
                customersView: 'Quản lý Khách hàng 👥',
                appointmentsView: 'Lịch hẹn Salon 📅',
                servicesView: 'Danh mục Dịch vụ 💆‍♀️',
                customerCareView: 'Chăm sóc khách hàng & Marketing 🤖',
                reportsView: 'Báo cáo Kinh doanh 📊',
                staffView: 'Đội ngũ Nhân viên 👩‍⚕️',
                settingsView: 'Cài đặt Hệ thống ⚙️'
            };
            document.getElementById('currentViewTitle').innerText = titles[viewId] || 'SalonCare CRM';

            // If switching to customers view, refresh from DB
            if (viewId === 'customersView') {
                loadCustomersFromDb();
            } else if (viewId === 'servicesView') {
                loadServicesToDropdown();
            } else if (viewId === 'customerCareView') {
                loadCustomerCareDashboard();
            } else if (viewId === 'reportsView') {
                loadReportsDashboard();
            } else if (viewId === 'staffView') {
                fetchStaffList();
            }

            // Auto Close Sidebar Mobile
            if (window.innerWidth < 1024) {
                document.getElementById('sidebar')?.classList.add('-translate-x-full');
                document.getElementById('mobileBackdrop')?.classList.add('hidden');
            }
        }

        // =========================================================================
        // REALTIME CUSTOMER MODULE (CONNECTS DIRECTLY TO SQL SERVER VIA CONTROLLER)
        // =========================================================================
        let currentTierFilter = 'ALL';
        let customerSearchDebounce = null;

        async function loadCustomersFromDb() {
            const searchVal = document.getElementById('custSearchInput')?.value.trim() || '';
            const tbody = document.getElementById('customerTableBody');
            if (tbody) {
                tbody.innerHTML = `
                    <tr>
                        <td colspan="7" class="p-8 text-center text-slate-400">
                            <i class="fa-solid fa-circle-notch fa-spin text-purple-400 text-lg mr-2"></i>
                            Đang tải dữ liệu từ CSDL CRM_V2...
                        </td>
                    </tr>
                `;
            }

            try {
                const url = `/Customers/GetList?tier=${encodeURIComponent(currentTierFilter)}&search=${encodeURIComponent(searchVal)}`;
                const response = await fetch(url);
                const result = await response.json();

                if (result.success) {
                    renderCustomers(result.data);

                    // Update count pills
                    if (result.counts) {
                        document.getElementById('countAll').innerText = result.counts.all.toLocaleString();
                        document.getElementById('countVip').innerText = result.counts.vip.toLocaleString();
                        document.getElementById('countLoyal').innerText = result.counts.loyal.toLocaleString();
                        document.getElementById('countNew').innerText = result.counts.newCount.toLocaleString();

                        // Also sync to Dashboard top metric
                        const dashMetric = document.getElementById('dashTotalCustomers');
                        if (dashMetric) dashMetric.innerText = result.counts.all.toLocaleString();
                    }
                } else {
                    if (tbody) {
                        tbody.innerHTML = `
                            <tr>
                                <td colspan="7" class="p-6 text-center text-rose-400">
                                    <i class="fa-solid fa-triangle-exclamation mr-1"></i> ${result.message}
                                </td>
                            </tr>
                        `;
                    }
                }
            } catch (err) {
                console.error("Lỗi kết nối CSDL:", err);
                if (tbody) {
                    tbody.innerHTML = `
                        <tr>
                            <td colspan="7" class="p-6 text-center text-slate-400">
                                <i class="fa-solid fa-circle-exclamation text-amber-400 mr-1.5"></i> Hệ thống đang đồng bộ dữ liệu với SQL Server. Vui lòng bấm vào các tab lọc để thử lại.
                            </td>
                        </tr>
                    `;
                }
            }
        }

        function renderCustomers(data) {
            const tbody = document.getElementById('customerTableBody');
            if (!tbody) return;

            if (!data || data.length === 0) {
                tbody.innerHTML = `
                    <tr>
                        <td colspan="7" class="p-8 text-center text-slate-500">
                            <i class="fa-solid fa-folder-open text-2xl mb-2 block text-slate-600"></i>
                            Chưa tìm thấy khách hàng nào phù hợp với bộ lọc.
                        </td>
                    </tr>
                `;
                return;
            }

            tbody.innerHTML = '';
            data.forEach(c => {
                const initialLetter = c.name ? c.name.trim().charAt(0).toUpperCase() : 'K';
                
                // Color badges matching the user design
                let badgeHtml = '';
                if (c.tier === 'VIP') {
                    badgeHtml = '<span class="px-3 py-1 rounded-full text-[10px] font-bold bg-amber-500/20 text-amber-300 border border-amber-500/40 tracking-wider">VIP</span>';
                } else if (c.tier === 'Than_thiet' || c.tier === 'LOYAL') {
                    badgeHtml = '<span class="px-3 py-1 rounded-full text-[10px] font-bold bg-emerald-500/20 text-emerald-300 border border-emerald-500/40 tracking-wider">LOYAL</span>';
                } else {
                    badgeHtml = '<span class="px-3 py-1 rounded-full text-[10px] font-bold bg-blue-500/20 text-blue-300 border border-blue-500/40 tracking-wider">NEW</span>';
                }

                tbody.innerHTML += `
                    <tr class="hover:bg-white/5 transition duration-150">
                        <td class="p-4 font-semibold text-white flex items-center space-x-3">
                            <div class="w-8 h-8 rounded-full bg-purple-500/20 text-purple-300 border border-purple-500/30 flex items-center justify-center font-bold text-xs shrink-0">
                                ${initialLetter}
                            </div>
                            <span class="font-medium text-white">${c.name}</span>
                        </td>
                        <td class="p-4 text-slate-300 font-mono text-xs">${c.phone}</td>
                        <td class="p-4 text-slate-400">${c.lastVisit}</td>
                        <td class="p-4 text-slate-300 font-medium">${c.visits} lượt</td>
                        <td class="p-4 font-bold text-white tracking-wide">${c.totalSpend}</td>
                        <td class="p-4">${badgeHtml}</td>
                        <td class="p-4 text-right space-x-2">
                            <button title="Xem hồ sơ chi tiết" onclick="viewCustomerDetail(${c.id})" class="text-purple-400 hover:text-purple-300 p-1.5 rounded-lg hover:bg-white/5 transition">
                                <i class="fa-solid fa-eye text-sm"></i>
                            </button>
                            <button title="Gửi thông báo / Nhắc nhở" onclick="showToast('Đang mở cổng gửi tin tới khách hàng ${c.name}!')" class="text-pink-400 hover:text-pink-300 p-1.5 rounded-lg hover:bg-white/5 transition">
                                <i class="fa-solid fa-paper-plane text-sm"></i>
                            </button>
                        </td>
                    </tr>
                `;
            });
