        async function hideAppointmentFromBoard(appointmentId) {
            try {
                const res = await fetch('/Appointments/HideFromBoard', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ appointmentId })
                });
                const result = await res.json();
                if (result.success) {
                    closeModal('appointmentDetailModal');
                    showToast(result.message, 'Đã ẩn khỏi bảng');
                    loadAppointmentsKanban();
                } else {
                    showToast(result.message || 'Không thể ẩn lịch hẹn', 'Lỗi');
                }
            } catch (err) {
                showToast('Lỗi kết nối máy chủ!', 'Lỗi');
            }
        }

        async function hideServiceFromDisplay(appointmentId, serviceId) {
            try {
                const res = await fetch('/Appointments/HideServiceDisplay', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ appointmentId, serviceId })
                });
                const result = await res.json();
                if (result.success) {
                    const rowEl = document.getElementById(`detailSrvRow_${appointmentId}_${serviceId}`);
                    if (rowEl) rowEl.remove();

                    showToast(result.message, 'Đã xóa hiển thị');
                    loadAppointmentsKanban();

                    if (result.allHidden) {
                        closeModal('appointmentDetailModal');
                    }
                } else {
                    showToast(result.message || 'Không thể xóa hiển thị dịch vụ', 'Lỗi');
                }
            } catch (err) {
                showToast('Lỗi kết nối máy chủ!', 'Lỗi');
            }
        }

        async function handleRescheduleSubmit(e, appointmentId) {
            e.preventDefault();
            const appointmentDate = document.getElementById('reschedDate').value;
            const startTime = document.getElementById('reschedStart').value;
            const endTime = document.getElementById('reschedEnd').value;
            const empVal = document.getElementById('reschedEmp').value;
            const employeeId = empVal ? parseInt(empVal) : null;
            const depositAmount = parseFloat(document.getElementById('reschedDeposit').value || '0');
            const notes = document.getElementById('reschedNotes').value;

            try {
                const res = await fetch('/Appointments/Reschedule', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        appointmentId,
                        appointmentDate,
                        startTime,
                        endTime,
                        employeeId,
                        depositAmount,
                        notes
                    })
                });
                const result = await res.json();
                if (result.success) {
                    closeModal('appointmentDetailModal');
                    showToast(result.message, 'Đã cập nhật');
                    loadAppointmentsKanban();
                } else {
                    showToast(result.message || 'Lỗi khi đổi lịch', 'Lỗi');
                }
            } catch (err) {
                showToast('Lỗi kết nối máy chủ!', 'Lỗi');
            }
        }

        // 7. Hủy lịch hẹn bắt buộc có lý do (POST /Appointments/Cancel)
        function openCancelAppointmentModal(appointmentId) {
            document.getElementById('cancelAppId').value = appointmentId;
            document.getElementById('cancelAppReason').value = '';
            openModal('cancelAppointmentModal');
        }

        async function handleConfirmCancelAppointment(e) {
            e.preventDefault();
            const appointmentId = parseInt(document.getElementById('cancelAppId').value);
            const cancellationReason = document.getElementById('cancelAppReason').value.trim();

            if (!cancellationReason) {
                showToast('Vui lòng nhập lý do hủy lịch!', 'Cảnh báo');
                return;
            }

            try {
                const res = await fetch('/Appointments/Cancel', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        appointmentId,
                        cancellationReason
                    })
                });
                const result = await res.json();
                if (result.success) {
                    closeModal('cancelAppointmentModal');
                    showToast(result.message, 'Đã hủy lịch');
                    loadAppointmentsKanban();
                } else {
                    showToast(result.message || 'Không thể hủy lịch', 'Lỗi');
                }
            } catch (err) {
                showToast('Lỗi kết nối máy chủ!', 'Lỗi');
            }
        }

        // =========================================================================
        // SERVICES MODULE (CRUD & CROSS-MODULE INTEGRATION)
        // =========================================================================
        let dbServicesList = [];
        let dbServiceCategories = [];

        /**
         * Hàm đồng bộ Dịch vụ Liên kết (Cross-Module Integration):
         * Fetch API /Services/GetAllActive, render lại Lưới Danh mục Dịch vụ (#servicesGrid),
         * đồng thời cập nhật động danh sách dịch vụ vào Modal Tạo Lịch Hẹn, Bộ lọc Kanban Lịch hẹn
         * và Biểu đồ Báo cáo mà không cần reload trang.
         */
        async function loadServicesToDropdown() {
            try {
                const res = await fetch('/Services/GetAllActive');
                const result = await res.json();
                if (!result.success) return;

                dbServicesList = result.data || [];
                dbServiceCategories = result.categories || [];
                apptMetadata.services = dbServicesList;

                // 1. Render Grid Danh mục dịch vụ (#servicesGrid)
                renderServices();

                // 2. Cập nhật Dropdown danh mục trong Modal Thêm/Sửa dịch vụ
                populateServiceCategorySelect();

                // 3. Đồng bộ sang Bộ lọc Dịch vụ ở màn hình Kanban Lịch hẹn (#apptServiceFilter)
                const srvFilter = document.getElementById('apptServiceFilter');
                if (srvFilter) {
                    const currentSrv = srvFilter.value;
                    srvFilter.innerHTML = `<option value="">💆‍♀️ Tất cả dịch vụ (${dbServicesList.length})</option>` +
                        dbServicesList.map(s => `<option value="${s.id}">${escapeHtml(s.name)} (${s.formattedPrice})</option>`).join('');
                    srvFilter.value = currentSrv;
                }

                // 4. Đồng bộ sang danh sách chọn dịch vụ trong Modal Tạo lịch hẹn mới (#appServicesContainer)
                const srvContainer = document.getElementById('appServicesContainer');
                if (srvContainer) {
                    const checkedIds = Array.from(document.querySelectorAll('input[name="appServiceCheckbox"]:checked'))
                        .map(cb => parseInt(cb.value));

                    srvContainer.innerHTML = dbServicesList.map(s => `
                        <label class="flex items-center justify-between p-2.5 rounded-xl bg-white/5 hover:bg-purple-600/15 border border-white/10 cursor-pointer transition">
                            <div class="flex items-center space-x-2.5">
                                <input type="checkbox" name="appServiceCheckbox" value="${s.id}" data-price="${s.price}"
                                    ${checkedIds.includes(s.id) ? 'checked' : ''}
                                    onchange="recalculateBookingTotal()"
                                    class="w-4 h-4 rounded accent-purple-600" />
                                <div>
                                    <span class="text-white font-semibold block">${escapeHtml(s.name)}</span>
                                    <span class="text-[10px] text-slate-400">${escapeHtml(s.categoryName)} • ${s.durationMinutes} phút</span>
                                </div>
                            </div>
                            <span class="text-xs font-bold text-emerald-400">${s.formattedPrice}</span>
                        </label>
                    `).join('');
                    recalculateBookingTotal();
                }

                // 5. Đồng bộ sang bất kỳ thẻ <select class="linked-service-dropdown"> nào khác trên toàn hệ thống
                document.querySelectorAll('select.linked-service-dropdown').forEach(selectEl => {
                    const prev = selectEl.value;
                    selectEl.innerHTML = `<option value="">-- Chọn dịch vụ --</option>` +
                        dbServicesList.map(s => `<option value="${s.id}" data-price="${s.price}">${escapeHtml(s.name)} - ${s.formattedPrice}</option>`).join('');
                    selectEl.value = prev;
                });
            } catch (err) {
                console.error('Lỗi khi đồng bộ danh mục dịch vụ:', err);
            }
        }

        function renderServices() {
            const grid = document.getElementById('servicesGrid');
            if (!grid) return;

            const badgeEl = document.getElementById('servicesTotalBadge');
            if (badgeEl) {
                badgeEl.innerText = `${dbServicesList.length} dịch vụ`;
            }

            if (!dbServicesList.length) {
                grid.innerHTML = `
                    <div class="col-span-full glass-card rounded-2xl p-8 text-center text-slate-400 border border-white/10">
                        <i class="fa-solid fa-spa text-2xl text-purple-400 mb-2 block"></i>
                        Chưa có dịch vụ nào đang hoạt động. Hãy nhấn <b>+ Thêm dịch vụ</b> để tạo mới!
                    </div>
                `;
                return;
            }

            grid.innerHTML = dbServicesList.map(s => {
                const bgColorClass = s.bgColor || 'bg-purple-500';
                const iconClass = s.iconClass || 'fa-spa';

                return `
                    <div class="glass-card glass-card-hover rounded-2xl p-5 border border-white/10 flex flex-col justify-between space-y-4 transition-all">
                        <div class="space-y-3">
                            <div class="w-11 h-11 rounded-xl ${escapeHtml(bgColorClass)} flex items-center justify-center text-white text-lg shadow-lg">
                                <i class="fa-solid ${escapeHtml(iconClass)}"></i>
                            </div>
                            <div>
                                <h4 class="text-sm font-bold text-white leading-snug">${escapeHtml(s.serviceName)}</h4>
                                <p class="text-xs text-slate-400 mt-1">${escapeHtml(s.categoryName)} • ${s.durationMinutes} phút</p>
                                ${s.description ? `<p class="text-[11px] text-slate-500 mt-1.5 line-clamp-2" title="${escapeHtml(s.description)}">${escapeHtml(s.description)}</p>` : ''}
                            </div>
                        </div>
                        <div class="flex justify-between items-center pt-3 border-t border-white/10">
                            <span class="text-base font-bold text-emerald-400">${s.formattedPrice}</span>
                            <div class="flex items-center space-x-3">
                                <button type="button" onclick="openEditServiceModal(${s.serviceId})" class="text-xs font-medium text-purple-400 hover:text-purple-300 transition">
                                    Chỉnh sửa
                                </button>
                                <button type="button" onclick="openDeleteServiceModal(${s.serviceId})" title="Xóa / Ngừng dịch vụ" class="text-slate-500 hover:text-rose-400 transition">
                                    <i class="fa-solid fa-trash-can text-xs"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                `;
            }).join('');
        }

        function populateServiceCategorySelect(selectedCategory = 'Chăm sóc da') {
            const selectEl = document.getElementById('srvCategorySelect');
            if (!selectEl) return;

            const defaultCats = ['Chăm sóc da', 'Body Care', 'Triệt lông', 'Gội đầu'];
            const allCats = Array.from(new Set([
                ...defaultCats,
                ...dbServiceCategories.map(c => c.categoryName),
                ...dbServicesList.map(s => s.categoryName)
            ])).filter(Boolean);

            selectEl.innerHTML = allCats.map(cat =>
                `<option value="${escapeHtml(cat)}">${escapeHtml(cat)}</option>`
            ).join('') + `<option value="__NEW__">+ Nhập danh mục mới...</option>`;

            if (allCats.includes(selectedCategory)) {
                selectEl.value = selectedCategory;
                document.getElementById('srvCustomCategory')?.classList.add('hidden');
            } else {
                selectEl.value = allCats[0] || 'Chăm sóc da';
            }
        }

        function handleCategorySelectChange(val) {
            const customInput = document.getElementById('srvCustomCategory');
            if (!customInput) return;

            if (val === '__NEW__') {
                customInput.classList.remove('hidden');
                customInput.focus();
                return;
            }

            customInput.classList.add('hidden');
            customInput.value = '';

            // Tự động gợi ý Icon & Màu sắc theo danh mục
            const catPreset = {
                'Chăm sóc da': { icon: 'fa-spa', color: 'bg-purple-500' },
                'Body Care': { icon: 'fa-hands-bubbles', color: 'bg-pink-500' },
                'Triệt lông': { icon: 'fa-wand-magic-sparkles', color: 'bg-cyan-500' },
                'Gội đầu': { icon: 'fa-shower', color: 'bg-emerald-500' },
                'Trị liệu chuyên sâu': { icon: 'fa-heart-pulse', color: 'bg-amber-500' }
            }[val];

            if (catPreset) {
                selectServiceIcon(catPreset.icon);
                selectServiceColor(catPreset.color);
            }
        }

        function selectServiceIcon(iconClass) {
            const input = document.getElementById('srvIconClass');
            if (input) input.value = iconClass;

            const previewIcon = document.getElementById('srvModalPreviewIcon');
            if (previewIcon) previewIcon.className = `fa-solid ${iconClass}`;

            document.querySelectorAll('.srv-icon-btn').forEach(btn => {
                if (btn.getAttribute('data-icon') === iconClass) {
                    btn.className = 'srv-icon-btn h-9 rounded-lg bg-purple-600/30 border border-purple-500 text-white flex items-center justify-center transition';
                } else {
                    btn.className = 'srv-icon-btn h-9 rounded-lg bg-white/5 border border-white/10 text-slate-300 flex items-center justify-center hover:bg-white/10 transition';
                }
            });
        }

        function selectServiceColor(bgColor) {
            const input = document.getElementById('srvBgColor');
            if (input) input.value = bgColor;

            const previewBox = document.getElementById('srvModalPreviewBox');
            if (previewBox) {
                previewBox.className = `w-12 h-12 rounded-2xl ${bgColor} flex items-center justify-center text-white text-xl shadow-lg transition-all`;
            }

            document.querySelectorAll('.srv-color-btn').forEach(btn => {
                const c = btn.getAttribute('data-color');
                if (c === bgColor) {
                    btn.className = `srv-color-btn h-9 rounded-lg ${c} ring-2 ring-white flex items-center justify-center text-white`;
                    btn.innerHTML = '<i class="fa-solid fa-check text-[10px]"></i>';
                } else {
                    btn.className = `srv-color-btn h-9 rounded-lg ${c} opacity-75 hover:opacity-100 flex items-center justify-center text-white`;
                    btn.innerHTML = '';
                }
            });
        }

        function updateServicePricePreview(val) {
            const previewEl = document.getElementById('srvPriceFormattedPreview');
            if (!previewEl) return;
            const num = parseFloat(val) || 0;
            previewEl.innerText = num > 0 ? num.toLocaleString('vi-VN') + 'đ' : '0đ';
        }

        function openAddServiceModal() {
            document.getElementById('serviceModalTitle').innerText = 'Thêm Dịch Vụ Mới';
            document.getElementById('saveServiceBtnText').innerText = 'Lưu dịch vụ';
            document.getElementById('srvId').value = '0';
            document.getElementById('srvName').value = '';
            document.getElementById('srvDuration').value = '60';
            document.getElementById('srvPrice').value = '450000';
            document.getElementById('srvDescription').value = '';
            document.getElementById('srvCustomCategory').value = '';
            document.getElementById('srvCustomCategory').classList.add('hidden');

            populateServiceCategorySelect('Chăm sóc da');
            selectServiceIcon('fa-spa');
            selectServiceColor('bg-purple-500');
            updateServicePricePreview(450000);

            openModal('serviceModal');
        }

        function openEditServiceModal(serviceId) {
            const srv = dbServicesList.find(s => s.serviceId === serviceId);
            if (!srv) return;

            document.getElementById('serviceModalTitle').innerText = 'Chỉnh Sửa Dịch Vụ';
            document.getElementById('saveServiceBtnText').innerText = 'Cập nhật dịch vụ';
            document.getElementById('srvId').value = srv.serviceId;
            document.getElementById('srvName').value = srv.serviceName;
            document.getElementById('srvDuration').value = srv.durationMinutes;
            document.getElementById('srvPrice').value = srv.price;
            document.getElementById('srvDescription').value = srv.description || '';
            document.getElementById('srvCustomCategory').value = '';
            document.getElementById('srvCustomCategory').classList.add('hidden');

            populateServiceCategorySelect(srv.categoryName);
            selectServiceIcon(srv.iconClass || 'fa-spa');
            selectServiceColor(srv.bgColor || 'bg-purple-500');
            updateServicePricePreview(srv.price);

            openModal('serviceModal');
        }

        async function handleSaveService(e) {
            e.preventDefault();

            const serviceId = parseInt(document.getElementById('srvId').value || '0');
            const serviceName = document.getElementById('srvName').value.trim();
            const catSelect = document.getElementById('srvCategorySelect').value;
            const customCat = document.getElementById('srvCustomCategory').value.trim();
            const categoryName = catSelect === '__NEW__' ? customCat : catSelect;
            const durationMinutes = parseInt(document.getElementById('srvDuration').value || '0');
            const price = parseFloat(document.getElementById('srvPrice').value || '0');
            const description = document.getElementById('srvDescription').value.trim();
            const iconClass = document.getElementById('srvIconClass').value || 'fa-spa';
            const bgColor = document.getElementById('srvBgColor').value || 'bg-purple-500';

            if (!serviceName) {
                showToast('Vui lòng nhập tên dịch vụ!', 'Cảnh báo');
                return;
            }
            if (!categoryName) {
                showToast('Vui lòng chọn hoặc nhập tên danh mục!', 'Cảnh báo');
                return;
            }
            if (durationMinutes <= 0) {
                showToast('Thời lượng dịch vụ phải lớn hơn 0 phút!', 'Cảnh báo');
                return;
            }
            if (price <= 0) {
                showToast('Giá tiền dịch vụ phải lớn hơn 0 VNĐ!', 'Cảnh báo');
                return;
            }

            const saveBtn = document.getElementById('saveServiceBtn');
            const spinner = document.getElementById('saveServiceSpinner');
            const icon = document.getElementById('saveServiceIcon');

            saveBtn.disabled = true;
            spinner.classList.remove('hidden');
            icon.classList.add('hidden');

            const endpoint = serviceId > 0 ? '/Services/Update' : '/Services/Create';

            try {
                const res = await fetch(endpoint, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        serviceId,
                        serviceName,
                        categoryName,
                        durationMinutes,
                        price,
                        description,
                        iconClass,
                        bgColor
                    })
                });
                const result = await res.json();

                if (result.success) {
                    closeModal('serviceModal');
                    showToast(result.message, 'Thành công');
                    await loadServicesToDropdown();
                } else {
                    showToast(result.message || 'Không thể lưu dịch vụ!', 'Lỗi');
                }
            } catch (err) {
                showToast('Lỗi kết nối máy chủ khi lưu dịch vụ!', 'Lỗi');
            } finally {
                saveBtn.disabled = false;
                spinner.classList.add('hidden');
                icon.classList.remove('hidden');
            }
        }

        function openDeleteServiceModal(serviceId) {
            const srv = dbServicesList.find(s => s.serviceId === serviceId);
            if (!srv) return;

            document.getElementById('deleteSrvId').value = srv.serviceId;
            document.getElementById('deleteSrvName').innerText = srv.serviceName;
            openModal('deleteServiceModal');
        }

        async function confirmDeleteService() {
            const serviceId = parseInt(document.getElementById('deleteSrvId').value || '0');
            if (serviceId <= 0) return;

            const btn = document.getElementById('confirmDeleteServiceBtn');
            const spinner = document.getElementById('deleteServiceSpinner');
            btn.disabled = true;
            spinner.classList.remove('hidden');

            try {
                const res = await fetch(`/Services/Delete/${serviceId}`, {
                    method: 'POST'
                });
                const result = await res.json();

                if (result.success) {
                    closeModal('deleteServiceModal');
                    showToast(result.message, 'Đã ẩn dịch vụ');
                    await loadServicesToDropdown();
                } else {
                    showToast(result.message || 'Không thể xóa dịch vụ!', 'Lỗi');
                }
            } catch (err) {
                showToast('Lỗi kết nối máy chủ khi xóa dịch vụ!', 'Lỗi');
            } finally {
                btn.disabled = false;
                spinner.classList.add('hidden');
            }
        }

        // =========================================================================
        // PHÂN HỆ: QUẢN LÝ NHÂN SỰ & MA TRẬN PHÂN QUYỀN (STAFF & PERMISSIONS MATRIX)
        // =========================================================================
        let cachedPermissionsMatrix = [];
        let staffDebounceTimer = null;
        let currentSelectedRoleId = 3;

        function debounceFetchStaff() {
            clearTimeout(staffDebounceTimer);
            staffDebounceTimer = setTimeout(() => {
                fetchStaffList();
            }, 300);
        }

        async function fetchStaffList() {
            const search = document.getElementById('staffSearchInput')?.value || '';
            const roleId = document.getElementById('staffRoleFilter')?.value || '';
            const status = document.getElementById('staffStatusFilter')?.value || '';

            const tbody = document.getElementById('staffTableBody');
            if (tbody) {
                tbody.innerHTML = `
                    <tr>
                        <td colspan="7" class="py-8 text-center text-slate-400">
                            <i class="fa-solid fa-circle-notch fa-spin text-purple-400 mr-2 text-sm"></i>
                            <span>Đang tải danh sách nhân sự từ CSDL...</span>
                        </td>
                    </tr>
                `;
            }

            try {
                let url = `/Staff/GetList?search=${encodeURIComponent(search)}`;
                if (roleId) url += `&roleId=${roleId}`;
                if (status) url += `&status=${encodeURIComponent(status)}`;

                const res = await fetch(url);
                const result = await res.json();

                if (!result.success) {
                    showToast(result.message || 'Không thể tải danh sách nhân viên.', 'error');
                    return;
                }

                // Cập nhật thống kê nhanh
                const totalEl = document.getElementById('totalStaffCount');
                if (totalEl) totalEl.innerText = result.total || 0;

                const activeEl = document.getElementById('activeStaffCount');
                if (activeEl) activeEl.innerText = result.activeCount || 0;

                const lockedEl = document.getElementById('lockedStaffCount');
                if (lockedEl) lockedEl.innerText = result.lockedCount || 0;

                // Render bảng dữ liệu
                renderStaffTable(result.data || []);
            } catch (err) {
                console.error("Lỗi khi tải danh sách nhân viên:", err);
                if (tbody) {
                    tbody.innerHTML = `<tr><td colspan="7" class="py-6 text-center text-rose-400">Lỗi kết nối máy chủ khi lấy dữ liệu nhân viên.</td></tr>`;
                }
            }
        }

        function renderStaffTable(staffList) {
            const tbody = document.getElementById('staffTableBody');
            if (!tbody) return;

            if (!staffList || staffList.length === 0) {
                tbody.innerHTML = `
                    <tr>
                        <td colspan="7" class="py-10 text-center text-slate-400">
