                    ? `<img src="${st.avatarUrl}" class="w-9 h-9 rounded-full object-cover ring-2 ring-purple-500/40" alt="${st.fullName}" onerror="this.src='https://ui-avatars.com/api/?name=${encodeURIComponent(st.fullName)}&background=7C3AED&color=fff&size=150'" />`
                    : `<div class="w-9 h-9 rounded-full bg-purple-600/30 text-purple-300 flex items-center justify-center font-bold text-xs ring-2 ring-purple-500/30">${st.fullName.charAt(0)}</div>`;

                let roleBadge = '';
                if (st.roleId === 1) {
                    roleBadge = `<span class="inline-flex items-center gap-1 text-[11px] px-2 py-0.5 rounded-full bg-rose-500/20 text-rose-400 border border-rose-500/30 font-medium"><i class="fa-solid fa-crown text-[9px]"></i> Admin</span>`;
                } else if (st.roleId === 2) {
                    roleBadge = `<span class="inline-flex items-center gap-1 text-[11px] px-2 py-0.5 rounded-full bg-purple-500/20 text-purple-300 border border-purple-500/30 font-medium"><i class="fa-solid fa-user-tie text-[9px]"></i> Chủ Spa</span>`;
                } else {
