        async function toggleStaffStatus(userId, fullName, currentStatus) {
            const actionText = currentStatus === 'active' ? 'tạm khóa' : 'mở khóa';
            if (!confirm(`Bạn có chắc chắn muốn ${actionText} tài khoản của nhân viên "${fullName}"?`)) {
                return;
