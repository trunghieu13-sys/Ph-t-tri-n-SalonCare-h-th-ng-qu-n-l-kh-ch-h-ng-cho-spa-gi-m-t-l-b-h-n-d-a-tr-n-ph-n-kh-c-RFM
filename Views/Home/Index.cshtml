                </div>
                <div>
                    <label class="block text-slate-300 font-medium mb-1.5">Số điện thoại <span class="text-rose-400">*</span></label>
                    <input type="tel" id="staffPhone" required placeholder="09xxxxxxxx" class="w-full glass-input rounded-xl px-3 py-2.5 text-white border border-white/10 focus:border-purple-500 outline-none" />
                </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                    <label class="block text-slate-300 font-medium mb-1.5">Email công việc <span class="text-rose-400">*</span></label>
