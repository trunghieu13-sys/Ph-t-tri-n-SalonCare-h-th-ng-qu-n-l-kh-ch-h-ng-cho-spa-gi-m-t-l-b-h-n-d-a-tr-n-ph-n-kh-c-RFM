        async function handleTestGateway(channel) {
            // Lưu cấu hình hiện tại trên form trước khi gửi thử để đảm bảo thông tin mới nhất được áp dụng
            const savePayload = {
                smtpServer: document.getElementById('cfgSmtpServer').value.trim(),
                smtpPort: parseInt(document.getElementById('cfgSmtpPort').value || '587'),
                senderName: document.getElementById('cfgSenderName').value.trim(),
                senderEmail: document.getElementById('cfgEmailUsername').value.trim(),
                username: document.getElementById('cfgEmailUsername').value.trim(),
                password: document.getElementById('cfgEmailPassword').value.trim(),
                accountSid: document.getElementById('cfgSmsAccountSid').value.trim(),
                authToken: document.getElementById('cfgSmsAuthToken').value.trim(),
                fromPhoneNumber: document.getElementById('cfgSmsFromPhone').value.trim()
            };

            await fetch('/CustomerCare/SaveGatewayConfig', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(savePayload)
            });

            const recipientInput = channel === 'EMAIL'
                ? document.getElementById('testEmailRecipient')
                : document.getElementById('testSmsRecipient');

            const recipient = recipientInput?.value.trim() || '';
            if (!recipient) {
                showToast(channel === 'EMAIL' ? 'Vui lòng nhập Email nhận thử!' : 'Vui lòng nhập SĐT nhận thử!', 'Cảnh báo');
                recipientInput?.focus();
                return;
            }

            const btn = document.getElementById(channel === 'EMAIL' ? 'btnTestEmail' : 'btnTestSms');
            const fb = document.getElementById('gatewayConfigFeedback');
            const origHtml = btn.innerHTML;
            btn.disabled = true;
            btn.innerHTML = '<i class="fa-solid fa-circle-notch fa-spin"></i> Đang gửi...';

            try {
                const res = await fetch('/CustomerCare/TestGateway', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ channel, recipient })
                });
                const result = await res.json();

                if (fb) {
                    fb.classList.remove('hidden');
                    fb.className = result.success
                        ? 'p-3.5 rounded-xl border border-emerald-500/30 bg-emerald-500/10 text-emerald-300 text-xs font-medium'
                        : 'p-3.5 rounded-xl border border-rose-500/30 bg-rose-500/10 text-rose-300 text-xs font-medium';
                    fb.innerText = result.message;
                }

                showToast(result.message, result.success ? 'Gửi thành công' : 'Gửi thất bại');
                await loadCustomerCareDashboard();
            } catch (err) {
                showToast('Lỗi kết nối máy chủ khi gửi thử!', 'Lỗi');
            } finally {
                btn.disabled = false;
                btn.innerHTML = origHtml;
            }
        }

        function renderAutomationRules(rules) {
            const container = document.getElementById('automationRulesContainer');
            if (!container || !rules.length) return;

            container.innerHTML = rules.map(rule => {
                const badgeClass = rule.isActive
                    ? 'bg-emerald-500/20 text-emerald-400'
                    : 'bg-amber-500/20 text-amber-400';
                const badgeText = rule.isActive ? 'Kích hoạt' : 'Tạm dừng';
                const checkedAttr = rule.isActive ? 'checked' : '';

                return `
                    <div class="p-4 rounded-xl bg-white/5 border border-white/10 flex items-center justify-between gap-4 hover:border-purple-500/30 transition-all">
                        <div class="space-y-1">
                            <div class="flex items-center space-x-2">
                                <span class="font-bold text-white">${escapeHtml(rule.ruleName)}</span>
                                <span id="ruleBadge-${rule.ruleId}" class="px-2 py-0.5 rounded text-[10px] ${badgeClass} font-semibold">${badgeText}</span>
                            </div>
                            <p class="text-slate-400">${escapeHtml(rule.description || '')}</p>
                        </div>
                        <input type="checkbox" ${checkedAttr} onchange="toggleAutomationRule(${rule.ruleId}, this)" class="w-4 h-4 accent-purple-600 cursor-pointer shrink-0">
                    </div>
                `;
            }).join('');
        }

        async function toggleAutomationRule(ruleId, checkboxEl) {
            const isActive = checkboxEl.checked;
            const badgeEl = document.getElementById(`ruleBadge-${ruleId}`);

            try {
                const res = await fetch('/CustomerCare/ToggleRule', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ ruleId: ruleId, isActive: isActive })
                });
                const result = await res.json();

                if (result.success) {
                    if (badgeEl) {
                        badgeEl.textContent = result.isActive ? 'Kích hoạt' : 'Tạm dừng';
                        badgeEl.className = result.isActive
                            ? 'px-2 py-0.5 rounded text-[10px] bg-emerald-500/20 text-emerald-400 font-semibold'
                            : 'px-2 py-0.5 rounded text-[10px] bg-amber-500/20 text-amber-400 font-semibold';
                    }
                    showToast(result.message);
                } else {
                    checkboxEl.checked = !isActive;
                    showToast(result.message || 'Không thể cập nhật trạng thái kịch bản!');
                }
            } catch (err) {
                checkboxEl.checked = !isActive;
                showToast('Lỗi kết nối máy chủ khi cập nhật kịch bản!');
            }
        }

        function populateCampaignGroups(groups) {
            const selectEl = document.getElementById('campaignGroup');
            if (!selectEl) return;

            const currentVal = selectEl.value || 'ALL';
            const fmt = (n) => Number(n || 0).toLocaleString('vi-VN');

            selectEl.innerHTML = `
                <option value="ALL">Tất cả khách hàng (${fmt(groups.allCount)})</option>
                <option value="VIP">Khách hàng VIP (${fmt(groups.vipCount)})</option>
                <option value="Than_thiet">Khách hàng Thân thiết (${fmt(groups.loyalCount)})</option>
                <option value="Moi">Khách hàng Mới (${fmt(groups.newCount)})</option>
                <option value="INACTIVE">Khách chưa quay lại > 30 ngày (${fmt(groups.inactiveCount)})</option>
            `;
            selectEl.value = currentVal;
