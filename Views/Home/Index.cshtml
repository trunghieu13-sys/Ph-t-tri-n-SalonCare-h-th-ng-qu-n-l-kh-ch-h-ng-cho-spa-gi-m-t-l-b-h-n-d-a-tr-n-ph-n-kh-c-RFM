                    errBox.classList.remove('hidden');
                    errBox.innerText = 'Vui lòng nhập chuyên môn của nhân viên.';
                }
                return;
            }

            try {
                if (btn) {
                    btn.disabled = true;
                    btn.innerHTML = '<i class="fa-solid fa-circle-notch fa-spin"></i><span>Đang lưu...</span>';
                }

                const res = await fetch('/Staff/UpdateSpecialty', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ userId, specialty })
                });

