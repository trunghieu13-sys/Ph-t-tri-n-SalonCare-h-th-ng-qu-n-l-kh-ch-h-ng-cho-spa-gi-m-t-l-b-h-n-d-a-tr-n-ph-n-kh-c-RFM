                            <span class="text-slate-200 font-medium truncate">${escapeHtml(s.name)}</span>
                            <span class="text-[10px] text-slate-500">(${s.bookingCount} lượt)</span>
                        </div>
                        <span class="${s.textColor || 'text-purple-300'} font-bold text-xs">${s.percentage}%</span>
                    </div>
                    <div class="w-full h-2 rounded-full bg-slate-800/80 overflow-hidden p-0.5 border border-white/5">
                        <div class="h-full bg-gradient-to-r ${s.gradientClass || 'from-purple-500 to-indigo-500'} rounded-full transition-all duration-700" style="width: ${Math.max(s.percentage, 4)}%"></div>
                    </div>
                </div>
            `).join('');
        }

        // ==========================================
        // 6-MONTH REVENUE CHART (CHART.JS)
        // ==========================================
        function renderDashboardRevenueChart(chartData) {
            const canvasRev = document.getElementById('revenueChart');
            if (!canvasRev) return;

            if (dashRevenueChartInstance) {
                dashRevenueChartInstance.destroy();
                dashRevenueChartInstance = null;
            }

            const labels = (chartData?.labels && chartData.labels.length > 0) 
                ? chartData.labels 
                : ['Th5', 'Th6', 'Th7', 'Th8', 'Th9', 'Th10'];
            const dataValues = (chartData?.data && chartData.data.length > 0)
                ? chartData.data
                : [0, 0, 0, 1.8, 2.75, 4.25];

            const ctxRev = canvasRev.getContext('2d');
            const gradientRev = ctxRev.createLinearGradient(0, 0, 0, 260);
            gradientRev.addColorStop(0, 'rgba(168, 85, 247, 0.45)');
            gradientRev.addColorStop(1, 'rgba(168, 85, 247, 0.0)');

            dashRevenueChartInstance = new Chart(ctxRev, {
                type: 'line',
                data: {
                    labels: labels,
                    datasets: [{
                        label: 'Doanh thu (triệu VNĐ)',
                        data: dataValues,
                        borderColor: '#A855F7',
                        borderWidth: 3,
                        pointBackgroundColor: '#EC4899',
                        pointBorderColor: '#ffffff',
                        pointBorderWidth: 2,
                        pointRadius: 5,
                        pointHoverRadius: 7,
                        fill: true,
                        backgroundColor: gradientRev,
                        tension: 0.4
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            backgroundColor: 'rgba(15, 23, 42, 0.9)',
                            titleColor: '#ffffff',
                            bodyColor: '#A855F7',
                            borderColor: 'rgba(255, 255, 255, 0.1)',
                            borderWidth: 1,
                            padding: 10,
                            callbacks: {
                                label: function(context) {
                                    const val = context.parsed.y || 0;
                                    return ` Doanh thu: ${val.toLocaleString('vi-VN')} triệu VNĐ`;
                                }
                            }
                        }
                    },
                    scales: {
                        x: {
                            grid: { color: 'rgba(255, 255, 255, 0.05)' },
                            ticks: { color: '#94a3b8', font: { size: 11 } }
                        },
                        y: {
                            grid: { color: 'rgba(255, 255, 255, 0.05)' },
                            ticks: {
                                color: '#94a3b8',
                                font: { size: 11 },
                                callback: function(val) {
                                    return val + ' tr';
                                }
                            }
                        }
                    }
                }
            });
        }

        // =========================================================================
        // PHÂN HỆ: BÁO CÁO & PHÂN TÍCH KINH DOANH (REPORTS & ANALYTICS DASHBOARD)
        // =========================================================================
        let currentReportPeriod = 'this_month';
        let reportRevenueChartInstance = null;
        let reportServicePieChartInstance = null;

        function formatVnCurrency(num) {
            if (num === null || num === undefined) return '0đ';
            return new Intl.NumberFormat('vi-VN').format(Math.round(num)) + 'đ';
        }

        function formatVnCompact(num) {
            if (num >= 1000000000) return (num / 1000000000).toFixed(1) + ' tỷ';
            if (num >= 1000000) return (num / 1000000).toFixed(1) + ' tr';
            if (num >= 1000) return (num / 1000).toFixed(0) + ' k';
            return num.toString();
        }

        function changeReportPeriod(period, btnElement) {
            currentReportPeriod = period;

            // Reset Custom Date Pickers
            const fromInput = document.getElementById('reportFromDate');
            const toInput = document.getElementById('reportToDate');
            if (fromInput) fromInput.value = '';
            if (toInput) toInput.value = '';

            // Update Period Pills Active Styling
            document.querySelectorAll('#reportPeriodPills .report-period-btn').forEach(btn => {
                btn.className = "report-period-btn px-3 py-1.5 rounded-xl text-xs font-semibold text-slate-300 hover:text-white hover:bg-white/10 transition-all";
            });
            if (btnElement) {
                btnElement.className = "report-period-btn active px-3 py-1.5 rounded-xl text-xs font-semibold bg-gradient-to-r from-purple-600 to-indigo-600 text-white shadow-lg shadow-purple-600/30 transition-all";
            }

            loadReportsDashboard(period);
        }

        function applyCustomReportDate() {
            const fromDate = document.getElementById('reportFromDate')?.value;
            const toDate = document.getElementById('reportToDate')?.value;

            if (!fromDate || !toDate) {
                showToast('Vui lòng chọn đầy đủ ngày bắt đầu và kết thúc!', 'error');
                return;
            }

            if (new Date(fromDate) > new Date(toDate)) {
                showToast('Ngày bắt đầu không được lớn hơn ngày kết thúc!', 'error');
                return;
            }

            currentReportPeriod = 'custom';

            // Remove active pills
            document.querySelectorAll('#reportPeriodPills .report-period-btn').forEach(btn => {
                btn.className = "report-period-btn px-3 py-1.5 rounded-xl text-xs font-semibold text-slate-300 hover:text-white hover:bg-white/10 transition-all";
            });

            loadReportsDashboard('custom', fromDate, toDate);
        }

        async function loadReportsDashboard(period, customFrom, customTo) {
            period = period || currentReportPeriod;
            let url = `/Reports/GetOverviewData?period=${period}`;
            if (customFrom && customTo) {
                url += `&fromDate=${encodeURIComponent(customFrom)}&toDate=${encodeURIComponent(customTo)}`;
            } else if (period === 'custom') {
                const fromVal = document.getElementById('reportFromDate')?.value;
                const toVal = document.getElementById('reportToDate')?.value;
                if (fromVal && toVal) {
                    url += `&fromDate=${encodeURIComponent(fromVal)}&toDate=${encodeURIComponent(toVal)}`;
                }
            }

            try {
                const res = await fetch(url);
                const data = await res.json();

                if (!data.success) {
                    showToast(data.message || 'Không thể tải báo cáo!', 'error');
                    return;
                }

                // 1. Update Header Banner
                const periodTextEl = document.getElementById('reportActivePeriodText');
                if (periodTextEl) periodTextEl.innerText = data.periodDisplay || period;

                const rangeTextEl = document.getElementById('reportActiveDateRange');
                if (rangeTextEl) rangeTextEl.innerText = data.formattedDateRange || `${data.fromDate} - ${data.toDate}`;

                // Set date inputs if empty
                const fromInput = document.getElementById('reportFromDate');
                const toInput = document.getElementById('reportToDate');
                if (fromInput && !fromInput.value) fromInput.value = data.fromDate;
                if (toInput && !toInput.value) toInput.value = data.toDate;

                // 2. Populate 4 KPI Cards
                const kpis = data.kpis || {};
                const bookingStats = data.bookingStats || {};

                const totalRevEl = document.getElementById('kpiTotalRevenue');
                if (totalRevEl) totalRevEl.innerText = kpis.formattedRevenue || '0đ';

                const directRevEl = document.getElementById('kpiDirectRevenue');
                if (directRevEl) directRevEl.innerText = formatVnCurrency(kpis.directRevenue);

                const onlineRevEl = document.getElementById('kpiOnlineRevenue');
                if (onlineRevEl) onlineRevEl.innerText = formatVnCurrency(kpis.onlineRevenue);

                const growthBadgeEl = document.getElementById('kpiGrowthBadge');
                if (growthBadgeEl) {
                    const isPos = kpis.isGrowthPositive;
                    const growthVal = Math.abs(kpis.growthRatePercentage || 0).toFixed(1);
                    if (isPos) {
                        growthBadgeEl.className = "inline-flex items-center px-2 py-0.5 rounded-full bg-emerald-500/20 text-emerald-400 font-medium text-[11px]";
                        growthBadgeEl.innerHTML = `<i class="fa-solid fa-arrow-trend-up mr-1 text-[10px]"></i>+${growthVal}%`;
                    } else {
                        growthBadgeEl.className = "inline-flex items-center px-2 py-0.5 rounded-full bg-rose-500/20 text-rose-400 font-medium text-[11px]";
                        growthBadgeEl.innerHTML = `<i class="fa-solid fa-arrow-trend-down mr-1 text-[10px]"></i>-${growthVal}%`;
                    }
                }

                const visitsEl = document.getElementById('kpiCompletedVisits');
                if (visitsEl) visitsEl.innerHTML = `${kpis.totalCompletedVisits || 0} <span class="text-sm font-normal text-slate-400">ca</span>`;

                const depositsEl = document.getElementById('kpiTotalDeposits');
                if (depositsEl) depositsEl.innerText = kpis.formattedDeposits || '0đ';

                const cancelRateEl = document.getElementById('kpiCancellationRate');
                if (cancelRateEl) cancelRateEl.innerText = `${(bookingStats.cancellationRatePercentage || 0).toFixed(1)}%`;

                const aovEl = document.getElementById('kpiAov');
                if (aovEl) aovEl.innerText = kpis.formattedAov || '0đ';

                const retentionEl = document.getElementById('kpiRetentionRate');
                if (retentionEl) retentionEl.innerText = `${(kpis.retentionRatePercentage || 0).toFixed(1)}%`;

                const custCountsEl = document.getElementById('kpiCustomerCounts');
                if (custCountsEl) custCountsEl.innerText = `${kpis.newCustomers || 0} mới • ${kpis.returningCustomers || 0} quay lại`;

                const totalActiveEl = document.getElementById('kpiTotalActiveCustomers');
                if (totalActiveEl) totalActiveEl.innerText = (kpis.totalActiveCustomers || 0).toString();

                // 3. Render Trend Line Chart (Doanh thu & Số ca)
                renderReportsRevenueChart(data.trend?.labels || [], data.trend?.revenues || [], data.trend?.visits || []);

                // 4. Render Top Services Doughnut Chart & Custom Legend
                renderReportsServiceChart(data.services || []);

                // 5. Populate Top Staff Table
                renderReportsStaffTable(data.staff || []);

                // 6. Populate Booking Conversion & Customer Tiers
                renderReportsBookingAndTiers(data.bookingStats || {}, data.customerTiers || []);

            } catch (err) {
                console.error("Lỗi khi tải dữ liệu báo cáo:", err);
                showToast("Không thể kết nối đến máy chủ báo cáo!", "error");
            }
        }

        function renderReportsRevenueChart(labels, revenues, visits) {
            const canvas = document.getElementById('reportsRevenueChart');
            if (!canvas) return;

            if (reportRevenueChartInstance) {
                reportRevenueChartInstance.destroy();
                reportRevenueChartInstance = null;
            }

            const ctx = canvas.getContext('2d');
            const gradientRev = ctx.createLinearGradient(0, 0, 0, 260);
            gradientRev.addColorStop(0, 'rgba(168, 85, 247, 0.45)');
            gradientRev.addColorStop(1, 'rgba(168, 85, 247, 0.0)');

            reportRevenueChartInstance = new Chart(ctx, {
                type: 'line',
                data: {
                    labels: labels,
                    datasets: [
                        {
                            label: 'Doanh thu (VNĐ)',
                            data: revenues,
                            borderColor: '#A855F7',
                            borderWidth: 3,
                            pointBackgroundColor: '#EC4899',
                            pointBorderColor: '#FFFFFF',
                            pointHoverRadius: 6,
                            pointRadius: 4,
                            fill: true,
                            backgroundColor: gradientRev,
                            tension: 0.35,
                            yAxisID: 'y'
                        },
                        {
                            label: 'Số ca phục vụ',
                            data: visits,
                            type: 'bar',
                            backgroundColor: 'rgba(34, 211, 238, 0.65)',
                            hoverBackgroundColor: 'rgba(34, 211, 238, 0.95)',
                            borderRadius: 6,
                            barThickness: labels.length > 15 ? 8 : 16,
                            yAxisID: 'y1'
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    interaction: {
                        mode: 'index',
                        intersect: false
                    },
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            backgroundColor: 'rgba(15, 23, 42, 0.95)',
                            borderColor: 'rgba(255, 255, 255, 0.1)',
                            borderWidth: 1,
                            titleColor: '#F8FAFC',
                            bodyColor: '#E2E8F0',
                            padding: 10,
                            boxPadding: 4,
                            callbacks: {
                                label: function (context) {
                                    if (context.datasetIndex === 0) {
                                        return ` Doanh thu: ${formatVnCurrency(context.raw)}`;
                                    } else {
                                        return ` Số ca: ${context.raw} ca`;
                                    }
                                }
                            }
                        }
                    },
                    scales: {
                        x: {
                            grid: { color: 'rgba(255, 255, 255, 0.05)' },
                            ticks: {
                                color: '#94A3B8',
                                font: { size: 10 },
                                maxTicksLimit: 12
                            }
                        },
                        y: {
                            type: 'linear',
                            position: 'left',
                            grid: { color: 'rgba(255, 255, 255, 0.05)' },
                            ticks: {
                                color: '#C084FC',
                                font: { size: 10 },
                                callback: function (val) {
                                    return formatVnCompact(val);
                                }
                            }
                        },
                        y1: {
                            type: 'linear',
                            position: 'right',
                            grid: { drawOnChartArea: false },
                            ticks: {
                                color: '#22D3EE',
                                font: { size: 10 },
                                stepSize: 1
                            }
                        }
                    }
                }
            });
        }

        function renderReportsServiceChart(services) {
            const canvas = document.getElementById('reportsServicePieChart');
            const legendContainer = document.getElementById('reportsServiceLegend');
            if (!canvas) return;

            if (reportServicePieChartInstance) {
                reportServicePieChartInstance.destroy();
                reportServicePieChartInstance = null;
            }

            if (!services || services.length === 0) {
                if (legendContainer) {
                    legendContainer.innerHTML = '<div class="text-xs text-slate-400 text-center py-4">Chưa có dịch vụ nào hoàn thành trong kỳ này</div>';
                }
                return;
            }

            const colors = ['#8B5CF6', '#EC4899', '#06B6D4', '#10B981', '#F59E0B', '#6366F1'];
            const labels = services.map(s => s.serviceName);
            const dataValues = services.map(s => s.totalRevenue);
            const bgColors = services.map((_, i) => colors[i % colors.length]);

            const ctx = canvas.getContext('2d');
            reportServicePieChartInstance = new Chart(ctx, {
                type: 'doughnut',
                data: {
                    labels: labels,
                    datasets: [{
                        data: dataValues,
                        backgroundColor: bgColors,
                        borderWidth: 2,
                        borderColor: '#0F172A',
                        hoverOffset: 6
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    cutout: '68%',
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            backgroundColor: 'rgba(15, 23, 42, 0.95)',
                            borderColor: 'rgba(255, 255, 255, 0.1)',
                            borderWidth: 1,
                            callbacks: {
                                label: function (context) {
                                    const val = context.raw || 0;
                                    const s = services[context.dataIndex];
                                    return ` ${s.serviceName}: ${formatVnCurrency(val)} (${s.percentage}%)`;
                                }
                            }
                        }
                    }
                }
            });

            // Render Custom HTML Legend
            if (legendContainer) {
                legendContainer.innerHTML = services.map((s, i) => {
                    const c = bgColors[i];
                    return `
                        <div class="flex items-center justify-between text-xs py-1 border-b border-white/5 last:border-none">
                            <div class="flex items-center gap-2 truncate max-w-[60%]">
                                <span class="w-2.5 h-2.5 rounded-full flex-shrink-0" style="background-color: ${c}"></span>
                                <span class="text-slate-300 truncate" title="${s.serviceName}">${s.serviceName}</span>
                            </div>
                            <div class="flex items-center gap-2 text-right">
                                <span class="text-[11px] text-slate-400">${s.orderCount} ca</span>
                                <span class="font-semibold text-white">${s.formattedRevenue}</span>
                                <span class="text-[10px] px-1.5 py-0.5 rounded bg-white/10 text-purple-300 font-mono">${s.percentage}%</span>
                            </div>
                        </div>
                    `;
                }).join('');
            }
        }

        function renderReportsStaffTable(staffList) {
            const tbody = document.getElementById('reportsStaffTableBody');
            if (!tbody) return;

            if (!staffList || staffList.length === 0) {
                tbody.innerHTML = `<tr><td colspan="5" class="py-4 text-center text-slate-400">Không có dữ liệu nhân viên trong khoảng thời gian này</td></tr>`;
                return;
            }

            const rankBadges = [
                `<span class="w-5 h-5 rounded-full bg-amber-500/20 text-amber-400 font-bold inline-flex items-center justify-center text-[10px] border border-amber-500/40">1</span>`,
                `<span class="w-5 h-5 rounded-full bg-slate-300/20 text-slate-200 font-bold inline-flex items-center justify-center text-[10px] border border-slate-300/40">2</span>`,
                `<span class="w-5 h-5 rounded-full bg-orange-700/20 text-orange-400 font-bold inline-flex items-center justify-center text-[10px] border border-orange-700/40">3</span>`
            ];

            tbody.innerHTML = staffList.map((st, idx) => {
                const rankHtml = idx < 3 ? rankBadges[idx] : `<span class="text-slate-400 font-medium">${idx + 1}</span>`;
                const avatar = st.avatarUrl
                    ? `<img src="${st.avatarUrl}" class="w-7 h-7 rounded-full object-cover border border-purple-500/30" alt="${st.fullName}" />`
                    : `<div class="w-7 h-7 rounded-full bg-purple-600/30 text-purple-300 flex items-center justify-center font-bold text-xs">${st.fullName.charAt(0)}</div>`;

                const roleBadge = st.roleName.toLowerCase() === 'admin'
                    ? `<span class="text-[10px] px-1.5 py-0.5 rounded bg-purple-500/20 text-purple-300">Admin</span>`
                    : st.roleName.toLowerCase() === 'owner'
                    ? `<span class="text-[10px] px-1.5 py-0.5 rounded bg-blue-500/20 text-blue-300">Owner</span>`
                    : `<span class="text-[10px] px-1.5 py-0.5 rounded bg-emerald-500/20 text-emerald-300">KTV</span>`;

                return `
                    <tr class="hover:bg-white/5 transition-all">
                        <td class="py-2.5 pl-1">${rankHtml}</td>
                        <td class="py-2.5">
                            <div class="flex items-center gap-2">
                                ${avatar}
                                <div>
                                    <div class="font-medium text-white text-xs">${st.fullName}</div>
                                    <div class="text-[10px] text-slate-400">${roleBadge}</div>
                                </div>
                            </div>
                        </td>
                        <td class="py-2.5 text-center font-medium text-slate-300">${st.appointmentsServed}</td>
                        <td class="py-2.5 text-right font-semibold text-emerald-400">${st.formattedRevenue}</td>
                        <td class="py-2.5 text-center">
                            <span class="inline-flex items-center gap-1 text-amber-400 font-semibold text-xs">
                                <i class="fa-solid fa-star text-[10px]"></i>${(st.rating || 5).toFixed(1)}
                            </span>
                        </td>
                    </tr>
                `;
            }).join('');
        }

        function renderReportsBookingAndTiers(bookingStats, customerTiers) {
            const total = Math.max(1, bookingStats.totalBooked || 0);
            const compCnt = bookingStats.completedCount || 0;
            const cancCnt = bookingStats.cancelledCount || 0;
            const noShowCnt = bookingStats.noShowCount || 0;

            const compPct = Math.round((compCnt / total) * 100);
            const cancPct = Math.round((cancCnt / total) * 100);
            const noShowPct = Math.round((noShowCnt / total) * 100);

            // Progress text & bars
            const compText = document.getElementById('bookingStatCompletedText');
            if (compText) compText.innerText = `${compCnt} ca (${compPct}%)`;
            const compBar = document.getElementById('bookingStatCompletedBar');
            if (compBar) compBar.style.width = `${compPct}%`;

            const cancText = document.getElementById('bookingStatCancelledText');
            if (cancText) cancText.innerText = `${cancCnt} ca (${cancPct}%)`;
            const cancBar = document.getElementById('bookingStatCancelledBar');
            if (cancBar) cancBar.style.width = `${cancPct}%`;

            const noShowText = document.getElementById('bookingStatNoShowText');
            if (noShowText) noShowText.innerText = `${noShowCnt} ca (${noShowPct}%)`;
            const noShowBar = document.getElementById('bookingStatNoShowBar');
            if (noShowBar) noShowBar.style.width = `${noShowPct}%`;

            // Customer Tiers Grid
            const tiersGrid = document.getElementById('reportsCustomerTiersGrid');
            if (tiersGrid) {
                if (!customerTiers || customerTiers.length === 0) {
                    tiersGrid.innerHTML = '<div class="col-span-3 text-xs text-slate-400 text-center py-2">Chưa có phân khúc khách hàng</div>';
                    return;
                }

                tiersGrid.innerHTML = customerTiers.map(t => {
                    let badgeClass = "text-blue-400 border-blue-500/30 bg-blue-500/10";
                    let tierNameDisplay = t.tierName;
                    if (t.tierName.toLowerCase().includes('vip')) {
                        badgeClass = "text-amber-400 border-amber-500/30 bg-amber-500/10";
                        tierNameDisplay = "VIP";
                    } else if (t.tierName.toLowerCase().includes('than')) {
                        badgeClass = "text-purple-400 border-purple-500/30 bg-purple-500/10";
                        tierNameDisplay = "Thân thiết";
                    } else {
                        tierNameDisplay = "Mới";
                    }

                    return `
                        <div class="p-3 rounded-xl border ${badgeClass} text-center">
                            <span class="text-[11px] font-semibold block">${tierNameDisplay}</span>
                            <span class="text-base font-bold text-white block mt-0.5">${t.customerCount}</span>
                            <span class="text-[10px] text-slate-400 block mt-0.5">${formatVnCompact(t.totalSpent)}</span>
                        </div>
                    `;
                }).join('');
            }
        }

        function exportReportsExcel() {
            const from = document.getElementById('reportFromDate')?.value || '';
            const to = document.getElementById('reportToDate')?.value || '';
            showToast('Đang tạo và tải xuống file Excel báo cáo SalonCare...', 'info');
            window.location.href = `/Reports/ExportExcel?period=${encodeURIComponent(currentReportPeriod)}&fromDate=${encodeURIComponent(from)}&toDate=${encodeURIComponent(to)}`;
        }

        function exportReportsPdf() {
            window.print();
        }
    </script>

