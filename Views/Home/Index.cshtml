            <div class="pt-4 border-t border-white/10 flex items-center justify-end gap-3">
                <button type="button" onclick="closeModal('addStaffModal')" class="px-4 py-2.5 rounded-xl bg-white/10 hover:bg-white/20 text-slate-300 font-medium transition">Hủy</button>
                <button type="submit" id="btnSubmitStaff" class="px-5 py-2.5 rounded-xl bg-gradient-to-r from-purple-600 to-indigo-600 hover:from-purple-500 text-white font-bold shadow-lg shadow-purple-600/30 flex items-center gap-2 transition">
                    <i class="fa-solid fa-check"></i>
                    <span>Tạo nhân viên</span>
                </button>
            </div>
        </form>
    </div>
