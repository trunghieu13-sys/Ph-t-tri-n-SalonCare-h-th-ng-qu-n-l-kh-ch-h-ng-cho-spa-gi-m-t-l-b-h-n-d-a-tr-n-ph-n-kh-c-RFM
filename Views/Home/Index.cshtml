                    avatarContainer.innerHTML = `<img src="${avatarUrl}" class="w-11 h-11 rounded-full object-cover ring-2 ring-purple-500/40" alt="${fullName}" onerror="this.src='https://ui-avatars.com/api/?name=${encodeURIComponent(fullName)}&background=7C3AED&color=fff&size=150'" />`;
                } else {
                    avatarContainer.innerHTML = `<div class="w-11 h-11 rounded-full bg-purple-600/30 text-purple-300 flex items-center justify-center font-bold text-sm ring-2 ring-purple-500/30">${fullName.charAt(0)}</div>`;
