        function filterCustomers(tier) {
            currentTierFilter = tier;

            // Update UI tab styles
            const btns = {
                'ALL': 'filterAllBtn',
                'VIP': 'filterVipBtn',
                'Than_thiet': 'filterLoyalBtn',
                'Moi': 'filterNewBtn'
            };

            document.querySelectorAll('#customerFilterButtons button').forEach(b => {
                b.className = "cust-filter-btn px-4 py-2 rounded-xl text-xs font-semibold bg-white/5 hover:bg-white/10 text-slate-300 transition";
            });

            const activeBtnId = btns[tier] || 'filterAllBtn';
            const activeBtn = document.getElementById(activeBtnId);
            if (activeBtn) {
                activeBtn.className = "cust-filter-btn px-4 py-2 rounded-xl text-xs font-semibold bg-purple-600 text-white shadow-lg shadow-purple-600/30 transition";
            }

            loadCustomersFromDb();
        }

        function searchCustomers() {
            clearTimeout(customerSearchDebounce);
            customerSearchDebounce = setTimeout(() => {
                loadCustomersFromDb();
            }, 300);
        }

        // =========================================================================
        // MODAL TẠO KHÁCH HÀNG MỚI (BACKEND POST /Customers/Create)
        // =========================================================================
        function openAddCustomerModal() {
            const form = document.getElementById('createCustomerForm');
            if (form) form.reset();
            const errBox = document.getElementById('customerFormError');
            if (errBox) errBox.classList.add('hidden');
            openModal('addCustomerModal');
        }

        async function handleCreateCustomerSubmit(e) {
            e.preventDefault();

            const errBox = document.getElementById('customerFormError');
            const errMsg = document.getElementById('customerFormErrorMsg');
            const spinner = document.getElementById('saveCustomerSpinner');
            const icon = document.getElementById('saveCustomerIcon');
            const btnText = document.getElementById('saveCustomerText');
            const submitBtn = document.getElementById('saveCustomerBtn');

            errBox.classList.add('hidden');

            // 1. Thu thập dữ liệu từ Form
            const fullName = document.getElementById('custFullName').value.trim();
            const phone = document.getElementById('custPhone').value.trim();
            const email = document.getElementById('custEmail').value.trim();
            const gender = document.getElementById('custGender').value;
            const dob = document.getElementById('custDob').value;
            const address = document.getElementById('custAddress').value.trim();
            const source = document.getElementById('custSource').value;
            const type = document.getElementById('custType').value;
            const status = document.getElementById('custStatus').value;
            const avatarUrl = document.getElementById('custAvatarUrl').value.trim();
            const notes = document.getElementById('custNotes').value.trim();

            // 2. Validate nhanh phía Client
            const phoneRegex = /^(0|\+84)(3[2-9]|5[25689]|7[06-9]|8[1-9]|9[0-9])[0-9]{7}$/;
            if (!phoneRegex.test(phone)) {
                errMsg.innerText = "Số điện thoại không đúng định dạng Việt Nam (VD: 0901234567 hoặc +84901234567).";
                errBox.classList.remove('hidden');
                return;
            }

            // 3. Hiển thị trạng thái Loading
            spinner.classList.remove('hidden');
            icon.classList.add('hidden');
            btnText.innerText = 'Đang lưu vào CSDL...';
            submitBtn.disabled = true;

            try {
                // 4. Gửi Request POST tới Controller
                const response = await fetch('/Customers/Create', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({
                        fullName: fullName,
                        phone: phone,
                        email: email || null,
                        gender: gender,
                        dateOfBirth: dob ? dob : null,
                        address: address || null,
                        customerSource: source,
                        customerType: type,
                        customerStatus: status,
                        avatarUrl: avatarUrl || null,
                        notes: notes || null
                    })
                });

                const result = await response.json();

                if (result.success) {
                    closeModal('addCustomerModal');
                    showToast(result.message, 'Lưu thành công!');
                    // Tự động tải lại bảng khách hàng từ SQL Server
                    loadCustomersFromDb();
                } else {
                    errMsg.innerText = result.message || "Không thể lưu thông tin khách hàng.";
                    if (result.errors && result.errors.length > 0) {
                        errMsg.innerText = result.errors.join(' | ');
                    }
                    errBox.classList.remove('hidden');
                }
            } catch (err) {
                console.error("Lỗi khi thêm khách hàng:", err);
                errMsg.innerText = "Lỗi kết nối tới máy chủ khi lưu khách hàng!";
                errBox.classList.remove('hidden');
            } finally {
                // Khôi phục trạng thái nút bấm
                spinner.classList.add('hidden');
                icon.classList.remove('hidden');
                btnText.innerText = 'Lưu khách hàng';
                submitBtn.disabled = false;
            }
        }

