                    <span class="text-slate-300 flex items-center gap-1.5"><i class="fa-solid fa-envelope text-purple-400"></i> Gmail:</span>
                    <span id="ccEmailStatusPill" class="px-1.5 py-0.5 rounded bg-amber-500/20 text-amber-400 font-semibold text-[10px]">Chưa cài</span>
                </div>
                <div onclick="openGatewayConfigModal()" class="p-2.5 rounded-xl bg-white/5 border border-white/10 hover:border-pink-500/40 cursor-pointer flex items-center justify-between transition">
