                    <input type="text" id="staffUsername" required placeholder="Ví dụ: maitran" class="w-full glass-input rounded-xl px-3 py-2.5 text-white border border-white/10 focus:border-purple-500 outline-none" />
                </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                    <label class="block text-slate-300 font-medium mb-1.5">Mật khẩu khởi tạo <span class="text-rose-400">*</span></label>
                    <input type="password" id="staffPassword" required minlength="6" placeholder="Tối thiểu 6 ký tự" class="w-full glass-input rounded-xl px-3 py-2.5 text-white border border-white/10 focus:border-purple-500 outline-none" />
                </div>
                <div>
                    <label class="block text-slate-300 font-medium mb-1.5">Chức vụ / Vai trò ban đầu <span class="text-rose-400">*</span></label>
                    <select id="staffRoleId" required class="w-full glass-input rounded-xl px-3 py-2.5 text-white border border-white/10 bg-slate-900 outline-none">
                        <option value="3" selected>Kỹ thuật viên (Staff)</option>
                        <option value="2">Chủ Spa / Quản lý (Owner)</option>
                        <option value="1">Quản trị viên (Admin)</option>
                    </select>
