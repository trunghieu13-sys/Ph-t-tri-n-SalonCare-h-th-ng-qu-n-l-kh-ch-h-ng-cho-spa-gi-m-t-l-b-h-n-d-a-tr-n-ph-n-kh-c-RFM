                }

                let statusBadge = st.status === 'active'
                    ? `<span class="inline-flex items-center gap-1 text-[10px] px-2 py-0.5 rounded-full bg-emerald-500/20 text-emerald-400 font-medium"><span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span> Đang làm</span>`
                    : `<span class="inline-flex items-center gap-1 text-[10px] px-2 py-0.5 rounded-full bg-amber-500/20 text-amber-400 font-medium"><span class="w-1.5 h-1.5 rounded-full bg-amber-400"></span> Tạm khóa</span>`;

                return `
                    <tr class="hover:bg-white/[0.03] transition-all">
                        <!-- Nhân viên -->
                        <td class="py-3 px-4">
                            <div class="flex items-center gap-3">
                                ${avatar}
                                <div>
                                    <div class="font-bold text-white text-xs">${st.fullName}</div>
                                    <div class="text-[11px] text-slate-400 font-mono">&#64;${st.username}</div>
                                </div>
                            </div>
                        </td>

                        <!-- Liên hệ -->
                        <td class="py-3 px-4">
                            <div class="text-xs text-slate-300 font-medium">${st.phone || 'Chưa cập nhật'}</div>
                            <div class="text-[11px] text-slate-400 truncate max-w-[170px]" title="${st.email}">${st.email}</div>
                        </td>

                        <!-- Chuyên môn -->
                        <td class="py-3 px-4">
                            <button type="button" onclick="openEditSpecialtyModal(${st.userId}, '${st.fullName.replace(/'/g, "\\'")}', '${(st.specialty || '').replace(/'/g, "\\'")}', '${(st.avatarUrl || '').replace(/'/g, "\\'")}')" class="group/spec flex items-center gap-1.5 text-xs text-slate-300 bg-white/5 hover:bg-purple-600/20 hover:text-white px-2.5 py-1.5 rounded-lg border border-white/10 hover:border-purple-500/40 transition-all text-left" title="Nhấp để chỉnh sửa chuyên môn">
                                <i class="fa-solid fa-wand-magic-sparkles text-purple-400 text-[10px] group-hover/spec:scale-110 transition-transform"></i>
                                <span>${st.specialty || 'Chăm sóc tổng hợp'}</span>
                                <i class="fa-solid fa-pen text-[9px] text-slate-500 group-hover/spec:text-purple-300 opacity-60 group-hover/spec:opacity-100 transition-opacity ml-1"></i>
                            </button>
                        </td>

                        <!-- Vai trò -->
                        <td class="py-3 px-4 text-center">
                            ${roleBadge}
                        </td>

                        <!-- Số ca phụ trách -->
                        <td class="py-3 px-4 text-center font-semibold text-slate-200">
                            <span class="bg-purple-500/10 text-purple-300 px-2 py-0.5 rounded-lg border border-purple-500/20 font-mono">${st.appointmentsCount} ca</span>
                        </td>

                        <!-- Trạng thái -->
                        <td class="py-3 px-4 text-center">
                            ${statusBadge}
                        </td>

                        <!-- Thao tác -->
                        <td class="py-3 px-4 text-right">
                            <div class="flex items-center justify-end gap-1.5">
                                <!-- Nút Sửa Chuyên môn -->
                                <button type="button" onclick="openEditSpecialtyModal(${st.userId}, '${st.fullName.replace(/'/g, "\\'")}', '${(st.specialty || '').replace(/'/g, "\\'")}', '${(st.avatarUrl || '').replace(/'/g, "\\'")}')" class="px-2 py-1 rounded-lg bg-purple-600/20 hover:bg-purple-600 text-purple-300 hover:text-white border border-purple-500/30 text-xs font-semibold flex items-center gap-1.5 transition-all shadow-sm" title="Chỉnh sửa chuyên môn">
                                    <i class="fa-solid fa-wand-magic-sparkles text-[10px]"></i>
                                    <span>Chuyên môn</span>
                                </button>

                                <!-- Nút Phân quyền -->
                                <button type="button" onclick="openRolePermissionModal(${st.userId})" class="px-2.5 py-1 rounded-lg bg-indigo-600/30 hover:bg-indigo-600 text-indigo-300 hover:text-white border border-indigo-500/40 text-xs font-semibold flex items-center gap-1.5 transition-all shadow-sm" title="Phân quyền & Vai trò">
                                    <i class="fa-solid fa-shield-halved text-[11px]"></i>
                                    <span>Phân quyền</span>
                                </button>

                                <!-- Nút Khóa / Mở khóa -->
                                <button type="button" onclick="toggleStaffStatus(${st.userId}, '${st.fullName.replace(/'/g, "\\'")}', '${st.status}')" class="p-1.5 rounded-lg bg-white/5 hover:bg-white/10 text-slate-300 hover:text-amber-400 border border-white/10 transition-all text-xs" title="${st.status === 'active' ? 'Tạm khóa tài khoản' : 'Mở khóa tài khoản'}">
                                    <i class="fa-solid ${st.status === 'active' ? 'fa-lock' : 'fa-lock-open'}"></i>
                                </button>

                                <!-- Nút Xóa / Nghỉ việc -->
                                <button type="button" onclick="deleteStaff(${st.userId}, '${st.fullName.replace(/'/g, "\\'")}')" class="p-1.5 rounded-lg bg-white/5 hover:bg-rose-600/30 text-slate-400 hover:text-rose-400 border border-white/10 transition-all text-xs" title="Đánh dấu đã nghỉ việc">
                                    <i class="fa-solid fa-user-xmark"></i>
                                </button>
                            </div>
                        </td>
                    </tr>
                `;
            }).join('');
        }

        // =========================================================================
        // MODAL 1: THÊM NHÂN VIÊN MỚI
        // =========================================================================
        function openAddStaffModal() {
            const form = document.getElementById('createStaffForm');
            if (form) form.reset();
            const errBox = document.getElementById('staffFormError');
            if (errBox) errBox.classList.add('hidden');
            openModal('addStaffModal');
        }

        async function handleCreateStaff(e) {
            e.preventDefault();

            const fullName = document.getElementById('staffFullName')?.value.trim();
            const phone = document.getElementById('staffPhone')?.value.trim();
            const email = document.getElementById('staffEmail')?.value.trim();
            const username = document.getElementById('staffUsername')?.value.trim();
            const password = document.getElementById('staffPassword')?.value;
            const roleId = parseInt(document.getElementById('staffRoleId')?.value || '3');
            const specialty = document.getElementById('staffSpecialty')?.value.trim();
            const avatarUrl = document.getElementById('staffAvatarUrl')?.value.trim();

            const errBox = document.getElementById('staffFormError');
            const submitBtn = document.getElementById('btnSubmitStaff');

            const payload = {
                fullName,
                phone,
                email,
                username,
                password,
                roleId,
                specialty,
                avatarUrl
            };

            try {
                if (submitBtn) {
                    submitBtn.disabled = true;
                    submitBtn.innerHTML = '<i class="fa-solid fa-circle-notch fa-spin"></i><span>Đang xử lý...</span>';
                }

                const res = await fetch('/Staff/Create', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });
                const result = await res.json();

                if (result.success) {
                    closeModal('addStaffModal');
                    showToast(result.message || 'Thêm nhân viên mới thành công!', 'success');
                    fetchStaffList();
                } else {
                    if (errBox) {
                        errBox.innerText = result.message || 'Không thể tạo tài khoản nhân viên.';
                        errBox.classList.remove('hidden');
                    } else {
                        showToast(result.message, 'error');
                    }
                }
            } catch (err) {
                console.error("Lỗi khi thêm nhân viên:", err);
                if (errBox) {
                    errBox.innerText = 'Lỗi kết nối khi gửi yêu cầu.';
                    errBox.classList.remove('hidden');
                }
            } finally {
                if (submitBtn) {
                    submitBtn.disabled = false;
                    submitBtn.innerHTML = '<i class="fa-solid fa-check"></i><span>Tạo nhân viên</span>';
                }
            }
        }

        // =========================================================================
        // MODAL 2: PHÂN QUYỀN & NÂNG / HẠ CẤP VAI TRÒ (ROLE / PERMISSION MATRIX)
        // =========================================================================
        async function openRolePermissionModal(userId) {
            try {
                // Tải ma trận quyền nếu chưa có
                if (!cachedPermissionsMatrix || cachedPermissionsMatrix.length === 0) {
                    const matrixRes = await fetch('/Staff/GetPermissionsMatrix');
                    const matrixData = await matrixRes.json();
                    if (matrixData.success) {
                        cachedPermissionsMatrix = matrixData.data || [];
                    }
                }

                // Tải chi tiết nhân viên
                const res = await fetch(`/Staff/GetDetail/${userId}`);
                const result = await res.json();

                if (!result.success || !result.data) {
                    showToast('Không tìm thấy thông tin nhân viên.', 'error');
                    return;
                }

                const st = result.data;
                document.getElementById('permTargetUserId').value = st.userId;
                document.getElementById('permStaffName').innerText = st.fullName;
                document.getElementById('permStaffUsername').innerText = st.username;
                document.getElementById('permStaffSpecialty').innerText = st.specialty || 'Chăm sóc & Dịch vụ';

                const avatarEl = document.getElementById('permStaffAvatar');
                if (avatarEl) {
                    avatarEl.src = st.avatarUrl || `https://ui-avatars.com/api/?name=${encodeURIComponent(st.fullName)}&background=7C3AED&color=fff&size=150`;
                }

                // Badge vai trò hiện tại
                const roleBadgeEl = document.getElementById('permCurrentRoleBadge');
                if (roleBadgeEl) {
                    roleBadgeEl.className = st.roleId === 1
                        ? "text-[10px] px-2 py-0.5 rounded-full bg-rose-500/20 text-rose-400 border border-rose-500/30 font-medium"
                        : st.roleId === 2
                        ? "text-[10px] px-2 py-0.5 rounded-full bg-purple-500/20 text-purple-300 border border-purple-500/30 font-medium"
                        : "text-[10px] px-2 py-0.5 rounded-full bg-blue-500/20 text-blue-400 border border-blue-500/30 font-medium";
                    roleBadgeEl.innerText = `Hiện tại: ${st.roleDisplayName}`;
                }

                // Chọn vai trò tương ứng và cập nhật bảng xem trước
                selectRoleCard(st.roleId);

                openModal('rolePermissionModal');
            } catch (err) {
                console.error("Lỗi khi mở modal phân quyền:", err);
                showToast("Lỗi khi tải thông tin phân quyền nhân viên.", "error");
            }
        }

        function selectRoleCard(roleId) {
            currentSelectedRoleId = roleId;

            // Update radio buttons
            document.querySelectorAll('input[name="targetRoleId"]').forEach(r => {
                r.checked = (parseInt(r.value) === roleId);
            });

            // Update card styling
            [1, 2, 3].forEach(id => {
                const card = document.getElementById(`roleCard${id}`);
                if (!card) return;

                if (id === roleId) {
                    if (id === 1) {
                        card.className = "role-select-card cursor-pointer p-3.5 rounded-xl border border-rose-500 bg-rose-500/15 shadow-lg shadow-rose-600/20 transition-all text-left relative ring-1 ring-rose-500";
                    } else if (id === 2) {
                        card.className = "role-select-card cursor-pointer p-3.5 rounded-xl border border-purple-500 bg-purple-500/15 shadow-lg shadow-purple-600/20 transition-all text-left relative ring-1 ring-purple-500";
                    } else {
                        card.className = "role-select-card cursor-pointer p-3.5 rounded-xl border border-blue-500 bg-blue-500/15 shadow-lg shadow-blue-600/20 transition-all text-left relative ring-1 ring-blue-500";
                    }
                } else {
                    card.className = "role-select-card cursor-pointer p-3.5 rounded-xl border border-white/10 bg-white/[0.02] hover:bg-white/5 transition-all text-left relative opacity-70";
                }
            });

            // Update badge preview
            const previewBadge = document.getElementById('permRoleBadgePreview');
            if (previewBadge) {
                if (roleId === 1) {
                    previewBadge.className = "text-[10px] px-2 py-0.5 rounded-full bg-rose-500/20 text-rose-400 border border-rose-500/30 font-medium";
                    previewBadge.innerText = "Quyền Hạn Toàn Bộ (SuperAdmin)";
                } else if (roleId === 2) {
                    previewBadge.className = "text-[10px] px-2 py-0.5 rounded-full bg-purple-500/20 text-purple-300 border border-purple-500/30 font-medium";
                    previewBadge.innerText = "Quyền Điều Hành Spa (Owner)";
                } else {
                    previewBadge.className = "text-[10px] px-2 py-0.5 rounded-full bg-blue-500/20 text-blue-400 border border-blue-500/30 font-medium";
                    previewBadge.innerText = "Quyền Kỹ Thuật Viên (Staff)";
                }
            }

            // Render live preview permissions table
            renderPermissionsMatrixTable(roleId);
        }

        function renderPermissionsMatrixTable(roleId) {
            const tbody = document.getElementById('permMatrixTableBody');
            if (!tbody) return;

            const roleInfo = cachedPermissionsMatrix.find(r => r.roleId === roleId);
            if (!roleInfo || !roleInfo.permissions || roleInfo.permissions.length === 0) {
                tbody.innerHTML = `<tr><td colspan="6" class="py-4 text-center text-slate-400">Đang chuẩn bị ma trận quyền...</td></tr>`;
                return;
            }

            const checkIcon = `<i class="fa-solid fa-check text-emerald-400 text-xs"></i>`;
            const crossIcon = `<i class="fa-solid fa-xmark text-slate-600 text-xs"></i>`;

            tbody.innerHTML = roleInfo.permissions.map(p => `
                <tr class="hover:bg-white/[0.02] transition-all">
                    <td class="py-2.5 px-3 font-medium text-white">${p.moduleName}</td>
                    <td class="py-2.5 px-2 text-center">${p.canView ? checkIcon : crossIcon}</td>
                    <td class="py-2.5 px-2 text-center">${p.canCreate ? checkIcon : crossIcon}</td>
                    <td class="py-2.5 px-2 text-center">${p.canEdit ? checkIcon : crossIcon}</td>
                    <td class="py-2.5 px-2 text-center">${p.canDelete ? checkIcon : crossIcon}</td>
                    <td class="py-2.5 px-3 text-slate-400 text-[11px]">${p.note}</td>
                </tr>
            `).join('');
        }

        async function saveRolePermissionChange() {
            const userId = parseInt(document.getElementById('permTargetUserId')?.value || '0');
            const newRoleId = currentSelectedRoleId;

            if (userId <= 0 || newRoleId <= 0) {
                showToast('Thông tin phân quyền không hợp lệ.', 'error');
                return;
            }

            const btn = document.getElementById('btnSaveRoleChange');
            try {
                if (btn) {
                    btn.disabled = true;
                    btn.innerHTML = '<i class="fa-solid fa-circle-notch fa-spin"></i><span>Đang cập nhật...</span>';
                }

                const res = await fetch('/Staff/UpdateRole', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ userId, newRoleId })
                });
                const result = await res.json();

                if (result.success) {
                    closeModal('rolePermissionModal');
                    showToast(result.message || 'Cập nhật vai trò nhân viên thành công!', 'success');
