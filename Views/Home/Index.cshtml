        let currentGatewayConfig = {};

        async function loadCustomerCareDashboard() {
            try {
                const res = await fetch('/CustomerCare/GetDashboardData');
                const data = await res.json();
                if (!data.success) return;

                renderAutomationRules(data.rules || []);
                populateCampaignGroups(data.groups || {});
                renderCustomerInteractions(data.interactions || []);
                if (data.gateway) {
                    currentGatewayConfig = data.gateway;
                    renderGatewayStatus(data.gateway);
                }
            } catch (err) {
                console.error('Lỗi tải dữ liệu Chăm sóc khách hàng:', err);
