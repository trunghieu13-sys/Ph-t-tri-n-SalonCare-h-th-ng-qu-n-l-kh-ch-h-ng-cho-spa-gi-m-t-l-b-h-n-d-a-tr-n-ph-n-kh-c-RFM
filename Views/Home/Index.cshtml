        function toggleCustomerServiceHistory() {
            const section = document.getElementById('custServiceHistorySection');
            const chevron = document.getElementById('custHistoryChevron');
            if (!section) return;

            section.classList.toggle('hidden');
            if (chevron) {
                chevron.classList.toggle('rotate-180');
            }
        }

        function filterCustomerServiceHistory(filterType) {
            currentCustomerHistoryFilter = filterType;
            const tabs = ['ALL', 'Completed', 'Cancelled'];
            tabs.forEach(t => {
                const btn = document.getElementById(`histTab_${t}`);
                if (!btn) return;
                if (t === filterType) {
                    btn.className = 'px-2.5 py-1 rounded-lg text-[10px] font-bold bg-purple-600 text-white transition';
                } else {
                    btn.className = 'px-2.5 py-1 rounded-lg text-[10px] font-semibold bg-white/5 hover:bg-white/10 text-slate-300 transition';
                }
            });
            renderCustomerServiceHistoryItems();
        }

        function renderCustomerServiceHistoryItems() {
            const listEl = document.getElementById('custServiceHistoryList');
            if (!listEl) return;

            let filtered = currentCustomerServiceHistory || [];
            if (currentCustomerHistoryFilter === 'Completed') {
                filtered = filtered.filter(x => x.status === 'Completed');
            } else if (currentCustomerHistoryFilter === 'Cancelled') {
                filtered = filtered.filter(x => x.status === 'Cancelled' || x.status === 'NoShow');
            }

            if (!filtered.length) {
                listEl.innerHTML = `
                    <div class="p-4 text-center text-slate-500 bg-white/5 rounded-xl border border-white/5">
                        Chưa có dữ liệu dịch vụ nào trong mục này.
                    </div>
                `;
                return;
            }

            const statusBadgeMap = {
                'Completed': '<span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-emerald-500/20 text-emerald-400 border border-emerald-500/30">Đã hoàn thành</span>',
                'Cancelled': '<span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-rose-500/20 text-rose-400 border border-rose-500/30">Đã hủy</span>',
                'NoShow': '<span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-orange-500/20 text-orange-400 border border-orange-500/30">Vắng mặt</span>',
                'InService': '<span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-purple-500/20 text-purple-300 border border-purple-500/30">Đang phục vụ</span>',
                'Confirmed': '<span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-cyan-500/20 text-cyan-300 border border-cyan-500/30">Đã xác nhận</span>',
                'Pending': '<span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-amber-500/20 text-amber-300 border border-amber-500/30">Chờ xác nhận</span>'
            };

            listEl.innerHTML = filtered.map(item => {
                const badge = statusBadgeMap[item.status] || `<span class="px-2 py-0.5 rounded text-[10px] bg-white/10 text-slate-300">${item.status}</span>`;
                const srvItems = (item.services || []).map(s => `
                    <div class="flex items-center justify-between text-[11px] py-0.5">
                        <span class="text-white font-medium"><i class="fa-solid fa-spa text-purple-400 mr-1.5 text-[10px]"></i>${escapeHtml(s.serviceName)} <span class="text-slate-500">(${s.durationMinutes}p)</span></span>
                        <span class="text-emerald-400 font-semibold">${s.formattedPrice}</span>
                    </div>
                `).join('');

                const cancelInfo = item.cancellationReason
                    ? `<div class="text-[10px] text-rose-300 italic mt-1 bg-rose-500/10 px-2 py-1 rounded-lg border border-rose-500/20"><i class="fa-solid fa-circle-info mr-1"></i>Lý do hủy: "${escapeHtml(item.cancellationReason)}"</div>`
                    : '';

                return `
                    <div class="p-3 rounded-xl bg-white/5 border border-white/10 space-y-1.5 hover:border-purple-500/30 transition">
                        <div class="flex items-center justify-between">
                            <span class="text-[11px] font-bold text-slate-300">
                                <i class="fa-regular fa-calendar-check text-purple-400 mr-1"></i>#${item.appointmentId} • ${item.appointmentDate} (${item.startTime})
                            </span>
                            ${badge}
                        </div>
                        <div class="pl-1 border-l-2 border-purple-500/30 space-y-0.5">
                            ${srvItems || '<span class="text-slate-500 text-[11px]">Không có dịch vụ đính kèm</span>'}
                        </div>
                        <div class="flex items-center justify-between pt-1 border-t border-white/5 text-[10px] text-slate-400">
                            <span>👩‍⚕️ KTV: <b class="text-slate-300">${escapeHtml(item.employeeName)}</b></span>
                            <span>Tổng: <b class="text-emerald-400 text-xs">${item.formattedTotal}</b></span>
                        </div>
                        ${cancelInfo}
                    </div>
                `;
            }).join('');
        }

        // =========================================================================
        // MODAL CHỈNH SỬA KHÁCH HÀNG (GET /Customers/GetDetail & POST /Customers/Update)
        // =========================================================================
        async function openEditCustomerModal(id) {
            // Đóng modal xem chi tiết trước nếu đang mở
            closeModal('customerProfileModal');

            const errBox = document.getElementById('editCustomerFormError');
            if (errBox) errBox.classList.add('hidden');

            try {
                // Tải dữ liệu khách hàng từ server
                const response = await fetch(`/Customers/GetDetail?id=${id}`);
                const res = await response.json();

                if (!res.success) {
                    showToast(res.message || "Không thể tải thông tin khách hàng.", "Lỗi");
                    return;
                }

                const c = res.data;

                // Điền dữ liệu vào form chỉnh sửa
                document.getElementById('editCustId').value = c.id;
                document.getElementById('editCustFullName').value = c.rawFullName || c.name || '';
                document.getElementById('editCustPhone').value = c.rawPhone || c.phone || '';
                document.getElementById('editCustEmail').value = c.rawEmail || '';
                document.getElementById('editCustGender').value = c.rawGender || 'Nữ';
                document.getElementById('editCustDob').value = c.rawDob || '';
                document.getElementById('editCustAddress').value = c.rawAddress || '';
                document.getElementById('editCustSource').value = c.rawSource || 'Truc_tiep';
                document.getElementById('editCustType').value = c.rawTier || 'Moi';
                document.getElementById('editCustStatus').value = c.rawStatus || 'Hoat_dong';
                document.getElementById('editCustAvatarUrl').value = c.rawAvatarUrl || '';
                document.getElementById('editCustNotes').value = c.rawNotes || '';

                // Mở modal chỉnh sửa
                openModal('editCustomerModal');
            } catch (err) {
                console.error("Lỗi khi mở modal chỉnh sửa:", err);
                showToast("Lỗi kết nối khi tải dữ liệu khách hàng.", "Lỗi");
            }
        }

        async function handleEditCustomerSubmit(e) {
            e.preventDefault();

            const errBox = document.getElementById('editCustomerFormError');
            const errMsg = document.getElementById('editCustomerFormErrorMsg');
            const spinner = document.getElementById('updateCustomerSpinner');
            const icon = document.getElementById('updateCustomerIcon');
            const btnText = document.getElementById('updateCustomerText');
            const submitBtn = document.getElementById('updateCustomerBtn');

            if (errBox) errBox.classList.add('hidden');

            // 1. Thu thập dữ liệu
            const id = parseInt(document.getElementById('editCustId').value);
            const fullName = document.getElementById('editCustFullName').value.trim();
            const phone = document.getElementById('editCustPhone').value.trim();
            const email = document.getElementById('editCustEmail').value.trim();
            const gender = document.getElementById('editCustGender').value;
            const dob = document.getElementById('editCustDob').value;
            const address = document.getElementById('editCustAddress').value.trim();
            const source = document.getElementById('editCustSource').value;
            const type = document.getElementById('editCustType').value;
            const status = document.getElementById('editCustStatus').value;
            const avatarUrl = document.getElementById('editCustAvatarUrl').value.trim();
            const notes = document.getElementById('editCustNotes').value.trim();

            // 2. Validate phía Client
            const phoneRegex = /^(0|\+84)(3[2-9]|5[25689]|7[06-9]|8[1-9]|9[0-9])[0-9]{7}$/;
            if (!phoneRegex.test(phone)) {
                if (errMsg) errMsg.innerText = "Số điện thoại không đúng định dạng Việt Nam (VD: 0901234567 hoặc +84901234567).";
                if (errBox) errBox.classList.remove('hidden');
                return;
            }

            // 3. Hiển thị Loading
            spinner.classList.remove('hidden');
            icon.classList.add('hidden');
            btnText.innerText = 'Đang lưu cập nhật...';
            submitBtn.disabled = true;

            try {
                const response = await fetch('/Customers/Update', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({
                        customerId: id,
                        fullName: fullName,
                        phone: phone,
                        email: email || null,
                        gender: gender,
                        dateOfBirth: dob ? dob : null,
                        address: address || null,
                        customerSource: source,
                        customerType: type,
                        customerStatus: status,
                        avatarUrl: avatarUrl || null,
                        notes: notes || null
                    })
                });

                const result = await response.json();

                if (result.success) {
                    closeModal('editCustomerModal');
                    showToast(result.message, 'Thành công!');

                    // Tải lại danh sách khách hàng từ SQL Server
                    loadCustomersFromDb();

                    // Tự động mở lại modal chi tiết để người dùng xem thông tin mới cập nhật
                    setTimeout(() => {
                        viewCustomerDetail(id);
                    }, 400);
                } else {
                    if (errMsg) {
                        errMsg.innerText = result.message || "Không thể cập nhật thông tin khách hàng.";
                        if (result.errors && result.errors.length > 0) {
                            errMsg.innerText = result.errors.join(' | ');
                        }
                    }
                    if (errBox) errBox.classList.remove('hidden');
                }
            } catch (err) {
                console.error("Lỗi khi cập nhật khách hàng:", err);
                if (errMsg) errMsg.innerText = "Lỗi kết nối tới máy chủ khi cập nhật khách hàng!";
                if (errBox) errBox.classList.remove('hidden');
            } finally {
                spinner.classList.add('hidden');
                icon.classList.remove('hidden');
                btnText.innerText = 'Lưu thay đổi';
                submitBtn.disabled = false;
            }
        }

        // =========================================================================
        // PHÂN HỆ QUẢN LÝ LỊCH HẸN KANBAN & DRAG-AND-DROP (SQL SERVER)
        // =========================================================================
        let apptMetadata = { customers: [], employees: [], services: [] };
        let draggedApptId = null;
        let draggedFromStatus = null;
        let apptSearchTimer = null;

        function debounceLoadAppointments() {
            clearTimeout(apptSearchTimer);
            apptSearchTimer = setTimeout(() => {
                loadAppointmentsKanban();
            }, 300);
        }

        function handleDateFilterChange() {
            const val = document.getElementById('apptDateFilter')?.value;
            const customBox = document.getElementById('apptCustomDateRange');
            if (customBox) {
                if (val === 'custom') customBox.classList.remove('hidden');
                else customBox.classList.add('hidden');
            }
            loadAppointmentsKanban();
        }

        function resetAppointmentFilters() {
            if (document.getElementById('apptSearchInput')) document.getElementById('apptSearchInput').value = '';
            if (document.getElementById('apptDateFilter')) document.getElementById('apptDateFilter').value = 'all';
            if (document.getElementById('apptStatusFilter')) document.getElementById('apptStatusFilter').value = 'ALL';
            if (document.getElementById('apptEmployeeFilter')) document.getElementById('apptEmployeeFilter').value = '';
            if (document.getElementById('apptServiceFilter')) document.getElementById('apptServiceFilter').value = '';
            document.getElementById('apptCustomDateRange')?.classList.add('hidden');
            loadAppointmentsKanban();
        }

        function exportAppointmentsCsv() {
            const dateFilter = document.getElementById('apptDateFilter')?.value || 'all';
            const status = document.getElementById('apptStatusFilter')?.value || 'ALL';
            window.location.href = `/Appointments/ExportCsv?dateFilter=${encodeURIComponent(dateFilter)}&status=${encodeURIComponent(status)}`;
            showToast('Đang tải xuống file dữ liệu lịch hẹn (CSV/Excel)...');
        }

        // 1. Tải danh mục Khách hàng, Nhân viên, Dịch vụ từ CSDL
        async function loadAppointmentMetadata() {
            try {
                const res = await fetch('/Appointments/GetMetadata');
                const data = await res.json();
                if (!data.success) return;

                apptMetadata.customers = data.customers || [];
                apptMetadata.employees = data.employees || [];
                apptMetadata.services = data.services || [];

                // Đổ dữ liệu vào bộ lọc Nhân viên
                const empFilter = document.getElementById('apptEmployeeFilter');
                if (empFilter) {
                    const currentEmp = empFilter.value;
                    empFilter.innerHTML = `<option value="">👩‍⚕️ Tất cả KTV (${apptMetadata.employees.length})</option>` +
                        apptMetadata.employees.map(e => `<option value="${e.id}">${e.name}</option>`).join('');
                    empFilter.value = currentEmp;
                }

                // Đổ dữ liệu vào bộ lọc Dịch vụ
                const srvFilter = document.getElementById('apptServiceFilter');
                if (srvFilter) {
                    const currentSrv = srvFilter.value;
                    srvFilter.innerHTML = `<option value="">💆‍♀️ Tất cả dịch vụ (${apptMetadata.services.length})</option>` +
                        apptMetadata.services.map(s => `<option value="${s.id}">${s.name}</option>`).join('');
                    srvFilter.value = currentSrv;
                }

                // Đổ dữ liệu vào Modal Tạo Lịch Hẹn
                populateBookingModalOptions();
            } catch (err) {
                console.error("Lỗi khi tải metadata lịch hẹn:", err);
            }
        }

        function populateBookingModalOptions() {
            const custSelect = document.getElementById('appCustomerId');
            if (custSelect) {
                custSelect.innerHTML = `<option value="">-- Chọn khách hàng (${apptMetadata.customers.length} hồ sơ) --</option>` +
                    apptMetadata.customers.map(c => `<option value="${c.id}">${c.name} - ${c.phone} (${c.tier})</option>`).join('');
            }

            const empSelect = document.getElementById('appEmployeeId');
            if (empSelect) {
                empSelect.innerHTML = `<option value="">-- Chưa phân công (Tự động điều phối) --</option>` +
                    apptMetadata.employees.map(e => `<option value="${e.id}">${e.name}</option>`).join('');
            }

            const srvContainer = document.getElementById('appServicesContainer');
            if (srvContainer) {
                srvContainer.innerHTML = apptMetadata.services.map(s => `
                    <label class="flex items-center justify-between p-2.5 rounded-xl bg-white/5 hover:bg-purple-600/15 border border-white/10 cursor-pointer transition">
                        <div class="flex items-center space-x-2.5">
                            <input type="checkbox" name="appServiceCheckbox" value="${s.id}" data-price="${s.price}" 
                                onchange="recalculateBookingTotal()" 
                                class="w-4 h-4 rounded accent-purple-600" />
                            <div>
                                <span class="text-white font-semibold block">${s.name}</span>
                                <span class="text-[10px] text-slate-400">${s.category || 'Spa'} • ${s.duration} phút</span>
                            </div>
                        </div>
                        <span class="text-xs font-bold text-emerald-400">${s.formattedPrice}</span>
                    </label>
                `).join('');
            }
            recalculateBookingTotal();
        }

        function recalculateBookingTotal() {
            const checkboxes = document.querySelectorAll('input[name="appServiceCheckbox"]:checked');
            let total = 0;
            checkboxes.forEach(cb => {
                total += parseFloat(cb.getAttribute('data-price') || '0');
            });

            const countEl = document.getElementById('appSelectedServiceCount');
            const totalEl = document.getElementById('appTotalPriceDisplay');
            if (countEl) countEl.innerText = `Đã chọn ${checkboxes.length} dịch vụ`;
            if (totalEl) totalEl.innerText = total.toLocaleString('vi-VN') + 'đ';
        }

        // 2. Tải và Render Bảng Kanban Lịch Hẹn từ CSDL
        async function loadAppointmentsKanban() {
            const search = document.getElementById('apptSearchInput')?.value || '';
            const dateFilter = document.getElementById('apptDateFilter')?.value || 'all';
            const fromDate = document.getElementById('apptFromDate')?.value || '';
            const toDate = document.getElementById('apptToDate')?.value || '';
            const status = document.getElementById('apptStatusFilter')?.value || 'ALL';
            const employeeId = document.getElementById('apptEmployeeFilter')?.value || '';
            const serviceId = document.getElementById('apptServiceFilter')?.value || '';

            const params = new URLSearchParams({
                dateFilter,
                fromDate,
                toDate,
                status,
                employeeId,
                serviceId,
                search
            });

            try {
                const res = await fetch(`/Appointments/GetKanban?${params.toString()}`);
                const result = await res.json();
                if (!result.success) return;

                const list = result.data || [];
                const sum = result.summary || {};

                // Cập nhật số lượng trên huy hiệu
                const totalBadge = document.getElementById('apptTotalBadge');
                if (totalBadge) totalBadge.innerText = `${sum.total || 0} lịch hẹn`;

                const statusCols = ['Pending', 'Confirmed', 'InService', 'Completed', 'NoShow', 'Cancelled'];
                const countMap = {
                    'Pending': sum.pending || 0,
                    'Confirmed': sum.confirmed || 0,
                    'InService': sum.inService || 0,
                    'Completed': sum.completed || 0,
                    'NoShow': sum.noShow || 0,
                    'Cancelled': sum.cancelled || 0
                };

                statusCols.forEach(st => {
                    const countEl = document.getElementById(`kanbanCount_${st}`);
                    if (countEl) countEl.innerText = countMap[st];

                    const colEl = document.getElementById(`kanbanCol_${st}`);
                    if (colEl) colEl.innerHTML = '';
                });

                // Render từng thẻ vào cột tương ứng
                list.forEach(a => {
                    const colEl = document.getElementById(`kanbanCol_${a.status}`);
                    if (!colEl) return;

                    const servicesBadges = (a.services || []).map(s =>
                        `<span class="inline-block px-2 py-0.5 rounded-md bg-purple-500/15 text-purple-200 border border-purple-500/20 text-[10px]">${s.name}</span>`
                    ).join(' ');

                    let quickActionBtn = '';
                    if (a.status === 'Pending') {
                        quickActionBtn = `
                            <button type="button" onclick="quickUpdateApptStatus(${a.id}, 'Confirmed')" 
                                class="px-2.5 py-1 rounded-lg bg-cyan-600 hover:bg-cyan-500 text-white font-bold text-[10px] flex items-center gap-1 transition">
                                <i class="fa-solid fa-check"></i> Xác nhận
                            </button>`;
                    } else if (a.status === 'Confirmed') {
                        quickActionBtn = `
                            <button type="button" onclick="quickUpdateApptStatus(${a.id}, 'InService')" 
                                class="px-2.5 py-1 rounded-lg bg-purple-600 hover:bg-purple-500 text-white font-bold text-[10px] flex items-center gap-1 transition">
                                <i class="fa-solid fa-play"></i> Phục vụ
                            </button>`;
                    } else if (a.status === 'InService') {
                        quickActionBtn = `
                            <button type="button" onclick="quickUpdateApptStatus(${a.id}, 'Completed')" 
                                class="px-2.5 py-1 rounded-lg bg-emerald-600 hover:bg-emerald-500 text-white font-bold text-[10px] flex items-center gap-1 transition">
                                <i class="fa-solid fa-check-double"></i> Hoàn tất
                            </button>`;
                    }

                    const cancelBtn = (a.status !== 'Cancelled' && a.status !== 'Completed')
                        ? `<button type="button" onclick="openCancelAppointmentModal(${a.id})" title="Hủy lịch hẹn" 
                               class="w-6 h-6 rounded-lg bg-rose-500/15 hover:bg-rose-600 text-rose-400 hover:text-white flex items-center justify-center transition">
                               <i class="fa-solid fa-xmark text-[10px]"></i>
                           </button>`
                        : '';

                    const cardHtml = `
                        <div draggable="true"
                             ondragstart="handleKanbanDragStart(event, ${a.id}, '${a.status}')"
                             ondragend="handleKanbanDragEnd(event)"
                             class="kanban-card p-3 rounded-xl bg-slate-900/90 hover:bg-slate-800/90 border border-white/10 hover:border-purple-500/40 shadow-lg cursor-grab active:cursor-grabbing transition space-y-2.5 text-xs">
                            
                            <!-- Dòng 1: Mã lịch & Giờ hẹn -->
                            <div class="flex items-center justify-between text-[10px]">
                                <span class="font-bold text-slate-400">#${a.id} • ${a.bookingSource}</span>
                                <span class="px-2 py-0.5 rounded-md bg-white/5 text-amber-300 font-semibold border border-white/10">
                                    <i class="fa-regular fa-clock mr-0.5"></i>${a.startTime} - ${a.endTime}
                                </span>
                            </div>

                            <!-- Dòng 2: Tên khách hàng & SĐT -->
                            <div>
                                <div class="font-bold text-white hover:text-purple-300 cursor-pointer flex items-center justify-between"
                                     onclick="viewCustomerDetail(${a.customerId})">
                                    <span class="truncate">${a.customerName}</span>
                                    <span class="text-[9px] px-1.5 py-0.5 rounded bg-white/10 text-slate-300">${a.appointmentDate.substring(0, 5)}</span>
                                </div>
                                <p class="text-[11px] text-slate-400 mt-0.5">
                                    <i class="fa-solid fa-phone text-[9px] text-purple-400 mr-1"></i>${a.customerPhone}
                                </p>
                            </div>

                            <!-- Dòng 3: Danh sách dịch vụ -->
                            <div class="flex flex-wrap gap-1">
                                ${servicesBadges || '<span class="text-[10px] text-slate-500 italic">Chưa chọn dịch vụ</span>'}
                            </div>

                            <!-- Dòng 4: KTV & Chi phí -->
                            <div class="pt-2 border-t border-white/5 flex items-center justify-between text-[11px]">
                                <span class="text-slate-300 truncate max-w-[110px]" title="KTV: ${a.employeeName}">
                                    <i class="fa-solid fa-user-nurse text-pink-400 mr-1"></i>${a.employeeName}
                                </span>
                                <div class="text-right">
                                    <span class="font-bold text-emerald-400 block">${a.formattedTotal}</span>
                                    ${a.depositAmount > 0 ? `<span class="text-[9px] text-amber-400 block">Cọc: ${a.formattedDeposit}</span>` : ''}
                                </div>
                            </div>

                            ${a.status === 'Cancelled' && a.cancellationReason ? `
                                <div class="p-1.5 rounded-lg bg-rose-950/50 border border-rose-500/20 text-[10px] text-rose-300 italic">
                                    Lý do hủy: "${a.cancellationReason}"
                                </div>
                            ` : ''}

                            <!-- Dòng 5: Nút thao tác nhanh trên thẻ -->
                            <div class="pt-1.5 flex items-center justify-between gap-1">
                                <div class="flex items-center gap-1">
                                    ${quickActionBtn}
                                    <button type="button" onclick="viewAppointmentDetail(${a.id})" title="Xem chi tiết / Đổi lịch"
                                        class="px-2 py-1 rounded-lg bg-white/5 hover:bg-white/15 text-slate-300 text-[10px] font-semibold transition">
                                        Chi tiết
                                    </button>
                                </div>
                                ${cancelBtn}
                            </div>
                        </div>
                    `;
                    colEl.insertAdjacentHTML('beforeend', cardHtml);
                });

                // Hiển thị placeholder nếu cột trống
                statusCols.forEach(st => {
                    const colEl = document.getElementById(`kanbanCol_${st}`);
                    if (colEl && colEl.children.length === 0) {
                        colEl.innerHTML = `
                            <div class="h-32 rounded-xl border border-dashed border-white/10 flex flex-col items-center justify-center text-slate-500 text-[11px] p-3 text-center">
                                <i class="fa-solid fa-arrows-up-down-left-right mb-1 opacity-40"></i>
                                <span>Kéo thả thẻ vào đây</span>
                            </div>
                        `;
                    }
                });
            } catch (err) {
                console.error("Lỗi khi tải bảng Kanban:", err);
            }
        }

        // 3. Xử lý Kéo Thả (HTML5 Drag & Drop) giữa các cột Kanban
        function handleKanbanDragStart(e, appointmentId, currentStatus) {
            draggedApptId = appointmentId;
            draggedFromStatus = currentStatus;
            e.dataTransfer.setData('text/plain', appointmentId);
            e.currentTarget.classList.add('opacity-50', 'scale-95');
        }

        function handleKanbanDragEnd(e) {
            e.currentTarget.classList.remove('opacity-50', 'scale-95');
            document.querySelectorAll('.kanban-column').forEach(col => {
                col.classList.remove('ring-2', 'ring-purple-500', 'bg-purple-900/20');
            });
        }

        function handleKanbanDragOver(e) {
            e.preventDefault();
            e.currentTarget.classList.add('ring-2', 'ring-purple-500', 'bg-purple-900/20');
        }

        function handleKanbanDragLeave(e) {
            e.currentTarget.classList.remove('ring-2', 'ring-purple-500', 'bg-purple-900/20');
        }

        async function handleKanbanDrop(e, targetStatus) {
            e.preventDefault();
            e.currentTarget.classList.remove('ring-2', 'ring-purple-500', 'bg-purple-900/20');

            const apptId = draggedApptId || parseInt(e.dataTransfer.getData('text/plain'));
            if (!apptId || draggedFromStatus === targetStatus) return;

            // Nếu kéo vào cột Đã Hủy -> Mở modal bắt buộc nhập lý do hủy
            if (targetStatus === 'Cancelled') {
                openCancelAppointmentModal(apptId);
                return;
            }

            await quickUpdateApptStatus(apptId, targetStatus);
        }

        // 4. Gọi API Cập nhật trạng thái nhanh (POST /Appointments/UpdateStatus)
        async function quickUpdateApptStatus(appointmentId, newStatus) {
            try {
                const res = await fetch('/Appointments/UpdateStatus', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        appointmentId: appointmentId,
                        newStatus: newStatus
                    })
                });
                const result = await res.json();
                if (result.success) {
                    showToast(result.message, 'Cập nhật lịch hẹn');
                    loadAppointmentsKanban();
                    // Nếu hoàn thành hoặc vắng mặt, cập nhật lại bảng khách hàng để đồng bộ tổng chi tiêu/lượt ghé
                    if (newStatus === 'Completed' || newStatus === 'NoShow') {
                        loadCustomersFromDb();
                    }
                } else {
                    showToast(result.message || 'Không thể cập nhật trạng thái', 'Lỗi');
                }
            } catch (err) {
                console.error("Lỗi khi cập nhật trạng thái:", err);
                showToast('Lỗi kết nối máy chủ khi chuyển trạng thái!', 'Lỗi');
            }
        }

        // 5. Mở Modal Tạo Lịch Hẹn & Xử lý Submit
        async function openBookingModal() {
            await loadAppointmentMetadata();
            const errBox = document.getElementById('bookingFormError');
            if (errBox) errBox.classList.add('hidden');
            openModal('bookingModal');
        }

        async function handleCreateAppointment(e) {
            e.preventDefault();

            const errBox = document.getElementById('bookingFormError');
            const errMsg = document.getElementById('bookingFormErrorMsg');
            const spinner = document.getElementById('saveBookingSpinner');
            const submitBtn = document.getElementById('saveBookingBtn');

            if (errBox) errBox.classList.add('hidden');

            const customerId = parseInt(document.getElementById('appCustomerId').value);
            const empVal = document.getElementById('appEmployeeId').value;
            const employeeId = empVal ? parseInt(empVal) : null;
            const appointmentDate = document.getElementById('appDate').value;
            const startTime = document.getElementById('appStartTime').value;
            const endTime = document.getElementById('appEndTime').value;
            const bookingSource = document.getElementById('appBookingSource').value;
            const depositAmount = parseFloat(document.getElementById('appDepositAmount').value || '0');
            const notes = document.getElementById('appNotes').value.trim();

            const checkedServices = Array.from(document.querySelectorAll('input[name="appServiceCheckbox"]:checked'))
                .map(cb => parseInt(cb.value));

            if (!customerId) {
                if (errMsg) errMsg.innerText = "Vui lòng chọn khách hàng đặt lịch.";
                if (errBox) errBox.classList.remove('hidden');
                return;
            }

            if (checkedServices.length === 0) {
                if (errMsg) errMsg.innerText = "Vui lòng chọn ít nhất 1 dịch vụ cho lịch hẹn.";
                if (errBox) errBox.classList.remove('hidden');
                return;
            }

            spinner?.classList.remove('hidden');
            if (submitBtn) submitBtn.disabled = true;

            try {
                const res = await fetch('/Appointments/Create', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        customerId,
                        employeeId,
                        appointmentDate,
                        startTime,
                        endTime,
                        serviceIds: checkedServices,
                        bookingSource,
                        depositAmount,
                        notes
                    })
                });

                const result = await res.json();
                if (result.success) {
                    closeModal('bookingModal');
                    showToast(result.message, 'Đặt lịch thành công!');
                    document.getElementById('createAppointmentForm')?.reset();
                    loadAppointmentsKanban();
                } else {
                    if (errMsg) errMsg.innerText = result.message || "Không thể tạo lịch hẹn.";
                    if (errBox) errBox.classList.remove('hidden');
                }
            } catch (err) {
                console.error("Lỗi khi tạo lịch hẹn:", err);
                if (errMsg) errMsg.innerText = "Lỗi kết nối máy chủ khi lưu lịch hẹn.";
                if (errBox) errBox.classList.remove('hidden');
            } finally {
                spinner?.classList.add('hidden');
                if (submitBtn) submitBtn.disabled = false;
            }
        }

        // 6. Xem Chi Tiết & Đổi Lịch Hẹn (GET /Appointments/GetDetail & POST /Appointments/Reschedule)
