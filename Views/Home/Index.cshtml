@model CRM_V2.ViewModels.DashboardViewModel
@{
    ViewData["Title"] = "SalonCare CRM - Quản lý thông minh, Chăm sóc tận tâm";
}

<!-- VIEW 1: DASHBOARD / OVERVIEW -->
<div id="dashboardView" class="view-section active-view space-y-6">
    <div class="grid grid-cols-1 xl:grid-cols-4 gap-6">
        <div class="xl:col-span-3 space-y-6">
            <!-- Hero Banner -->
            <div class="rounded-3xl glass-card overflow-hidden border border-purple-500/20 relative p-6 sm:p-8 bg-gradient-to-r from-purple-950/80 via-indigo-950/60 to-slate-950/90 shadow-2xl">
                <div class="absolute top-0 right-1/4 w-96 h-96 bg-purple-600/20 rounded-full blur-3xl pointer-events-none"></div>
                <div class="grid grid-cols-1 md:grid-cols-12 gap-6 items-center relative z-10">
                    <div class="md:col-span-7 space-y-4">
                        <span class="inline-flex items-center space-x-1.5 px-3 py-1 rounded-full text-xs font-medium bg-purple-500/10 text-purple-300 border border-purple-500/20">
                            <i class="fa-solid fa-sparkles text-amber-300 text-[10px]"></i>
                            <span>SalonCare CRM 4.0</span>
                        </span>
                        <h2 class="text-2xl sm:text-3xl font-extrabold text-white leading-tight">
                            Quản lý thông minh<br>
                            <span class="bg-gradient-to-r from-purple-400 via-pink-300 to-indigo-300 bg-clip-text text-transparent">Chăm sóc tận tâm</span>
                        </h2>
                        <p class="text-xs sm:text-sm text-slate-300/80 leading-relaxed">
                            Hệ thống giúp bạn theo dõi doanh thu, vận hành đặt lịch và duy trì mối quan hệ thân thiết với từng khách hàng.
                        </p>
                        <div class="pt-2">
                            <button onclick="switchView('appointmentsView')" class="bg-gradient-to-r from-purple-600 via-indigo-600 to-pink-600 hover:from-purple-500 hover:to-pink-500 text-white font-semibold px-5 py-2.5 rounded-xl text-xs shadow-lg shadow-purple-600/30 flex items-center space-x-2 transition group">
                                <span>Xem lịch hôm nay</span>
                                <i class="fa-solid fa-arrow-right text-xs group-hover:translate-x-1 transition"></i>
                            </button>
                        </div>
                    </div>
                    <div class="md:col-span-5 flex flex-col items-center justify-center">
                        <div class="w-32 h-32 relative flex items-center justify-center mb-3">
                            <svg class="w-full h-full glow-effect text-purple-400" viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <path d="M50 15C55 30 70 35 70 50C70 65 55 85 50 85C45 85 30 65 30 50C30 35 45 15 50 15Z" fill="url(#heroLotus1)" fill-opacity="0.8"/>
                                <path d="M50 25C62 38 78 45 75 58C72 71 58 78 50 78C42 78 28 71 25 58C22 45 38 38 50 25Z" fill="url(#heroLotus2)" fill-opacity="0.7"/>
                                <defs>
                                    <linearGradient id="heroLotus1" x1="50" y1="15" x2="50" y2="85" gradientUnits="userSpaceOnUse"><stop stop-color="#A855F7"/><stop offset="1" stop-color="#EC4899"/></linearGradient>
                                    <linearGradient id="heroLotus2" x1="25" y1="25" x2="75" y2="78" gradientUnits="userSpaceOnUse"><stop stop-color="#3B82F6"/><stop offset="1" stop-color="#8B5CF6"/></linearGradient>
                                </defs>
                            </svg>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Key Metrics -->
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
                <div class="glass-card glass-card-hover rounded-2xl p-4 border border-white/10 transition-all">
                    <div class="flex justify-between items-start mb-2">
                        <span class="text-xs font-medium text-slate-400">Tổng khách hàng</span>
                        <div class="w-8 h-8 rounded-xl bg-blue-500/20 text-blue-400 flex items-center justify-center">
                            <i class="fa-solid fa-users text-sm"></i>
                        </div>
                    </div>
                    <p class="text-2xl font-bold text-white mb-1" id="dashTotalCustomers">@Model.TotalCustomers.ToString("N0")</p>
                    <p class="text-[11px] text-emerald-400 flex items-center gap-1" id="dashCustomerGrowth">
                        <i class="fa-solid fa-arrow-trend-up"></i>
                        <span>↑ @Model.CustomerGrowthPercentage% tháng trước</span>
                    </p>
                </div>
                <div class="glass-card glass-card-hover rounded-2xl p-4 border border-white/10 transition-all">
                    <div class="flex justify-between items-start mb-2">
                        <span class="text-xs font-medium text-slate-400">Lịch hẹn hôm nay</span>
                        <div class="w-8 h-8 rounded-xl bg-purple-500/20 text-purple-400 flex items-center justify-center">
                            <i class="fa-solid fa-calendar-check text-sm"></i>
                        </div>
                    </div>
                    <p class="text-2xl font-bold text-white mb-1" id="dashTodayAppts">@Model.TodayAppointments</p>
                    <p class="text-[11px] text-emerald-400 flex items-center gap-1" id="dashApptGrowth">
                        <i class="fa-solid fa-arrow-trend-up"></i>
                        <span>↑ @Model.AppointmentGrowthPercentage% hôm qua</span>
                    </p>
                </div>
                <div class="glass-card glass-card-hover rounded-2xl p-4 border border-white/10 transition-all">
                    <div class="flex justify-between items-start mb-2">
                        <span class="text-xs font-medium text-slate-400">Doanh thu tháng này</span>
                        <div class="w-8 h-8 rounded-xl bg-amber-500/20 text-amber-400 flex items-center justify-center">
                            <i class="fa-solid fa-wallet text-sm"></i>
                        </div>
                    </div>
                    <p class="text-2xl font-bold text-white mb-1" id="dashMonthRevenue">@Model.MonthlyRevenue.ToString("N0")đ</p>
                    <p class="text-[11px] text-emerald-400 flex items-center gap-1" id="dashRevenueGrowth">
                        <i class="fa-solid fa-arrow-trend-up"></i>
                        <span>↑ @Model.RevenueGrowthPercentage% tháng trước</span>
                    </p>
                </div>
                <div class="glass-card glass-card-hover rounded-2xl p-4 border border-white/10 transition-all">
                    <div class="flex justify-between items-start mb-2">
                        <span class="text-xs font-medium text-slate-400">Tỷ lệ quay lại</span>
                        <div class="w-8 h-8 rounded-xl bg-pink-500/20 text-pink-400 flex items-center justify-center">
                            <i class="fa-solid fa-rotate-right text-sm"></i>
                        </div>
                    </div>
                    <p class="text-2xl font-bold text-white mb-1" id="dashReturnRate">@Model.RetentionRate%</p>
                    <p class="text-[11px] text-emerald-400 flex items-center gap-1" id="dashReturnRateGrowth">
                        <i class="fa-solid fa-arrow-trend-up"></i>
                        <span>↑ @Model.RetentionGrowthPercentage% tháng trước</span>
                    </p>
                </div>
            </div>

            <!-- Charts Row -->
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
                <!-- 1. Doanh thu 6 tháng gần nhất -->
                <div class="lg:col-span-7 glass-card rounded-2xl p-5 border border-white/10">
                    <div class="flex items-center justify-between mb-4">
                        <div>
                            <h3 class="text-sm font-bold text-white flex items-center gap-2">
                                <i class="fa-solid fa-chart-line text-purple-400"></i>
                                <span>Doanh thu 6 tháng gần nhất</span>
                            </h3>
                            <p class="text-[11px] text-slate-400">Xu hướng doanh thu thực tế từ lịch hẹn hoàn thành</p>
                        </div>
                        <span class="text-[10px] px-2 py-0.5 rounded-full bg-purple-500/20 text-purple-300 border border-purple-500/30">
                            Đơn vị: Triệu VNĐ
                        </span>
                    </div>
                    <div class="h-60 w-full relative">
                        <canvas id="revenueChart"></canvas>
                    </div>
                </div>

                <!-- 2. Dịch vụ được yêu thích tháng này -->
                <div class="lg:col-span-5 glass-card rounded-2xl p-5 border border-white/10 flex flex-col justify-between">
                    <div class="flex items-center justify-between mb-4">
                        <h3 class="text-sm font-bold text-white flex items-center gap-2">
                            <i class="fa-solid fa-award text-amber-400"></i>
                            <span>Dịch vụ được yêu thích</span>
                        </h3>
                        <span class="text-[10px] text-slate-400">Theo lượt đặt</span>
                    </div>
                    <div id="dashboardTopServices" class="space-y-4">
                        <!-- Dynamic rendered list with progress bars -->
                        <div class="text-center py-8 text-slate-400 text-xs">
                            <i class="fa-solid fa-circle-notch fa-spin text-purple-400 text-base mb-1 block"></i>
                            <span>Đang tải dịch vụ...</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Right Sidebar Column -->
        <div class="space-y-6">
            <!-- Widget Lịch Làm Việc Thực Tế (Calendar Widget) -->
            <div class="glass-card rounded-2xl p-5 border border-white/10">
                <div class="flex items-center justify-between mb-3">
                    <h3 class="text-sm font-bold text-white flex items-center gap-2">
                        <i class="fa-regular fa-calendar text-purple-400"></i>
                        <span>Lịch làm việc</span>
                    </h3>
                    <div class="flex items-center space-x-1">
                        <button type="button" onclick="prevCalMonth()" class="w-6 h-6 rounded-lg bg-white/5 hover:bg-white/10 text-slate-300 flex items-center justify-center text-xs transition" title="Tháng trước">
                            <i class="fa-solid fa-chevron-left text-[10px]"></i>
                        </button>
                        <span id="dashCalMonthYear" class="text-xs font-semibold text-purple-300 px-1.5 min-w-[90px] text-center">Tháng 10/2026</span>
                        <button type="button" onclick="nextCalMonth()" class="w-6 h-6 rounded-lg bg-white/5 hover:bg-white/10 text-slate-300 flex items-center justify-center text-xs transition" title="Tháng sau">
                            <i class="fa-solid fa-chevron-right text-[10px]"></i>
                        </button>
                        <button type="button" onclick="resetCalToday()" class="ml-1 px-1.5 py-0.5 rounded-lg text-[10px] bg-purple-600/30 hover:bg-purple-600/50 text-purple-300 border border-purple-500/30 transition">
                            Hôm nay
                        </button>
                    </div>
                </div>

                <!-- Thứ trong tuần (T2 - CN) -->
                <div class="grid grid-cols-7 gap-1 text-center text-[10px] text-slate-400 font-semibold mb-2">
                    <div>T2</div><div>T3</div><div>T4</div><div>T5</div><div>T6</div><div>T7</div><div>CN</div>
                </div>

                <!-- Lưới ngày trong tháng -->
                <div id="dashCalDaysGrid" class="grid grid-cols-7 gap-1 text-center text-xs min-h-[170px]">
                    <!-- Dynamic rendering -->
                </div>

                <!-- Chi tiết lịch hẹn ngày được chọn -->
                <div id="dashSelectedDayBox" class="mt-4 pt-3 border-t border-white/10">
                    <div class="flex items-center justify-between mb-2">
                        <span id="dashSelectedDayTitle" class="text-xs font-bold text-white">Lịch hôm nay</span>
                        <button type="button" onclick="switchView('appointmentsView')" class="text-[10px] text-purple-400 hover:text-purple-300 transition flex items-center gap-1">
                            <span>Quản lý lịch</span>
                            <i class="fa-solid fa-arrow-right text-[9px]"></i>
                        </button>
                    </div>
                    <div id="dashSelectedDayAppts" class="space-y-1.5 max-h-44 overflow-y-auto custom-scrollbar text-xs">
                        <!-- Dynamic appointment items for selected day -->
                    </div>
                </div>
            </div>

            <!-- Widget Hoạt Động Mới Nhất (Real-time Audit Log) -->
            <div class="glass-card rounded-2xl p-5 border border-white/10">
                <div class="flex items-center justify-between mb-3">
                    <h3 class="text-sm font-bold text-white flex items-center gap-2">
                        <i class="fa-solid fa-bolt text-amber-400"></i>
                        <span>Hoạt động mới nhất</span>
                    </h3>
                    <span class="flex items-center gap-1.5 text-[10px] text-emerald-400 bg-emerald-500/10 px-2 py-0.5 rounded-full border border-emerald-500/20">
                        <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
                        <span>Trực tiếp</span>
                    </span>
                </div>
                <div id="dashboardRecentActivities" class="space-y-3 text-xs max-h-[300px] overflow-y-auto custom-scrollbar pr-1">
                    <div class="text-center py-6 text-slate-400">
                        <i class="fa-solid fa-circle-notch fa-spin text-purple-400 text-sm mb-1 block"></i>
                        <span>Đang tải hoạt động...</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- VIEW 2: CUSTOMER MANAGEMENT -->
<div id="customersView" class="view-section space-y-6">
    <!-- Top Action Controls -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 glass-card p-4 rounded-2xl border border-white/10">
        <!-- Filter Tabs -->
        <div class="flex flex-wrap items-center gap-2" id="customerFilterButtons">
            <button id="filterAllBtn" onclick="filterCustomers('ALL')" class="cust-filter-btn px-4 py-2 rounded-xl text-xs font-semibold bg-purple-600 text-white shadow-lg shadow-purple-600/30 transition">
                Tất cả (<span id="countAll">0</span>)
            </button>
            <button id="filterVipBtn" onclick="filterCustomers('VIP')" class="cust-filter-btn px-4 py-2 rounded-xl text-xs font-semibold bg-white/5 hover:bg-white/10 text-slate-300 transition">
                VIP (<span id="countVip">0</span>)
            </button>
            <button id="filterLoyalBtn" onclick="filterCustomers('Than_thiet')" class="cust-filter-btn px-4 py-2 rounded-xl text-xs font-semibold bg-white/5 hover:bg-white/10 text-slate-300 transition">
                Thân thiết (<span id="countLoyal">0</span>)
            </button>
            <button id="filterNewBtn" onclick="filterCustomers('Moi')" class="cust-filter-btn px-4 py-2 rounded-xl text-xs font-semibold bg-white/5 hover:bg-white/10 text-slate-300 transition">
                Khách mới (<span id="countNew">0</span>)
            </button>
        </div>

        <!-- Search & Add Actions -->
        <div class="flex items-center space-x-3">
            <div class="relative">
                <i class="fa-solid fa-search absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 text-xs"></i>
                <input type="text" id="custSearchInput" oninput="searchCustomers()" placeholder="Tìm theo tên/SĐT..." 
                    class="pl-9 pr-4 py-2 glass-input rounded-xl text-xs text-white w-48 sm:w-64 focus:border-purple-500 transition-all">
            </div>
            <button onclick="openAddCustomerModal()" class="bg-gradient-to-r from-purple-600 to-indigo-600 hover:from-purple-500 hover:to-indigo-500 text-white px-4 py-2 rounded-xl text-xs font-semibold flex items-center space-x-2 shadow-lg shadow-purple-600/30 transition">
                <i class="fa-solid fa-user-plus text-xs"></i>
                <span>Thêm khách mới</span>
            </button>
        </div>
    </div>

    <!-- Customer Table -->
    <div class="glass-card rounded-2xl border border-white/10 overflow-hidden shadow-2xl">
        <div class="overflow-x-auto">
            <table class="w-full text-left text-xs">
                <thead>
                    <tr class="text-slate-400 border-b border-white/10 bg-white/5">
                        <th class="p-4 font-semibold">Khách hàng</th>
                        <th class="p-4 font-semibold">Số điện thoại</th>
                        <th class="p-4 font-semibold">Lần cuối ghé</th>
                        <th class="p-4 font-semibold">Số lượt ghé</th>
                        <th class="p-4 font-semibold">Tổng chi tiêu</th>
                        <th class="p-4 font-semibold">Hạng khách</th>
                        <th class="p-4 font-semibold text-right">Thao tác</th>
                    </tr>
                </thead>
                <tbody id="customerTableBody" class="divide-y divide-white/5">
                    <!-- Dynamic Loading State -->
                    <tr>
                        <td colspan="7" class="p-8 text-center text-slate-400">
                            <i class="fa-solid fa-circle-notch fa-spin text-purple-400 text-lg mr-2"></i>
                            Đang tải danh sách khách hàng từ CSDL...
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- VIEW 3: APPOINTMENT MANAGEMENT (KANBAN & MULTI-FILTER) -->
<div id="appointmentsView" class="view-section space-y-5">
    <!-- Top Header & Action Buttons -->
    <div class="glass-card p-5 rounded-2xl border border-white/10 flex flex-col lg:flex-row lg:items-center lg:justify-between gap-4">
        <div>
            <div class="flex items-center space-x-3">
                <h3 class="text-base font-bold text-white flex items-center gap-2">
                    <i class="fa-solid fa-calendar-days text-purple-400"></i>
                    <span>Bảng Điều Phối Lịch Hẹn (Kanban Drag & Drop)</span>
                </h3>
                <span id="apptTotalBadge" class="px-2.5 py-0.5 rounded-full text-[11px] font-bold bg-purple-500/20 text-purple-300 border border-purple-500/30">
                    0 lịch hẹn
                </span>
            </div>
            <p class="text-xs text-slate-400 mt-1">Kéo và thả thẻ lịch hẹn giữa các cột để cập nhật trạng thái thời gian thực vào SQL Server.</p>
        </div>

        <div class="flex flex-wrap items-center gap-2.5">
            <button type="button" onclick="exportAppointmentsCsv()" 
                class="px-3.5 py-2 rounded-xl bg-white/10 hover:bg-white/20 text-slate-200 text-xs font-semibold flex items-center space-x-2 border border-white/10 transition">
                <i class="fa-solid fa-file-export text-emerald-400"></i>
                <span>Xuất dữ liệu (Excel/CSV)</span>
            </button>
            <button type="button" onclick="openBookingModal()" 
                class="bg-gradient-to-r from-purple-600 via-indigo-600 to-pink-600 hover:opacity-90 text-white px-4 py-2 rounded-xl text-xs font-bold flex items-center space-x-2 shadow-lg shadow-purple-600/30 transition">
                <i class="fa-solid fa-plus"></i>
                <span>Tạo lịch hẹn mới</span>
            </button>
        </div>
    </div>

    <!-- Thanh công cụ Bộ lọc đa năng (Filter Bar) -->
    <div class="glass-card p-4 rounded-2xl border border-white/10 space-y-3">
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-6 gap-3 text-xs">
            <!-- 1. Tìm kiếm Tên/SĐT khách hàng -->
            <div class="lg:col-span-2 relative">
                <i class="fa-solid fa-magnifying-glass absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400"></i>
                <input type="text" id="apptSearchInput" oninput="debounceLoadAppointments()" 
                    placeholder="Tìm tên khách hàng hoặc số điện thoại..." 
                    class="w-full glass-input rounded-xl pl-9 pr-3.5 py-2 text-white placeholder-slate-500" />
            </div>

            <!-- 2. Lọc Khoảng Ngày -->
            <div>
                <select id="apptDateFilter" onchange="handleDateFilterChange()" class="w-full glass-input rounded-xl px-3 py-2 text-white bg-slate-900 border-white/10">
                    <option value="all" selected>📅 Tất cả các ngày</option>
                    <option value="today">Hôm nay (@DateTime.Now.ToString("dd/MM"))</option>
                    <option value="tomorrow">Ngày mai (@DateTime.Now.AddDays(1).ToString("dd/MM"))</option>
                    <option value="this_week">Trong tuần này</option>
                    <option value="custom">Tùy chọn khoảng ngày...</option>
                </select>
            </div>

            <!-- 3. Lọc Trạng thái -->
            <div>
                <select id="apptStatusFilter" onchange="loadAppointmentsKanban()" class="w-full glass-input rounded-xl px-3 py-2 text-white bg-slate-900 border-white/10">
                    <option value="ALL">⚡ Tất cả trạng thái</option>
                    <option value="Pending">Chờ xác nhận</option>
                    <option value="Confirmed">Đã xác nhận</option>
                    <option value="InService">Đang phục vụ</option>
                    <option value="Completed">Hoàn thành</option>
                    <option value="NoShow">Khách vắng mặt</option>
                    <option value="Cancelled">Đã hủy</option>
                </select>
            </div>

            <!-- 4. Lọc Nhân viên KTV -->
            <div>
                <select id="apptEmployeeFilter" onchange="loadAppointmentsKanban()" class="w-full glass-input rounded-xl px-3 py-2 text-white bg-slate-900 border-white/10">
                    <option value="">👩‍⚕️ Tất cả KTV</option>
                </select>
            </div>

            <!-- 5. Lọc Dịch vụ & Nút Reset -->
            <div class="flex items-center space-x-2">
                <select id="apptServiceFilter" onchange="loadAppointmentsKanban()" class="w-full glass-input rounded-xl px-3 py-2 text-white bg-slate-900 border-white/10">
                    <option value="">💆‍♀️ Tất cả dịch vụ</option>
                </select>
                <button type="button" onclick="resetAppointmentFilters()" title="Xóa bộ lọc" 
                    class="px-3 py-2 rounded-xl bg-white/5 hover:bg-white/15 text-slate-300 border border-white/10 shrink-0 transition">
                    <i class="fa-solid fa-rotate-right"></i>
                </button>
            </div>
        </div>

        <!-- Khung chọn Từ ngày - Đến ngày (Hiện khi chọn Tùy chọn khoảng ngày) -->
        <div id="apptCustomDateRange" class="hidden pt-2 border-t border-white/10 flex flex-wrap items-center gap-3 text-xs">
            <div class="flex items-center space-x-2">
                <span class="text-slate-400">Từ ngày:</span>
                <input type="date" id="apptFromDate" onchange="loadAppointmentsKanban()" class="glass-input rounded-xl px-3 py-1.5 text-white bg-slate-900" />
            </div>
            <div class="flex items-center space-x-2">
                <span class="text-slate-400">Đến ngày:</span>
                <input type="date" id="apptToDate" onchange="loadAppointmentsKanban()" class="glass-input rounded-xl px-3 py-1.5 text-white bg-slate-900" />
            </div>
        </div>
    </div>

    <!-- BẢNG KANBAN TƯƠNG TÁC KÉO THẢ (6 CỘT TRẠNG THÁI) -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-6 gap-4 items-start">
        
        <!-- Cột 1: Pending (Chờ xác nhận) -->
        <div class="kanban-column glass-card rounded-2xl p-3.5 border border-amber-500/20 flex flex-col min-h-[420px] transition-all"
             data-status="Pending"
             ondragover="handleKanbanDragOver(event)"
             ondragleave="handleKanbanDragLeave(event)"
             ondrop="handleKanbanDrop(event, 'Pending')">
            <div class="flex justify-between items-center border-b border-white/10 pb-2.5 mb-3">
                <span class="text-xs font-bold text-amber-400 flex items-center gap-1.5">
                    <span class="w-2 h-2 rounded-full bg-amber-400 animate-pulse"></span>
                    Chờ xác nhận
                </span>
                <span id="kanbanCount_Pending" class="px-2 py-0.5 rounded-lg text-[10px] font-bold bg-amber-500/20 text-amber-300">0</span>
            </div>
            <div id="kanbanCol_Pending" class="space-y-3 flex-1"></div>
        </div>

        <!-- Cột 2: Confirmed (Đã xác nhận) -->
        <div class="kanban-column glass-card rounded-2xl p-3.5 border border-cyan-500/20 flex flex-col min-h-[420px] transition-all"
             data-status="Confirmed"
             ondragover="handleKanbanDragOver(event)"
             ondragleave="handleKanbanDragLeave(event)"
             ondrop="handleKanbanDrop(event, 'Confirmed')">
            <div class="flex justify-between items-center border-b border-white/10 pb-2.5 mb-3">
                <span class="text-xs font-bold text-cyan-400 flex items-center gap-1.5">
                    <i class="fa-solid fa-calendar-check"></i>
                    Đã xác nhận
                </span>
                <span id="kanbanCount_Confirmed" class="px-2 py-0.5 rounded-lg text-[10px] font-bold bg-cyan-500/20 text-cyan-300">0</span>
            </div>
            <div id="kanbanCol_Confirmed" class="space-y-3 flex-1"></div>
        </div>

        <!-- Cột 3: InService (Đang phục vụ) -->
        <div class="kanban-column glass-card rounded-2xl p-3.5 border border-purple-500/30 flex flex-col min-h-[420px] transition-all"
             data-status="InService"
             ondragover="handleKanbanDragOver(event)"
             ondragleave="handleKanbanDragLeave(event)"
             ondrop="handleKanbanDrop(event, 'InService')">
            <div class="flex justify-between items-center border-b border-white/10 pb-2.5 mb-3">
                <span class="text-xs font-bold text-purple-400 flex items-center gap-1.5">
                    <i class="fa-solid fa-spa fa-spin" style="animation-duration: 6s;"></i>
                    Đang phục vụ
                </span>
                <span id="kanbanCount_InService" class="px-2 py-0.5 rounded-lg text-[10px] font-bold bg-purple-500/20 text-purple-300">0</span>
            </div>
            <div id="kanbanCol_InService" class="space-y-3 flex-1"></div>
        </div>

        <!-- Cột 4: Completed (Hoàn thành) -->
        <div class="kanban-column glass-card rounded-2xl p-3.5 border border-emerald-500/20 flex flex-col min-h-[420px] transition-all"
             data-status="Completed"
             ondragover="handleKanbanDragOver(event)"
             ondragleave="handleKanbanDragLeave(event)"
             ondrop="handleKanbanDrop(event, 'Completed')">
            <div class="flex justify-between items-center border-b border-white/10 pb-2.5 mb-3">
                <span class="text-xs font-bold text-emerald-400 flex items-center gap-1.5">
                    <i class="fa-solid fa-check-double"></i>
                    Hoàn thành
                </span>
                <span id="kanbanCount_Completed" class="px-2 py-0.5 rounded-lg text-[10px] font-bold bg-emerald-500/20 text-emerald-300">0</span>
            </div>
            <div id="kanbanCol_Completed" class="space-y-3 flex-1"></div>
        </div>

        <!-- Cột 5: NoShow (Khách vắng mặt) -->
        <div class="kanban-column glass-card rounded-2xl p-3.5 border border-orange-500/20 flex flex-col min-h-[420px] transition-all"
             data-status="NoShow"
             ondragover="handleKanbanDragOver(event)"
             ondragleave="handleKanbanDragLeave(event)"
             ondrop="handleKanbanDrop(event, 'NoShow')">
            <div class="flex justify-between items-center border-b border-white/10 pb-2.5 mb-3">
                <span class="text-xs font-bold text-orange-400 flex items-center gap-1.5">
                    <i class="fa-solid fa-user-slash"></i>
                    Vắng mặt
                </span>
                <span id="kanbanCount_NoShow" class="px-2 py-0.5 rounded-lg text-[10px] font-bold bg-orange-500/20 text-orange-300">0</span>
            </div>
            <div id="kanbanCol_NoShow" class="space-y-3 flex-1"></div>
        </div>

        <!-- Cột 6: Cancelled (Đã hủy) -->
        <div class="kanban-column glass-card rounded-2xl p-3.5 border border-rose-500/20 flex flex-col min-h-[420px] transition-all"
             data-status="Cancelled"
             ondragover="handleKanbanDragOver(event)"
             ondragleave="handleKanbanDragLeave(event)"
             ondrop="handleKanbanDrop(event, 'Cancelled')">
            <div class="flex justify-between items-center border-b border-white/10 pb-2.5 mb-3">
                <span class="text-xs font-bold text-rose-400 flex items-center gap-1.5">
                    <i class="fa-solid fa-ban"></i>
                    Đã hủy
                </span>
                <span id="kanbanCount_Cancelled" class="px-2 py-0.5 rounded-lg text-[10px] font-bold bg-rose-500/20 text-rose-300">0</span>
            </div>
            <div id="kanbanCol_Cancelled" class="space-y-3 flex-1"></div>
        </div>

    </div>
</div>

