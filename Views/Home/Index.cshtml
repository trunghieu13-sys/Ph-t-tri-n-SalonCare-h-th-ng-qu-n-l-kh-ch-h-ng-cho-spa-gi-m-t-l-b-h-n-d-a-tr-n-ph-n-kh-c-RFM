                if (result.success) {
                    showToast(result.message, 'success');
                    fetchStaffList();
                } else {
                    showToast(result.message || 'Không thể thay đổi trạng thái tài khoản.', 'error');
                }
            } catch (err) {
                console.error("Lỗi khi đổi trạng thái nhân viên:", err);
                showToast("Lỗi kết nối máy chủ.", "error");
            }
        }

        async function deleteStaff(userId, fullName) {
            if (!confirm(`Bạn có chắc chắn muốn chuyển nhân viên "${fullName}" sang trạng thái "Đã nghỉ việc"?\n(Tài khoản sẽ bị vô hiệu hóa nhưng vẫn bảo toàn lịch sử doanh thu và lịch hẹn).`)) {
                return;
            }

            try {
                const res = await fetch(`/Staff/Delete/${userId}`, { method: 'POST' });
                const result = await res.json();

                if (result.success) {
                    showToast(result.message, 'success');
                    fetchStaffList();
                } else {
                    showToast(result.message || 'Không thể xóa nhân viên.', 'error');
                }
            } catch (err) {
                console.error("Lỗi khi xóa nhân viên:", err);
                showToast("Lỗi kết nối máy chủ.", "error");
