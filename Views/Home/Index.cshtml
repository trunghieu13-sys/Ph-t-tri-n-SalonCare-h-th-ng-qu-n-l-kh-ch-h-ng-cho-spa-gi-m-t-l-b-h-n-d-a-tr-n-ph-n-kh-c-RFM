                                        <i class="fa-solid fa-ban mr-1"></i>Hủy lịch
                                    </button>
                                ` : ''}
                                <button type="button" onclick="hideAppointmentFromBoard(${a.id})"
                                    title="Chỉ xóa hiển thị khỏi bảng Kanban, giữ nguyên dữ liệu trong SQL Server"
                                    class="px-3 py-2 rounded-xl bg-slate-700/60 hover:bg-rose-600/80 text-slate-200 hover:text-white border border-white/10 font-semibold transition flex items-center gap-1.5">
                                    <i class="fa-solid fa-eye-slash"></i> Xóa hiển thị dịch vụ khỏi bảng
                                </button>
                            </div>
                            <button type="submit" class="px-5 py-2 rounded-xl bg-gradient-to-r from-purple-600 to-indigo-600 hover:from-purple-500 text-white font-bold shadow-lg shadow-purple-600/30">
