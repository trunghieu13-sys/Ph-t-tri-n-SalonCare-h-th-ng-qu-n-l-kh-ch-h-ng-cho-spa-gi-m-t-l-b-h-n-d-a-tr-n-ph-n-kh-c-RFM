        async function handleSaveSpecialty(e) {
            e.preventDefault();

            const userId = parseInt(document.getElementById('editSpecialtyUserId')?.value || '0');
            const specialty = document.getElementById('editSpecialtyInput')?.value.trim();
            const errBox = document.getElementById('editSpecialtyError');
            const btn = document.getElementById('btnSaveSpecialty');

            if (userId <= 0) {
                if (errBox) {
                    errBox.classList.remove('hidden');
