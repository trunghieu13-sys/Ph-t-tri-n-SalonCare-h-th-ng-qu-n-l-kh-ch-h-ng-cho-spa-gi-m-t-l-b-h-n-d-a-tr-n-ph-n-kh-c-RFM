        function renderCustomerInteractions(interactions) {
            const tbody = document.getElementById('customerInteractionsBody');
            if (!tbody) return;

            if (!interactions || !interactions.length) {
                tbody.innerHTML = `
                    <tr>
                        <td colspan="6" class="py-6 text-center text-slate-500">Chưa có nhật ký gửi Email/SMS nào trong hệ thống.</td>
                    </tr>
                `;
                return;
            }

            tbody.innerHTML = interactions.map(item => {
                const isEmail = (item.channel || '').toUpperCase() === 'EMAIL';
                const channelBadge = isEmail
                    ? '<span class="px-2 py-0.5 rounded bg-blue-500/20 text-blue-400 font-semibold text-[10px]"><i class="fa-solid fa-envelope mr-1"></i>EMAIL</span>'
                    : '<span class="px-2 py-0.5 rounded bg-purple-500/20 text-purple-400 font-semibold text-[10px]"><i class="fa-solid fa-comment-sms mr-1"></i>SMS</span>';

                const isSuccess = (item.status || '').toUpperCase() === 'SUCCESS';
                const statusBadge = isSuccess
                    ? '<span class="px-2 py-0.5 rounded bg-emerald-500/20 text-emerald-400 font-semibold text-[10px]">SUCCESS</span>'
                    : `<span class="px-2 py-0.5 rounded bg-rose-500/20 text-rose-400 font-semibold text-[10px]" title="${escapeHtml(item.errorMessage || '')}">FAILED</span>`;

                const cleanContent = (item.content || '').replace(/<[^>]*>?/gm, '');
                const errorHtml = (!isSuccess && item.errorMessage)
                    ? `<div class="text-[10px] text-rose-400 mt-0.5"><i class="fa-solid fa-circle-exclamation mr-1"></i>${escapeHtml(item.errorMessage)}</div>`
                    : '';

                return `
                    <tr class="hover:bg-white/5 transition-colors">
                        <td class="py-2.5 px-3 font-semibold text-white">${escapeHtml(item.customerName)}</td>
                        <td class="py-2.5 px-3">${channelBadge}</td>
                        <td class="py-2.5 px-3 font-mono text-[11px] text-slate-300">${escapeHtml(item.recipient)}</td>
                        <td class="py-2.5 px-3 max-w-xs text-slate-400">
                            <div class="truncate" title="${escapeHtml(cleanContent)}">${escapeHtml(cleanContent)}</div>
                            ${errorHtml}
                        </td>
                        <td class="py-2.5 px-3">${statusBadge}</td>
                        <td class="py-2.5 px-3 text-right text-slate-400 whitespace-nowrap">${escapeHtml(item.sentAt)}</td>
                    </tr>
                `;
            }).join('');
        }

        function insertCampaignToken(token) {
            const textarea = document.getElementById('campaignMessage');
            if (!textarea) return;
            const start = textarea.selectionStart || textarea.value.length;
            const end = textarea.selectionEnd || textarea.value.length;
            const text = textarea.value;
            textarea.value = text.substring(0, start) + token + text.substring(end);
            textarea.focus();
            textarea.selectionStart = textarea.selectionEnd = start + token.length;
        }

        function escapeHtml(str) {
            if (!str) return '';
            return String(str)
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;')
                .replace(/'/g, '&#039;');
        }

        // =========================================================================
        // DOM INITIALIZATION & CHARTS
        // =========================================================================
        document.addEventListener('DOMContentLoaded', () => {
            // Register Nav Handlers
            document.querySelectorAll('#navContainer button').forEach(btn => {
                btn.addEventListener('click', () => switchView(btn.getAttribute('data-view')));
            });

            // Toggle Sidebar
            const sidebar = document.getElementById('sidebar');
            const toggleBtn = document.getElementById('toggleSidebarBtn');
            const backdrop = document.getElementById('mobileBackdrop');

            if (toggleBtn) {
                toggleBtn.addEventListener('click', () => {
                    if (window.innerWidth < 1024) {
                        sidebar.classList.toggle('-translate-x-full');
                        backdrop.classList.toggle('hidden');
                    } else {
                        sidebar.classList.toggle('sidebar-collapsed');
                    }
                });
            }

            if (backdrop) {
                backdrop.addEventListener('click', () => {
                    sidebar.classList.add('-translate-x-full');
                    backdrop.classList.add('hidden');
                });
            }

            // Quick Booking button in Header
            document.getElementById('quickBookingBtn')?.addEventListener('click', openBookingModal);

            // Campaign Broadcast form submission (Connects directly to POST /CustomerCare/SendCampaign)
            const campaignForm = document.getElementById('quickCampaignForm');
            if (campaignForm) {
                campaignForm.addEventListener('submit', async function(e) {
                    e.preventDefault();
                    const channel = document.getElementById('campaignChannel').value;
                    const group = document.getElementById('campaignGroup').value;
                    const message = document.getElementById('campaignMessage').value.trim();
                    const submitBtn = document.getElementById('campaignSubmitBtn');

                    if (!message) {
                        showToast('Vui lòng nhập nội dung tin nhắn chiến dịch!');
                        return;
                    }

                    const originalBtnHtml = submitBtn.innerHTML;
                    submitBtn.disabled = true;
                    submitBtn.classList.add('opacity-75', 'cursor-not-allowed');
                    submitBtn.innerHTML = '<i class="fa-solid fa-circle-notch fa-spin"></i> <span>Đang gửi tin hàng loạt...</span>';

                    try {
                        const res = await fetch('/CustomerCare/SendCampaign', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({
                                channel: channel,
                                targetGroup: group,
                                messageContent: message
                            })
                        });
                        const result = await res.json();

                        if (result.success) {
                            showToast(result.message, 'Đã gửi chiến dịch');
                            document.getElementById('campaignMessage').value = '';
                            await loadCustomerCareDashboard();
                        } else {
                            showToast(result.message || 'Gửi chiến dịch thất bại!', 'Chưa gửi được');
                            await loadCustomerCareDashboard();
                            if (result.needConfig) {
                                openGatewayConfigModal();
                            }
                        }
                    } catch (err) {
                        showToast('Lỗi kết nối máy chủ khi phát động chiến dịch!');
                    } finally {
                        submitBtn.disabled = false;
                        submitBtn.classList.remove('opacity-75', 'cursor-not-allowed');
                        submitBtn.innerHTML = originalBtnHtml;
                    }
                });
            }

            // Tải dữ liệu THẬT từ CSDL SQL Server ngay khi mở ứng dụng
            loadCustomersFromDb();
            loadAppointmentMetadata();
            loadAppointmentsKanban();
            loadServicesToDropdown();
            loadCustomerCareDashboard();
            fetchStaffList();
            loadReportsDashboard();
            loadDashboardOverview();
        });

        // =========================================================================
        // PHÂN HỆ: TRANG TỔNG QUAN (DASHBOARD ANALYTICS, CALENDAR & REAL-TIME AUDIT)
        // =========================================================================
        let dashRevenueChartInstance = null;
        let calCurrentYear = new Date().getFullYear();
        let calCurrentMonth = new Date().getMonth() + 1; // 1-12
        let calSelectedDate = null; // 'yyyy-MM-dd'
        let calAppointmentsMap = {}; // 'yyyy-MM-dd' => count

        async function loadDashboardOverview(targetDateStr) {
            try {
                let url = '/Dashboard/GetSummaryData';
                if (targetDateStr) {
                    url += `?date=${encodeURIComponent(targetDateStr)}`;
                }

                const response = await fetch(url);
                const res = await response.json();
                if (!res.success) {
                    console.error("Lỗi tải Dashboard:", res.message);
                    return;
                }

                // 1. Cập nhật 4 thẻ KPI
                const k = res.kpis;
                if (k) {
                    const elCust = document.getElementById('dashTotalCustomers');
                    if (elCust) elCust.innerText = (k.totalCustomers || 0).toLocaleString('vi-VN');

                    const elCustG = document.getElementById('dashCustomerGrowth');
                    if (elCustG) {
                        const arrow = k.customerGrowth >= 0 ? '↑' : '↓';
                        const colorClass = k.customerGrowth >= 0 ? 'text-emerald-400' : 'text-rose-400';
                        elCustG.className = `text-[11px] ${colorClass} flex items-center gap-1`;
                        elCustG.innerHTML = `<i class="fa-solid fa-arrow-trend-${k.customerGrowth >= 0 ? 'up' : 'down'}"></i> <span>${arrow} ${Math.abs(k.customerGrowth)}% tháng trước</span>`;
                    }

                    const elAppt = document.getElementById('dashTodayAppts');
                    if (elAppt) elAppt.innerText = k.todayAppointments || 0;

                    const elApptG = document.getElementById('dashApptGrowth');
                    if (elApptG) {
                        const arrow = k.appointmentGrowth >= 0 ? '↑' : '↓';
                        const colorClass = k.appointmentGrowth >= 0 ? 'text-emerald-400' : 'text-rose-400';
                        elApptG.className = `text-[11px] ${colorClass} flex items-center gap-1`;
                        elApptG.innerHTML = `<i class="fa-solid fa-arrow-trend-${k.appointmentGrowth >= 0 ? 'up' : 'down'}"></i> <span>${arrow} ${Math.abs(k.appointmentGrowth)}% hôm qua</span>`;
                    }

                    const elRev = document.getElementById('dashMonthRevenue');
                    if (elRev) elRev.innerText = k.monthRevenueFormatted || `${(k.monthRevenue || 0).toLocaleString('vi-VN')}đ`;

                    const elRevG = document.getElementById('dashRevenueGrowth');
                    if (elRevG) {
                        const arrow = k.revenueGrowth >= 0 ? '↑' : '↓';
                        const colorClass = k.revenueGrowth >= 0 ? 'text-emerald-400' : 'text-rose-400';
                        elRevG.className = `text-[11px] ${colorClass} flex items-center gap-1`;
                        elRevG.innerHTML = `<i class="fa-solid fa-arrow-trend-${k.revenueGrowth >= 0 ? 'up' : 'down'}"></i> <span>${arrow} ${Math.abs(k.revenueGrowth)}% tháng trước</span>`;
                    }

                    const elRet = document.getElementById('dashReturnRate');
                    if (elRet) elRet.innerText = `${k.returnRate || 0}%`;

                    const elRetG = document.getElementById('dashReturnRateGrowth');
                    if (elRetG) {
                        const arrow = k.returnRateGrowth >= 0 ? '↑' : '↓';
                        const colorClass = k.returnRateGrowth >= 0 ? 'text-emerald-400' : 'text-rose-400';
                        elRetG.className = `text-[11px] ${colorClass} flex items-center gap-1`;
                        elRetG.innerHTML = `<i class="fa-solid fa-arrow-trend-${k.returnRateGrowth >= 0 ? 'up' : 'down'}"></i> <span>${arrow} ${Math.abs(k.returnRateGrowth)}% tháng trước</span>`;
                    }
                }

                // 2. Lịch làm việc Calendar Widget
                calAppointmentsMap = {};
                (res.calendarAppointments || []).forEach(item => {
                    calAppointmentsMap[item.date] = item.count;
                });

                if (!calSelectedDate) {
                    calSelectedDate = res.targetDate || new Date().toISOString().split('T')[0];
                }
                renderDashboardCalendarGrid();

                // 3. Chi tiết lịch hẹn ngày chọn
                renderSelectedDayAppts(res.todayApptDetails || [], res.targetDateFormatted);

                // 4. Nhật ký hoạt động mới nhất (Audit Log)
                renderDashboardRecentActivities(res.recentActivities || []);

                // 5. Top Dịch vụ được yêu thích
                renderDashboardTopServices(res.charts?.topServices);

                // 6. Biểu đồ doanh thu 6 tháng
                renderDashboardRevenueChart(res.charts?.revenue6Months);

            } catch (err) {
                console.error("Lỗi khi load dữ liệu Tổng quan Dashboard:", err);
            }
        }

        // ==========================================
        // CALENDAR WIDGET LOGIC
        // ==========================================
        function renderDashboardCalendarGrid() {
            const gridEl = document.getElementById('dashCalDaysGrid');
            const titleEl = document.getElementById('dashCalMonthYear');
            if (!gridEl) return;

            if (titleEl) {
                titleEl.innerText = `Tháng ${calCurrentMonth}/${calCurrentYear}`;
            }

            const firstDateOfMonth = new Date(calCurrentYear, calCurrentMonth - 1, 1);
            let firstDayOfWeek = firstDateOfMonth.getDay(); // 0 is Sunday
            let startOffset = (firstDayOfWeek === 0) ? 6 : firstDayOfWeek - 1;

            const daysInMonth = new Date(calCurrentYear, calCurrentMonth, 0).getDate();
            const daysInPrevMonth = new Date(calCurrentYear, calCurrentMonth - 1, 0).getDate();

            const today = new Date();
            const todayStr = `${today.getFullYear()}-${String(today.getMonth() + 1).padStart(2, '0')}-${String(today.getDate()).padStart(2, '0')}`;

            let html = '';

            // 1. Các ngày của tháng trước (màu mờ)
            for (let i = startOffset - 1; i >= 0; i--) {
                const prevDay = daysInPrevMonth - i;
                html += `<span class="py-1.5 text-slate-600 cursor-not-allowed select-none">${prevDay}</span>`;
            }

            // 2. Các ngày trong tháng hiện tại
            for (let d = 1; d <= daysInMonth; d++) {
                const dateStr = `${calCurrentYear}-${String(calCurrentMonth).padStart(2, '0')}-${String(d).padStart(2, '0')}`;
                const apptCount = calAppointmentsMap[dateStr] || 0;
                const isToday = (dateStr === todayStr);
                const isSelected = (dateStr === calSelectedDate);

                let cellClass = "py-1.5 rounded-lg relative cursor-pointer transition-all flex flex-col items-center justify-center font-medium ";
                
                if (isSelected) {
                    cellClass += "bg-gradient-to-tr from-purple-600 to-indigo-600 text-white font-bold shadow-lg shadow-purple-600/40 ring-2 ring-purple-400 ";
                } else if (isToday) {
                    cellClass += "bg-white/10 text-purple-300 border border-purple-500/40 hover:bg-white/15 ";
                } else {
                    cellClass += "text-slate-300 hover:bg-white/10 ";
                }

                let dotHtml = '';
                if (apptCount > 0) {
                    if (isSelected) {
                        dotHtml = `<span class="w-1.5 h-1.5 rounded-full bg-amber-300 mt-0.5"></span>`;
                    } else {
                        dotHtml = `<span class="w-1.5 h-1.5 rounded-full bg-purple-400 mt-0.5 shadow-sm shadow-purple-400"></span>`;
                    }
                } else {
                    dotHtml = `<span class="w-1.5 h-1.5 mt-0.5 opacity-0"></span>`;
                }

                html += `
                    <div onclick="onSelectCalendarDate('${dateStr}')" class="${cellClass}" title="${d}/${calCurrentMonth}/${calCurrentYear}: ${apptCount} lịch hẹn">
                        <span class="text-xs leading-none">${d}</span>
                        ${dotHtml}
                    </div>
                `;
            }

            const totalCells = startOffset + daysInMonth;
            const remainingCells = (totalCells % 7 === 0) ? 0 : 7 - (totalCells % 7);
            for (let nextDay = 1; nextDay <= remainingCells; nextDay++) {
                html += `<span class="py-1.5 text-slate-600 cursor-not-allowed select-none">${nextDay}</span>`;
            }

            gridEl.innerHTML = html;
        }

        async function onSelectCalendarDate(dateStr) {
            calSelectedDate = dateStr;
            renderDashboardCalendarGrid();

            const titleEl = document.getElementById('dashSelectedDayTitle');
            const listEl = document.getElementById('dashSelectedDayAppts');

            const parts = dateStr.split('-');
            const formatted = `${parts[2]}/${parts[1]}/${parts[0]}`;
            if (titleEl) titleEl.innerText = `Lịch hẹn ${formatted}`;

            if (listEl) {
                listEl.innerHTML = `
                    <div class="text-center py-4 text-slate-400 text-xs">
                        <i class="fa-solid fa-circle-notch fa-spin text-purple-400 text-sm mb-1 block"></i>
                        <span>Đang tải lịch hẹn...</span>
                    </div>
                `;
            }

            try {
                const response = await fetch(`/Dashboard/GetDayAppointments?date=${encodeURIComponent(dateStr)}`);
                const res = await response.json();
                if (res.success) {
                    renderSelectedDayAppts(res.data || [], formatted);
                }
            } catch (err) {
                console.error("Lỗi khi tải lịch hẹn ngày:", err);
            }
        }

        function renderSelectedDayAppts(items, formattedDate) {
            const listEl = document.getElementById('dashSelectedDayAppts');
            const titleEl = document.getElementById('dashSelectedDayTitle');
            if (titleEl && formattedDate) {
                titleEl.innerText = `Lịch hẹn ${formattedDate} (${items.length})`;
            }

            if (!listEl) return;

            if (!items || items.length === 0) {
                listEl.innerHTML = `
                    <div class="py-4 text-center text-slate-400 text-xs bg-white/[0.02] rounded-xl border border-white/5">
                        <i class="fa-regular fa-calendar-xmark text-slate-500 text-base mb-1 block"></i>
                        <span>Không có lịch hẹn nào.</span>
                    </div>
                `;
                return;
            }

            listEl.innerHTML = items.map(a => {
                let badgeClass = "bg-amber-500/20 text-amber-400 border-amber-500/30";
                let statusText = a.status;
                if (a.status === 'Completed') {
                    badgeClass = "bg-emerald-500/20 text-emerald-400 border-emerald-500/30";
                    statusText = "Đã xong";
                } else if (a.status === 'Cancelled') {
                    badgeClass = "bg-rose-500/20 text-rose-400 border-rose-500/30";
                    statusText = "Đã hủy";
                } else if (a.status === 'InService') {
                    badgeClass = "bg-cyan-500/20 text-cyan-400 border-cyan-500/30";
                    statusText = "Đang làm";
                } else if (a.status === 'Confirmed') {
                    badgeClass = "bg-purple-500/20 text-purple-400 border-purple-500/30";
                    statusText = "Đã xác nhận";
                } else if (a.status === 'NoShow') {
                    badgeClass = "bg-slate-500/20 text-slate-400 border-slate-500/30";
                    statusText = "Vắng mặt";
                }

                return `
                    <div onclick="if(typeof viewAppointmentDetail==='function') viewAppointmentDetail(${a.appointmentId})" 
                        class="p-2 rounded-xl bg-white/5 hover:bg-white/10 border border-white/5 transition flex items-center justify-between cursor-pointer group">
                        <div class="flex items-center space-x-2 truncate">
                            <span class="text-[11px] font-mono font-bold text-purple-300 bg-purple-500/20 px-1.5 py-0.5 rounded border border-purple-500/30 shrink-0">
                                ${a.time || '--:--'}
                            </span>
                            <div class="truncate">
                                <p class="text-xs font-semibold text-white group-hover:text-purple-300 transition truncate">${escapeHtml(a.customerName)}</p>
                                <p class="text-[10px] text-slate-400 truncate">${escapeHtml(a.serviceName)}</p>
                            </div>
                        </div>
                        <span class="text-[9px] px-1.5 py-0.5 rounded-full border ${badgeClass} shrink-0 ml-1">
                            ${statusText}
                        </span>
                    </div>
                `;
            }).join('');
        }

        function prevCalMonth() {
            calCurrentMonth--;
            if (calCurrentMonth < 1) {
                calCurrentMonth = 12;
                calCurrentYear--;
            }
            const dateStr = `${calCurrentYear}-${String(calCurrentMonth).padStart(2, '0')}-01`;
            loadDashboardOverview(dateStr);
        }

        function nextCalMonth() {
            calCurrentMonth++;
            if (calCurrentMonth > 12) {
                calCurrentMonth = 1;
                calCurrentYear++;
            }
            const dateStr = `${calCurrentYear}-${String(calCurrentMonth).padStart(2, '0')}-01`;
            loadDashboardOverview(dateStr);
        }

        function resetCalToday() {
            const today = new Date();
            calCurrentYear = today.getFullYear();
            calCurrentMonth = today.getMonth() + 1;
            calSelectedDate = `${today.getFullYear()}-${String(today.getMonth() + 1).padStart(2, '0')}-${String(today.getDate()).padStart(2, '0')}`;
            loadDashboardOverview(calSelectedDate);
        }

        // ==========================================
        // RECENT ACTIVITIES (AUDIT LOG)
        // ==========================================
        function renderDashboardRecentActivities(activities) {
            const container = document.getElementById('dashboardRecentActivities');
            if (!container) return;

            if (!activities || activities.length === 0) {
                container.innerHTML = `
                    <div class="text-center py-8 text-slate-400">
                        <i class="fa-regular fa-clock text-slate-500 text-lg mb-1 block"></i>
                        <span>Chưa có hoạt động mới nào.</span>
                    </div>
                `;
                return;
            }

            container.innerHTML = activities.map(act => `
                <div class="flex items-start space-x-2.5 p-2 rounded-xl hover:bg-white/5 transition">
                    <div class="w-7 h-7 rounded-full ${act.colorClass || 'bg-purple-500/20 text-purple-400 border-purple-500/30'} border flex items-center justify-center text-[11px] shrink-0 mt-0.5 shadow-sm">
                        <i class="fa-solid ${act.iconClass || 'fa-bell'}"></i>
                    </div>
                    <div class="min-w-0 flex-1">
                        <p class="font-semibold text-white leading-tight truncate">${escapeHtml(act.title)}</p>
                        <p class="text-[11px] text-slate-400 line-clamp-1 mt-0.5">${escapeHtml(act.detail)}</p>
                        <span class="text-[10px] text-slate-500 font-mono mt-0.5 block">${escapeHtml(act.timeAgo)}</span>
                    </div>
                </div>
            `).join('');
        }

        // ==========================================
        // TOP POPULAR SERVICES
        // ==========================================
        function renderDashboardTopServices(topServices) {
            const container = document.getElementById('dashboardTopServices');
            if (!container) return;

            const items = topServices?.items || [];
            if (items.length === 0) {
                container.innerHTML = `
                    <div class="text-center py-8 text-slate-400 text-xs">
                        <span>Chưa có dữ liệu dịch vụ tháng này.</span>
                    </div>
                `;
                return;
            }

            container.innerHTML = items.map(s => `
                <div>
                    <div class="flex justify-between items-center text-xs mb-1.5">
