        <!-- Quick period pills -->
        <div class="flex items-center flex-wrap gap-1.5" id="reportPeriodPills">
            <button type="button" onclick="changeReportPeriod('today', this)" class="report-period-btn px-3 py-1.5 rounded-xl text-xs font-semibold text-slate-300 hover:text-white hover:bg-white/10 transition-all">Hôm nay</button>
            <button type="button" onclick="changeReportPeriod('this_week', this)" class="report-period-btn px-3 py-1.5 rounded-xl text-xs font-semibold text-slate-300 hover:text-white hover:bg-white/10 transition-all">Tuần này</button>
            <button type="button" onclick="changeReportPeriod('this_month', this)" class="report-period-btn active px-3 py-1.5 rounded-xl text-xs font-semibold bg-gradient-to-r from-purple-600 to-indigo-600 text-white shadow-lg shadow-purple-600/30 transition-all">Tháng này</button>
            <button type="button" onclick="changeReportPeriod('this_quarter', this)" class="report-period-btn px-3 py-1.5 rounded-xl text-xs font-semibold text-slate-300 hover:text-white hover:bg-white/10 transition-all">Quý này</button>
            <button type="button" onclick="changeReportPeriod('this_year', this)" class="report-period-btn px-3 py-1.5 rounded-xl text-xs font-semibold text-slate-300 hover:text-white hover:bg-white/10 transition-all">Năm nay</button>
