                </div>
                <div class="w-11 h-11 rounded-xl bg-gradient-to-br from-amber-500/20 to-orange-500/20 border border-amber-500/30 flex items-center justify-center text-amber-400 group-hover:scale-110 transition-all">
                    <i class="fa-solid fa-coins text-lg"></i>
                </div>
            </div>
            <div class="mt-3 flex items-center justify-between text-xs">
                <span id="kpiGrowthBadge" class="inline-flex items-center px-2 py-0.5 rounded-full bg-emerald-500/20 text-emerald-400 font-medium">
                    <i class="fa-solid fa-arrow-trend-up mr-1 text-[10px]"></i>+0%
