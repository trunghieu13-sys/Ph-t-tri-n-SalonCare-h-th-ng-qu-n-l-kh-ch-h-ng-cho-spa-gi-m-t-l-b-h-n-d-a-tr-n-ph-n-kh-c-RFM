@{
    ViewData["Title"] = "Báo cáo Tỉ lệ Bỏ hẹn & Khách quay lại theo Phân khúc";
    var today = DateTime.Today;
    var firstDayOfMonth = new DateTime(today.Year, today.Month, 1);
}

<div class="space-y-6">
    <!-- Top Header & Navigation -->
    <div class="glass-card rounded-2xl p-5 border border-purple-500/25 bg-gradient-to-r from-slate-900/90 via-purple-950/30 to-slate-900/90 flex flex-col lg:flex-row lg:items-center justify-between gap-4">
        <div class="flex items-start sm:items-center space-x-4">
            <div class="w-12 h-12 rounded-2xl bg-gradient-to-br from-rose-500/20 to-purple-600/30 border border-rose-500/40 flex items-center justify-center text-rose-400 text-xl shrink-0 shadow-lg shadow-rose-500/10">
                <i class="fa-solid fa-chart-column"></i>
            </div>
            <div>
                <h2 class="text-lg font-bold text-white tracking-wide">Báo Cáo Tỉ Lệ Bỏ Hẹn & Khách Quay Lại Theo Nhóm Khách Hàng</h2>
            </div>
        </div>
        <div class="flex items-center gap-2.5 shrink-0">
            <a href="/?view=reportsView" class="px-3.5 py-2 rounded-xl bg-white/5 hover:bg-white/10 border border-white/10 text-slate-300 hover:text-white text-xs font-semibold transition flex items-center gap-1.5">
                <i class="fa-solid fa-arrow-left"></i>
                <span>Quay lại Tổng quan Báo cáo</span>
            </a>
        </div>
    </div>

    <!-- Thanh bộ lọc & Hành động -->
    <div class="glass-card p-4 rounded-2xl border border-white/10 flex flex-col md:flex-row items-stretch md:items-center justify-between gap-4">
        <div class="flex items-center flex-wrap gap-3">
            <div class="flex items-center gap-2 bg-white/5 border border-white/10 rounded-xl px-3 py-2 text-xs">
                <i class="fa-regular fa-calendar text-purple-400"></i>
                <span class="text-slate-400 font-medium">Từ ngày:</span>
                <input type="date" id="nsrFromDate" value="@firstDayOfMonth.ToString("yyyy-MM-dd")" class="bg-transparent text-white font-semibold focus:outline-none [color-scheme:dark]" />
            </div>
            <div class="flex items-center gap-2 bg-white/5 border border-white/10 rounded-xl px-3 py-2 text-xs">
                <i class="fa-regular fa-calendar-check text-cyan-400"></i>
                <span class="text-slate-400 font-medium">Đến ngày:</span>
                <input type="date" id="nsrToDate" value="@today.ToString("yyyy-MM-dd")" class="bg-transparent text-white font-semibold focus:outline-none [color-scheme:dark]" />
            </div>
            <button type="button" id="btnFilterNsr" onclick="loadNoShowRetentionReport()" class="px-4 py-2 rounded-xl bg-gradient-to-r from-purple-600 to-indigo-600 hover:from-purple-500 hover:to-indigo-500 text-white text-xs font-bold shadow-lg shadow-purple-600/30 transition flex items-center gap-2">
                <i class="fa-solid fa-filter"></i>
                <span>Lọc dữ liệu</span>
            </button>
        </div>

        <div class="flex items-center justify-between md:justify-end gap-3">
            <span id="nsrActiveRangeBadge" class="text-xs text-purple-300 bg-purple-500/10 border border-purple-500/20 px-3 py-1.5 rounded-xl font-medium">
                Kỳ: @firstDayOfMonth.ToString("dd/MM/yyyy") - @today.ToString("dd/MM/yyyy")
            </span>
            <button type="button" onclick="exportNoShowRetentionExcel()" class="px-4 py-2 rounded-xl bg-gradient-to-r from-emerald-600 to-teal-600 hover:from-emerald-500 hover:to-teal-500 text-white text-xs font-bold shadow-lg shadow-emerald-600/25 transition flex items-center gap-2">
                <i class="fa-solid fa-file-excel"></i>
                <span>Xuất Excel (.xlsx)</span>
            </button>
        </div>
    </div>

    <!-- 4 Thẻ KPI nhanh -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <!-- KPI 1: Tổng lịch hẹn trong kỳ -->
        <div class="glass-card p-5 rounded-2xl border border-white/10 relative overflow-hidden group hover:border-purple-500/40 transition-all">
            <div class="flex items-start justify-between">
                <div>
                    <span class="text-xs font-medium text-slate-400">Tổng lịch hẹn trong kỳ</span>
                    <h3 id="nsrKpiTotalAppointments" class="text-2xl font-bold text-white mt-1">0 <span class="text-xs font-normal text-slate-400">lịch</span></h3>
                </div>
                <div class="w-11 h-11 rounded-xl bg-purple-500/15 border border-purple-500/30 flex items-center justify-center text-purple-400">
                    <i class="fa-solid fa-calendar-days text-lg"></i>
                </div>
            </div>
            <div class="mt-3 pt-2.5 border-t border-white/5 flex items-center justify-between text-[11px] text-slate-400">
                <span>Hoàn thành: <strong id="nsrKpiCompletedCount" class="text-emerald-400">0</strong></span>
                <span>Đã hủy: <strong id="nsrKpiCancelledCount" class="text-slate-300">0</strong></span>
            </div>
        </div>

        <!-- KPI 2: Tỉ lệ bỏ hẹn trung bình -->
        <div class="glass-card p-5 rounded-2xl border border-rose-500/25 relative overflow-hidden group hover:border-rose-500/50 transition-all">
            <div class="flex items-start justify-between">
                <div>
                    <span class="text-xs font-medium text-slate-400">Tỉ lệ bỏ hẹn trung bình</span>
                    <h3 id="nsrKpiAvgNoShowRate" class="text-2xl font-bold text-rose-400 mt-1">0.00%</h3>
                </div>
                <div class="w-11 h-11 rounded-xl bg-rose-500/15 border border-rose-500/30 flex items-center justify-center text-rose-400">
                    <i class="fa-solid fa-user-xmark text-lg"></i>
                </div>
            </div>
            <div class="mt-3 pt-2.5 border-t border-white/5 flex items-center justify-between text-[11px] text-slate-400">
                <span>Số lượt khách bỏ hẹn:</span>
                <strong id="nsrKpiNoShowCount" class="text-rose-300 font-bold">0 lượt</strong>
            </div>
        </div>

        <!-- KPI 3: Tỉ lệ khách quay lại -->
        <div class="glass-card p-5 rounded-2xl border border-emerald-500/25 relative overflow-hidden group hover:border-emerald-500/50 transition-all">
            <div class="flex items-start justify-between">
                <div>
                    <span class="text-xs font-medium text-slate-400">Tỉ lệ khách quay lại (Retention)</span>
                    <h3 id="nsrKpiAvgRetentionRate" class="text-2xl font-bold text-emerald-400 mt-1">0.00%</h3>
                </div>
                <div class="w-11 h-11 rounded-xl bg-emerald-500/15 border border-emerald-500/30 flex items-center justify-center text-emerald-400">
                    <i class="fa-solid fa-rotate text-lg"></i>
                </div>
            </div>
            <div class="mt-3 pt-2.5 border-t border-white/5 flex items-center justify-between text-[11px] text-slate-400">
                <span>Khách quay lại / Tổng khách:</span>
                <strong id="nsrKpiReturningRatio" class="text-emerald-300 font-bold">0 / 0 khách</strong>
            </div>
        </div>

        <!-- KPI 4: Nhóm có tỉ lệ bỏ hẹn cao nhất -->
        <div class="glass-card p-5 rounded-2xl border border-amber-500/25 relative overflow-hidden group hover:border-amber-500/50 transition-all">
            <div class="flex items-start justify-between">
                <div>
                    <span class="text-xs font-medium text-slate-400">Nhóm có tỉ lệ bỏ hẹn cao nhất</span>
                    <h3 id="nsrKpiHighestSegmentName" class="text-lg font-bold text-amber-300 mt-1.5 truncate">---</h3>
                </div>
                <div class="w-11 h-11 rounded-xl bg-amber-500/15 border border-amber-500/30 flex items-center justify-center text-amber-400">
                    <i class="fa-solid fa-triangle-exclamation text-lg"></i>
                </div>
            </div>
            <div class="mt-3 pt-2.5 border-t border-white/5 flex items-center justify-between text-[11px] text-slate-400">
                <span>Mức độ rủi ro bỏ hẹn:</span>
                <strong id="nsrKpiHighestSegmentRate" class="text-rose-400 font-bold">0.00% (0 ca)</strong>
            </div>
        </div>
    </div>

    <!-- Biểu đồ & Bảng chi tiết (Layout 2 cột) -->
    <div class="grid grid-cols-1 xl:grid-cols-12 gap-6 items-stretch">
        <!-- Cột trái (5/12): Biểu đồ cột đôi (Chart.js) -->
        <div class="xl:col-span-5 glass-card p-5 rounded-2xl border border-white/10 flex flex-col justify-between">
            <div>
                <div class="flex items-center justify-between mb-2">
                    <h3 class="text-sm font-bold text-white flex items-center gap-2">
                        <i class="fa-solid fa-chart-bar text-cyan-400"></i>
                        <span>Biểu Đồ So Sánh Tỉ Lệ Quay Lại & Bỏ Hẹn (%)</span>
                    </h3>
                </div>
                <p class="text-xs text-slate-400 mb-4">Đối chiếu trực quan giữa Tỉ lệ khách quay lại (%) và Tỉ lệ bỏ hẹn (%) của 4 phân khúc khách hàng</p>
            </div>

            <div class="relative h-80 w-full">
                <canvas id="noShowRetentionBarChart"></canvas>
            </div>

            <div class="mt-4 pt-3 border-t border-white/10 flex items-center justify-between text-[11px] text-slate-400">
                <span class="flex items-center gap-1.5">
                    <span class="w-2.5 h-2.5 rounded-sm bg-emerald-500 inline-block"></span> Tỉ lệ khách quay lại (%)
                </span>
                <span class="flex items-center gap-1.5">
                    <span class="w-2.5 h-2.5 rounded-sm bg-rose-500 inline-block"></span> Tỉ lệ bỏ hẹn (%) — Cảnh báo đỏ khi &ge; 15%
                </span>
            </div>
        </div>

        <!-- Cột phải (7/12): Bảng chi tiết đầy đủ các cột chỉ số của từng nhóm -->
        <div class="xl:col-span-7 glass-card p-5 rounded-2xl border border-white/10 flex flex-col justify-between">
            <div>
                <div class="flex items-center justify-between mb-4 flex-wrap gap-2">
                    <div>
                        <h3 class="text-sm font-bold text-white flex items-center gap-2">
                            <i class="fa-solid fa-table-list text-purple-400"></i>
                            <span>Bảng Chi Tiết Chỉ Số Bỏ Hẹn & Giữ Chân Theo Phân Khúc</span>
                        </h3>
                        <p class="text-xs text-slate-400 mt-0.5">Các nhóm có Tỉ lệ bỏ hẹn &ge; 15% được tô đỏ tự động để ưu tiên nhắc lịch 2 mốc (24h & 2h)</p>
                    </div>
                    <span class="px-2.5 py-1 rounded-lg text-[11px] bg-rose-500/15 border border-rose-500/30 text-rose-300 font-semibold">
                        <i class="fa-solid fa-bell mr-1"></i> Ngưỡng cảnh báo bỏ hẹn: &ge; 15%
                    </span>
                </div>

                <div class="overflow-x-auto rounded-xl border border-white/10">
                    <table class="w-full text-left border-collapse text-xs">
                        <thead>
                            <tr class="border-b border-white/10 bg-white/[0.04] text-slate-300 text-[11px] uppercase">
                                <th class="py-3 px-3 font-semibold">Nhóm khách hàng</th>
                                <th class="py-3 px-2.5 font-semibold text-center">Tổng khách</th>
                                <th class="py-3 px-2.5 font-semibold text-center">Quay lại</th>
                                <th class="py-3 px-2.5 font-semibold text-right">% Quay lại</th>
                                <th class="py-3 px-2.5 font-semibold text-center">Lịch hẹn</th>
                                <th class="py-3 px-2.5 font-semibold text-center">Hoàn thành</th>
                                <th class="py-3 px-2.5 font-semibold text-center">Bỏ hẹn</th>
                                <th class="py-3 px-2.5 font-semibold text-center">Đã hủy</th>
                                <th class="py-3 px-2.5 font-semibold text-right">% Bỏ hẹn</th>
                                <th class="py-3 px-3 font-semibold text-right">Doanh thu thực</th>
                            </tr>
                        </thead>
                        <tbody id="nsrDetailTableBody" class="divide-y divide-white/5 text-slate-200">
                            <tr>
                                <td colspan="10" class="py-8 text-center text-slate-400">
                                    <i class="fa-solid fa-circle-notch fa-spin text-purple-400 mr-2"></i> Đang tải dữ liệu từ Stored Procedure...
                                </td>
                            </tr>
                        </tbody>
                        <tfoot id="nsrDetailTableFoot" class="border-t-2 border-white/15 bg-white/[0.06] font-bold text-white">
                        </tfoot>
                    </table>
                </div>
            </div>

            <div class="mt-4 pt-3 border-t border-white/10 flex flex-col sm:flex-row sm:items-center justify-between gap-2 text-[11px] text-slate-400">
                <span><i class="fa-solid fa-circle-info text-cyan-400 mr-1"></i> Công thức: Tỉ lệ bỏ hẹn (%) = (Số lịch bỏ hẹn / Tổng số lịch hẹn) &times; 100%</span>
                <span>Tổng doanh thu thực tế kỳ này: <strong id="nsrFooterTotalRevenue" class="text-amber-300 text-xs">0đ</strong></span>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let nsrChartInstance = null;

        document.addEventListener('DOMContentLoaded', () => {
            loadNoShowRetentionReport();
        });

        async function loadNoShowRetentionReport() {
            const fromDate = document.getElementById('nsrFromDate')?.value || '';
            const toDate = document.getElementById('nsrToDate')?.value || '';
            const btn = document.getElementById('btnFilterNsr');
            const origHtml = btn ? btn.innerHTML : '';

            if (btn) {
                btn.disabled = true;
                btn.innerHTML = '<i class="fa-solid fa-circle-notch fa-spin"></i><span>Đang tải...</span>';
            }

            try {
                const url = `/Reports/GetNoShowAndRetentionReport?fromDate=${encodeURIComponent(fromDate)}&toDate=${encodeURIComponent(toDate)}`;
                const res = await fetch(url);
                const data = await res.json();

                if (!data.success) {
                    if (typeof showToast === 'function') {
                        showToast(data.message || 'Không thể tải báo cáo.', 'Lỗi');
                    }
                    return;
                }

                // Cập nhật badge kỳ báo cáo
                const rangeBadge = document.getElementById('nsrActiveRangeBadge');
                if (rangeBadge && data.formattedDateRange) {
                    rangeBadge.textContent = `Kỳ: ${data.formattedDateRange}`;
                }

                // Cập nhật 4 thẻ KPI
                document.getElementById('nsrKpiTotalAppointments').innerHTML = `${Number(data.totalAppointments || 0).toLocaleString('vi-VN')} <span class="text-xs font-normal text-slate-400">lịch</span>`;
                document.getElementById('nsrKpiCompletedCount').textContent = Number(data.totalCompletedCount || 0).toLocaleString('vi-VN');
                document.getElementById('nsrKpiCancelledCount').textContent = Number(data.totalCancelledCount || 0).toLocaleString('vi-VN');

                const avgNoShowRate = Number(data.averageNoShowRate || 0);
                const avgNoShowEl = document.getElementById('nsrKpiAvgNoShowRate');
                avgNoShowEl.textContent = `${avgNoShowRate.toFixed(2)}%`;
                avgNoShowEl.className = avgNoShowRate >= 15
                    ? 'text-2xl font-bold text-rose-400 mt-1'
                    : 'text-2xl font-bold text-emerald-400 mt-1';

                document.getElementById('nsrKpiNoShowCount').textContent = `${Number(data.totalNoShowCount || 0).toLocaleString('vi-VN')} lượt`;

                const avgRetRate = Number(data.averageRetentionRate || 0);
                document.getElementById('nsrKpiAvgRetentionRate').textContent = `${avgRetRate.toFixed(2)}%`;
                document.getElementById('nsrKpiReturningRatio').textContent = `${Number(data.totalReturningCustomers || 0).toLocaleString('vi-VN')} / ${Number(data.totalCustomers || 0).toLocaleString('vi-VN')} khách`;

                document.getElementById('nsrKpiHighestSegmentName').textContent = data.highestNoShowSegmentName || 'Chưa có';
                document.getElementById('nsrKpiHighestSegmentRate').textContent = `${Number(data.highestNoShowSegmentRate || 0).toFixed(2)}% (${Number(data.highestNoShowSegmentCount || 0)} ca)`;
                document.getElementById('nsrFooterTotalRevenue').textContent = data.formattedTotalRevenue || '0đ';

                renderNoShowRetentionTable(data);
                renderNoShowRetentionChart(data.segments || []);
            } catch (err) {
                console.error('Lỗi khi tải báo cáo NoShow & Retention:', err);
            } finally {
                if (btn) {
                    btn.disabled = false;
                    btn.innerHTML = origHtml;
                }
            }
        }

        function renderNoShowRetentionTable(data) {
            const tbody = document.getElementById('nsrDetailTableBody');
            const tfoot = document.getElementById('nsrDetailTableFoot');
            const segments = data.segments || [];

            if (!segments.length) {
                tbody.innerHTML = `<tr><td colspan="10" class="py-8 text-center text-slate-400">Không có dữ liệu phân khúc trong khoảng thời gian đã chọn.</td></tr>`;
                tfoot.innerHTML = '';
                return;
            }

            const badgeMap = {
                'VIP': 'bg-amber-500/20 text-amber-300 border-amber-500/40',
                'Than_thiet': 'bg-emerald-500/20 text-emerald-300 border-emerald-500/40',
                'Moi': 'bg-cyan-500/20 text-cyan-300 border-cyan-500/40',
                'Nguy_co': 'bg-orange-500/20 text-orange-300 border-orange-500/40'
            };

            tbody.innerHTML = segments.map(seg => {
                const isHighNoShow = Number(seg.noShowRate || 0) >= 15.0;
                const rowClass = isHighNoShow
                    ? 'bg-rose-500/10 hover:bg-rose-500/15 transition-colors'
                    : 'hover:bg-white/5 transition-colors';

                const noShowRateBadge = isHighNoShow
                    ? `<span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-lg bg-rose-500/25 border border-rose-500/50 text-rose-300 font-bold">
                           <i class="fa-solid fa-triangle-exclamation text-[10px]"></i>${Number(seg.noShowRate).toFixed(2)}%
                       </span>`
                    : `<span class="text-emerald-400 font-semibold">${Number(seg.noShowRate).toFixed(2)}%</span>`;

                const pillStyle = badgeMap[seg.segmentCode] || 'bg-purple-500/20 text-purple-300 border-purple-500/40';

                return `
                    <tr class="${rowClass}">
                        <td class="py-3 px-3">
                            <div class="flex items-center gap-2">
                                <span class="px-2 py-0.5 rounded-md text-[10px] font-bold border ${pillStyle}">${seg.segmentCode}</span>
                                <span class="font-semibold text-white">${seg.segmentName}</span>
                            </div>
                        </td>
                        <td class="py-3 px-2.5 text-center font-medium">${Number(seg.totalCustomers).toLocaleString('vi-VN')}</td>
                        <td class="py-3 px-2.5 text-center text-emerald-300 font-medium">${Number(seg.returningCustomers).toLocaleString('vi-VN')}</td>
                        <td class="py-3 px-2.5 text-right font-semibold text-emerald-400">${Number(seg.retentionRate).toFixed(2)}%</td>
                        <td class="py-3 px-2.5 text-center font-semibold text-white">${Number(seg.totalAppointments).toLocaleString('vi-VN')}</td>
                        <td class="py-3 px-2.5 text-center text-emerald-400">${Number(seg.completedCount).toLocaleString('vi-VN')}</td>
                        <td class="py-3 px-2.5 text-center ${isHighNoShow ? 'text-rose-400 font-bold' : 'text-slate-300'}">${Number(seg.noShowCount).toLocaleString('vi-VN')}</td>
                        <td class="py-3 px-2.5 text-center text-slate-400">${Number(seg.cancelledCount).toLocaleString('vi-VN')}</td>
                        <td class="py-3 px-2.5 text-right">${noShowRateBadge}</td>
                        <td class="py-3 px-3 text-right font-semibold text-amber-300">${seg.formattedRevenue}</td>
                    </tr>
                `;
            }).join('');

            const avgNoShow = Number(data.averageNoShowRate || 0);
            tfoot.innerHTML = `
                <tr>
                    <td class="py-3 px-3 text-purple-300 uppercase text-[11px]">Tổng cộng / Trung bình</td>
                    <td class="py-3 px-2.5 text-center">${Number(data.totalCustomers || 0).toLocaleString('vi-VN')}</td>
                    <td class="py-3 px-2.5 text-center text-emerald-300">${Number(data.totalReturningCustomers || 0).toLocaleString('vi-VN')}</td>
                    <td class="py-3 px-2.5 text-right text-emerald-400">${Number(data.averageRetentionRate || 0).toFixed(2)}%</td>
                    <td class="py-3 px-2.5 text-center">${Number(data.totalAppointments || 0).toLocaleString('vi-VN')}</td>
                    <td class="py-3 px-2.5 text-center text-emerald-400">${Number(data.totalCompletedCount || 0).toLocaleString('vi-VN')}</td>
                    <td class="py-3 px-2.5 text-center text-rose-400">${Number(data.totalNoShowCount || 0).toLocaleString('vi-VN')}</td>
                    <td class="py-3 px-2.5 text-center text-slate-300">${Number(data.totalCancelledCount || 0).toLocaleString('vi-VN')}</td>
                    <td class="py-3 px-2.5 text-right ${avgNoShow >= 15 ? 'text-rose-400' : 'text-emerald-400'}">${avgNoShow.toFixed(2)}%</td>
                    <td class="py-3 px-3 text-right text-amber-300">${data.formattedTotalRevenue || '0đ'}</td>
                </tr>
            `;
        }

        function renderNoShowRetentionChart(segments) {
            const canvas = document.getElementById('noShowRetentionBarChart');
            if (!canvas) return;

            const labels = segments.map(s => s.segmentName);
            const retentionData = segments.map(s => Number(s.retentionRate || 0));
            const noShowData = segments.map(s => Number(s.noShowRate || 0));

            if (nsrChartInstance) {
                nsrChartInstance.destroy();
            }

            const ctx = canvas.getContext('2d');
            nsrChartInstance = new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: labels,
                    datasets: [
                        {
                            label: 'Tỉ lệ khách quay lại (%)',
                            data: retentionData,
                            backgroundColor: 'rgba(16, 185, 129, 0.75)',
                            borderColor: '#10B981',
                            borderWidth: 1.5,
                            borderRadius: 6
                        },
                        {
                            label: 'Tỉ lệ bỏ hẹn (%)',
                            data: noShowData,
                            backgroundColor: noShowData.map(v => v >= 15 ? 'rgba(244, 63, 94, 0.85)' : 'rgba(251, 146, 60, 0.75)'),
                            borderColor: noShowData.map(v => v >= 15 ? '#F43F5E' : '#FB923C'),
                            borderWidth: 1.5,
                            borderRadius: 6
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            position: 'top',
                            labels: {
                                color: '#CBD5E1',
                                font: { size: 11, family: 'Plus Jakarta Sans' }
                            }
                        },
                        tooltip: {
                            callbacks: {
                                label: function (context) {
                                    return `${context.dataset.label}: ${Number(context.raw).toFixed(2)}%`;
                                }
                            }
                        }
                    },
                    scales: {
                        x: {
                            ticks: { color: '#94A3B8', font: { size: 11 } },
                            grid: { color: 'rgba(255, 255, 255, 0.04)' }
                        },
                        y: {
                            beginAtZero: true,
                            max: 100,
                            ticks: {
                                color: '#94A3B8',
                                font: { size: 11 },
                                callback: function (val) { return val + '%'; }
                            },
                            grid: { color: 'rgba(255, 255, 255, 0.06)' }
                        }
                    }
                }
            });
        }

        function exportNoShowRetentionExcel() {
            const fromDate = document.getElementById('nsrFromDate')?.value || '';
            const toDate = document.getElementById('nsrToDate')?.value || '';
            window.location.href = `/Reports/ExportNoShowRetentionExcel?fromDate=${encodeURIComponent(fromDate)}&toDate=${encodeURIComponent(toDate)}`;
        }
    </script>
}
